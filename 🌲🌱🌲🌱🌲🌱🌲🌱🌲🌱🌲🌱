-- البحث عن أقرب Mailbox
local function findMailbox()
	local ch=LP.Character
	if not ch or not ch:FindFirstChild("HumanoidRootPart") then return nil,nil,nil end
	local hrp=ch.HumanoidRootPart
	local best,bd,bObj=nil,math.huge,nil
	for _,obj in workspace:GetDescendants() do
		pcall(function()
			local nl=obj.Name:lower()
			if nl:find("mail") or nl:find("postbox") or nl:find("letter") then
				local pos
				if obj:IsA("Model") then
					local pp=obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
					if pp then pos=pp.Position end
				elseif obj:IsA("BasePart") then
					pos=obj.Position
				end
				if pos then
					local dist=(pos-hrp.Position).Magnitude
					if dist<bd then best=pos;bd=dist;bObj=obj end
				end
			end
		end)
	end
	return best,bd,bObj
end

-- تفعيل Mailbox
local function interact(mailObj)
	if not mailObj then return false end
	local ok=false

	-- ProximityPrompt
	local function tryPrompts(parent)
		for _,d in parent:GetDescendants() do
			if d:IsA("ProximityPrompt") then
				pcall(function() fireproximityprompt(d) end)
				ok=true
				return true
			end
		end
		return false
	end

	tryPrompts(mailObj)
	if ok then return true end
	if mailObj.Parent then tryPrompts(mailObj.Parent) end
	if ok then return true end

	-- ClickDetector
	local function tryClicks(parent)
		for _,d in parent:GetDescendants() do
			if d:IsA("ClickDetector") then
				pcall(function() fireclickdetector(d) end)
				ok=true
				return true
			end
		end
		return false
	end

	tryClicks(mailObj)
	if ok then return true end
	if mailObj.Parent then tryClicks(mailObj.Parent) end
	if ok then return true end

	-- أقرب ProximityPrompt بالمنطقة
	local ch=LP.Character
	if ch and ch:FindFirstChild("HumanoidRootPart") then
		local hrp=ch.HumanoidRootPart
		for _,obj in workspace:GetDescendants() do
			pcall(function()
				if obj:IsA("ProximityPrompt") and obj.Parent and obj.Parent:IsA("BasePart") then
					if (obj.Parent.Position-hrp.Position).Magnitude<20 then
						fireproximityprompt(obj)
						ok=true
					end
				end
			end)
			if ok then break end
		end
	end

	return ok
end

-- كتابة الاسم بالـ TextBox
local function autoType(name)
	local pg=LP:FindFirstChild("PlayerGui")
	if not pg then return false end

	for attempt=1,20 do
		task.wait(0.3)
		for _,gui in pg:GetChildren() do
			if gui:IsA("ScreenGui") and gui.Name~="GS" then
				for _,desc in gui:GetDescendants() do
					pcall(function()
						if desc:IsA("TextBox") and desc.Visible then
							desc.Text=name
							desc:CaptureFocus()
							task.wait(0.1)
							desc:ReleaseFocus(true)

							-- ضغط زر البحث
							task.wait(0.2)
							for _,btn in gui:GetDescendants() do
								pcall(function()
									if btn:IsA("TextButton") or btn:IsA("ImageButton") then
										local nl=btn.Name:lower()
										local tl=""
										if btn:IsA("TextButton") then tl=btn.Text:lower() end
										if nl:find("search") or nl:find("submit") or nl:find("send")
											or nl:find("confirm") or nl:find("enter") or nl:find("go")
											or nl:find("look") or nl:find("find") or nl:find("view")
											or tl:find("search") or tl:find("submit") or tl:find("send")
											or tl:find("confirm") or tl:find("go") or tl:find("view")
											or tl:find("look") or tl:find("find") then
											pcall(function() firesignal(btn.MouseButton1Click) end)
											pcall(function() firesignal(btn.Activated) end)
										end
									end
								end)
							end
							return true
						end
					end)
				end
			end
		end
	end
	return false
end

-- قراءة كل شيء من واجهة اللعبة
local function readGameUI()
	local pg=LP:FindFirstChild("PlayerGui")
	if not pg then return {} end

	local data={pets={},plants={},tools={},stats={},other={}}

	local petKW={"pet","animal","dog","cat","bunny","dragon","fox","bear","butterfly","bee","frog","owl","parrot","turtle","fish","unicorn","wolf","companion","bird","snake","hamster"}
	local plantKW={"plant","seed","flower","tree","crop","grow","rose","tulip","sunflower","cactus","mushroom","vine","fruit","vegetable","herb","leaf","sprout","bloom","carrot","potato","tomato","corn","berry","melon","pumpkin","weed"}
	local toolKW={"tool","shovel","watering","hoe","rake","axe","shears","bucket","pot","fertilizer","spray","can","gloves"}
	local statKW={"coin","money","cash","gold","gem","diamond","level","xp","exp","score","point","star","token","currency","balance"}

	local function match(txt,kws)
		local l=txt:lower()
		for _,k in kws do if l:find(k) then return true end end
		return false
	end

	local seen={}

	for _,gui in pg:GetChildren() do
		if gui:IsA("ScreenGui") and gui.Name~="GS" then
			for _,desc in gui:GetDescendants() do
				pcall(function()
					local txt=""
					local icon=""

					if desc:IsA("TextLabel") or desc:IsA("TextButton") then
						txt=desc.Text or ""
					end

					if desc:IsA("ImageLabel") or desc:IsA("ViewportFrame") then
						local lbl=desc:FindFirstChildWhichIsA("TextLabel")
						if lbl then txt=lbl.Text or desc.Name else txt=desc.Name end
						icon="🖼️"
					end

					if txt and #txt>1 and #txt<300 then
						local skip={"Close","Back","X","close","back","<"}
						local doSkip=false
						for _,s in skip do if txt==s then doSkip=true end end

						if not doSkip and not seen[txt] then
							seen[txt]=true
							if match(txt,petKW) then
								table.insert(data.pets,txt)
							elseif match(txt,plantKW) then
								table.insert(data.plants,txt)
							elseif match(txt,toolKW) then
								table.insert(data.tools,txt)
							elseif match(txt,statKW) then
								table.insert(data.stats,txt)
							else
								table.insert(data.other,txt)
							end
						end
					end
				end)
			end
		end
	end

	return data
end

