local PET_KEYWORDS = {
	"pet", "animal", "companion", "dog", "cat", "bunny", "bird",
	"dragon", "fox", "bear", "butterfly", "bee", "frog", "snake",
	"owl", "parrot", "hamster", "turtle", "fish", "unicorn", "wolf"
}

local PLANT_KEYWORDS = {
	"plant", "seed", "flower", "tree", "crop", "garden", "grow",
	"rose", "tulip", "sunflower", "cactus", "mushroom", "vine",
	"fruit", "vegetable", "herb", "leaf", "sprout", "bloom", "weed",
	"carrot", "potato", "tomato", "corn", "berry", "melon", "pumpkin"
}

local TOOL_KEYWORDS = {
	"tool", "shovel", "watering", "hoe", "rake", "axe", "shears",
	"bucket", "pot", "fertilizer", "spray", "can", "gloves"
}

local function matchesCategory(name, keywords)
	local lower = name:lower()
	for _, kw in keywords do
		if lower:find(kw) then return true end
	end
	return false
end

local function categorize(name)
	if matchesCategory(name, PET_KEYWORDS) then return "pet" end
	if matchesCategory(name, PLANT_KEYWORDS) then return "plant" end
	if matchesCategory(name, TOOL_KEYWORDS) then return "tool" end
	return "other"
end

-- ═══════════════════════════════
--  مسح بيانات اللاعب
-- ═══════════════════════════════
local function deepScan(instance, maxDepth, depth)
	depth = depth or 0
	if depth > (maxDepth or 8) then return {} end
	local results = {}

	for _, child in instance:GetChildren() do
		local info = {
			Name = child.Name,
			Class = child.ClassName,
			Value = nil,
			Children = {}
		}

		-- قراءة القيم
		if child:IsA("ValueBase") then
			pcall(function()
				info.Value = tostring(child.Value)
			end)
		end

		-- فحص الأطفال
		if #child:GetChildren() > 0 then
			info.Children = deepScan(child, maxDepth, depth + 1)
		end

		table.insert(results, info)
	end
	return results
end

local function findTargetPlayer(name)
	local lower = name:lower()
	for _, p in Players:GetPlayers() do
		if p.Name:lower() == lower or p.DisplayName:lower() == lower then
			return p
		end
	end
	-- بحث جزئي
	for _, p in Players:GetPlayers() do
		if p.Name:lower():find(lower) or p.DisplayName:lower():find(lower) then
			return p
		end
	end
	return nil
end

local function scanAndDisplay(playerName)
	clearResults()
	StatusLabel.Text = "🔍 جاري البحث عن: " .. playerName .. "..."
	StatusLabel.TextColor3 = Color3.fromRGB(255, 220, 80)

	task.wait(0.1)

	local target = findTargetPlayer(playerName)
	if not target then
		StatusLabel.Text = "❌ اللاعب غير موجود في السيرفر!"
		StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
		addSection("❌ لم يتم العثور على اللاعب", 1)
		return
	end

	StatusLabel.Text = "✅ تم العثور على: " .. target.Name .. " | جاري المسح..."
	StatusLabel.TextColor3 = Color3.fromRGB(120, 220, 120)

	local pets = {}
	local plants = {}
	local tools = {}
	local stats = {}
	local other = {}
	local order = 0

	-- ═══ 1) مسح بيانات Player Object ═══
	local function processItem(child, depth)
		if depth > 6 then return end

		local cat = categorize(child.Name)

		-- ValueBase (IntValue, StringValue, etc.)
		if child:IsA("ValueBase") then
			local val = ""
			pcall(function() val = tostring(child.Value) end)

			local entry = { name = child.Name, detail = val, class = child.ClassName }

			if cat == "pet" then
				table.insert(pets, entry)
			elseif cat == "plant" then
				table.insert(plants, entry)
			elseif cat == "tool" then
				table.insert(tools, entry)
			else
				-- إذا كان رقم أو عملة = stats
				if child:IsA("IntValue") or child:IsA("NumberValue") then
					table.insert(stats, entry)
				else
					table.insert(other, entry)
				end
			end
		end

		-- مجلد / مودل
		if child:IsA("Folder") or child:IsA("Model") or child:IsA("Configuration") then
			local folderCat = categorize(child.Name)
			local items = child:GetChildren()

			if #items > 0 then
				for _, sub in items do
					-- إذا المجلد اسمه يدل على تصنيف، خذ كل أطفاله بهذا التصنيف
					if folderCat == "pet" then
						local val = ""
						if sub:IsA("ValueBase") then pcall(function() val = tostring(sub.Value) end) end
						table.insert(pets, { name = sub.Name, detail = val ~= "" and val or sub.ClassName, class = sub.ClassName })
					elseif folderCat == "plant" then
						local val = ""
						if sub:IsA("ValueBase") then pcall(function() val = tostring(sub.Value) end) end
						table.insert(plants, { name = sub.Name, detail = val ~= "" and val or sub.ClassName, class = sub.ClassName })
					elseif folderCat == "tool" then
						local val = ""
						if sub:IsA("ValueBase") then pcall(function() val = tostring(sub.Value) end) end
						table.insert(tools, { name = sub.Name, detail = val ~= "" and val or sub.ClassName, class = sub.ClassName })
					else
						processItem(sub, depth + 1)
					end
				end
			else
				-- مجلد فارغ
				table.insert(other, { name = child.Name, detail = "📁 فارغ", class = child.ClassName })
			end
		end

		-- أي شيء آخر (ObjectValue, Tool, etc.)
		if child:IsA("Tool") then
			table.insert(tools, { name = child.Name, detail = "Tool", class = "Tool" })
		elseif child:IsA("ObjectValue") then
			local val = ""
			pcall(function() val = child.Value and child.Value.Name or "nil" end)
			table.insert(other, { name = child.Name, detail = val, class = "ObjectValue" })
		end
	end

	-- مسح اللاعب
	for _, child in target:GetChildren() do
		if child.Name ~= "PlayerGui" and child.Name ~= "PlayerScripts" and child.Name ~= "Backpack" then
			processItem(child, 0)
		end
	end

	-- مسح Backpack
	if target:FindFirstChild("Backpack") then
		for _, tool in target.Backpack:GetChildren() do
			if tool:IsA("Tool") then
				table.insert(tools, { name = tool.Name, detail = "Backpack", class = "Tool" })
			end
		end
	end

	-- مسح Character للأدوات
	if target.Character then
		for _, obj in target.Character:GetChildren() do
			if obj:IsA("Tool") then
				table.insert(tools, { name = obj.Name, detail = "مجهز", class = "Tool" })
			end
		end
	end

	-- ═══ 2) مسح Workspace لبيانات اللاعب ═══
	local function scanWorkspaceForPlayer()
		-- البحث عن plots أو gardens تحمل اسم اللاعب
		for _, obj in workspace:GetDescendants() do
			pcall(function()
				if (obj.Name:find(target.Name) or obj.Name:find(target.UserId))
					and (obj:IsA("Model") or obj:IsA("Folder")) then

					for _, sub in obj:GetDescendants() do
						if sub:IsA("ValueBase") then
							local val = ""
							pcall(function() val = tostring(sub.Value) end)
							local cat = categorize(sub.Name)
							local entry = { name = sub.Name, detail = val, class = sub.ClassName }

							if cat == "pet" then table.insert(pets, entry)
							elseif cat == "plant" then table.insert(plants, entry)
							elseif cat == "tool" then table.insert(tools, entry)
							else table.insert(other, entry) end
						elseif sub:IsA("Model") and #sub:GetChildren() > 0 then
							local cat = categorize(sub.Name)
							local entry = { name = sub.Name, detail = "Model", class = "Model" }

							if cat == "pet" then table.insert(pets, entry)
							elseif cat == "plant" then table.insert(plants, entry)
							else table.insert(other, entry) end
						end
					end
				end
			end)
		end
	end
	scanWorkspaceForPlayer()

	-- ═══ 3) بحث عميق في Plots / Gardens ═══
	local plotFolders = {"Plots", "Gardens", "PlayerPlots", "PlayerGardens", "Farms"}
	for _, folderName in plotFolders do
		local folder = workspace:FindFirstChild(folderName)
		if not folder then continue end

		for _, plot in folder:GetChildren() do
			local belongsToTarget = false
			pcall(function()
				-- التحقق بعدة طرق
				if plot.Name:find(target.Name) or plot.Name:find(tostring(target.UserId)) then
					belongsToTarget = true
				end
				local ownerVal = plot:FindFirstChild("Owner") or plot:FindFirstChild("OwnerId") or plot:FindFirstChild("PlayerName")
				if ownerVal and ownerVal:IsA("ValueBase") then
					local v = tostring(ownerVal.Value)
					if v == target.Name or v == tostring(target.UserId) then
						belongsToTarget = true
					end
				end
			end)

			if belongsToTarget then
				for _, desc in plot:GetDescendants() do
					pcall(function()
						if desc:IsA("Model") or desc:IsA("MeshPart") or desc:IsA("ValueBase") then
							local cat = categorize(desc.Name)
							local val = ""
							if desc:IsA("ValueBase") then
								pcall(function() val = tostring(desc.Value) end)
							else
								val = desc.ClassName
							end
							local entry = { name = desc.Name, detail = val, class = desc.ClassName }

							if cat == "pet" then table.insert(pets, entry)
							elseif cat == "plant" then table.insert(plants, entry)
							elseif cat == "tool" then table.insert(tools, entry)
							else table.insert(other, entry) end
						end
					end)
				end
			end
		end
	end

	-- ═══ عرض النتائج ═══
	task.wait(0.1)

	-- إزالة التكرار
	local function deduplicate(list)
		local seen, clean = {}, {}
		for _, entry in list do
			local key = entry.name .. "|" .. entry.detail
			if not seen[key] then
				seen[key] = true
				table.insert(clean, entry)
			end
		end
		return clean
	end

	pets = deduplicate(pets)
	plants = deduplicate(plants)
	tools = deduplicate(tools)
	stats = deduplicate(stats)
	other = deduplicate(other)

	-- معلومات اللاعب
	order += 1
	addSection("👤 " .. target.Name .. " (@" .. target.DisplayName .. ")", order)
	order += 1
	addItem("🆔", "UserId", tostring(target.UserId), order)
	order += 1
	addItem("⏱️", "عمر الحساب", tostring(target.AccountAge) .. " يوم", order)

	-- الحيوانات
	if #pets > 0 then
		order += 1
		addSection("🐾 الحيوانات (" .. #pets .. ")", order)
		for _, p in pets do
			order += 1
			addItem("🐾", p.name, p.detail, order)
		end
	end

	-- النباتات
	if #plants > 0 then
		order += 1
		addSection("🌿 النباتات / البذور (" .. #plants .. ")", order)
		for _, p in plants do
			order += 1
			addItem("🌱", p.name, p.detail, order)
		end
	end

	-- الأدوات
	if #tools > 0 then
		order += 1
		addSection("🔧 الأدوات (" .. #tools .. ")", order)
		for _, t in tools do
			order += 1
			addItem("🛠️", t.name, t.detail, order)
		end
	end

	-- الإحصائيات
	if #stats > 0 then
		order += 1
		addSection("📊 الإحصائيات (" .. #stats .. ")", order)
		for _, s in stats do
			order += 1
			addItem("📈", s.name, s.detail, order)
		end
	end

	-- أخرى
	if #other > 0 then
		order += 1
		addSection("📦 بيانات أخرى (" .. #other .. ")", order)
		for _, o in other do
			order += 1
			addItem("📄", o.name, o.detail, order)
		end
	end

	local total = #pets + #plants + #tools + #stats + #other
	if total == 0 then
		order += 1
		addSection("⚠️ لم يتم العثور على بيانات مرئية", order)
		order += 1
		addItem("💡", "ملاحظة", "البيانات قد تكون على السيرفر فقط", order)
	end

	StatusLabel.Text = "✅ اكتمل المسح! عناصر: " .. total
	StatusLabel.TextColor3 = Color3.fromRGB(120, 220, 120)
end

-- ═══════════════════════════════
--  البحث عن Mailbox
-- ═══════════════════════════════
local function findAndGoMailbox()
	local char = LP.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then
		StatusLabel.Text = "❌ شخصيتك غير موجودة!"
		StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
		return
	end

	local hrp = char.HumanoidRootPart
	local closest, closestDist = nil, math.huge

	for _, obj in workspace:GetDescendants() do
		pcall(function()
			local nameL = obj.Name:lower()
			if (nameL:find("mail") or nameL:find("mailbox") or nameL:find("postbox") or nameL:find("letterbox"))
				and (obj:IsA("BasePart") or obj:IsA("Model")) then

				local pos
				if obj:IsA("Model") then
					local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
					if primary then pos = primary.Position end
				else
					pos = obj.Position
				end

				if pos then
					local dist = (pos - hrp.Position).Magnitude
					if dist < closestDist then
						closest = obj
						closestDist = dist
					end
				end
			end
		end)
	end

	if closest then
		local targetPos
		if closest:IsA("Model") then
			local p = closest.PrimaryPart or closest:FindFirstChildWhichIsA("BasePart")
			targetPos = p and p.Position or nil
		else
			targetPos = closest.Position
		end

		if targetPos then
			hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 5, 3))
			StatusLabel.Text = "📬 تم الانتقال إلى Mailbox! (المسافة: " .. math.floor(closestDist) .. ")"
			StatusLabel.TextColor3 = Color3.fromRGB(100, 180, 255)
     end
	 else
      StatusLabel.Text = "❌ لم يتم العثور على Mailbox!"
		StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
	end
end

