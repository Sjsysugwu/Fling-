    if input.KeyCode == Enum.KeyCode.S then backward = false end
    if input.KeyCode == Enum.KeyCode.A then left = false end
    if input.KeyCode == Enum.KeyCode.D then right = false end
end)

-- FLIGHT LOOP: MISSILE TURNS WITH MOVEMENT
connect(RunService.RenderStepped,function()
    if not active then return end

    if not missile or not missile.Parent then
        stopMissile()
        return
    end

    local look = getLook()
    local cameraCF = CFrame.lookAt(Vector3.zero,look)
    local cameraRight = cameraCF.RightVector
    local direction = Vector3.zero

    if forward then direction += look end
    if backward then direction -= look end
    if left then direction -= cameraRight end
    if right then direction += cameraRight end

    if direction.Magnitude > 0 then
        direction = direction.Unit

        if velocity then
            velocity.VectorVelocity = direction*SPEED
        end

        -- Face the direction of travel without extra 180-degree roll
        if orientation then
            orientation.CFrame = CFrame.lookAt(
                Vector3.zero,
                direction
            )
        end
    else
        -- No input: keep the missile still and retain its last orientation
        if velocity then
            velocity.VectorVelocity = Vector3.zero
        end
    end

    Camera.CameraType = Enum.CameraType.Scriptable

    if thirdPerson then
        local camPos =
            missile.Position-look*CAMERA_DISTANCE+Vector3.new(0,5,0)

        Camera.CFrame = CFrame.lookAt(
            camPos,
            missile.Position+look*5
        )
    else
        Camera.CFrame = CFrame.lookAt(
            missile.Position,
            missile.Position+look
        )
    end

    local pos = missile.Position
    local heading =
        (math.deg(math.atan2(-look.X,-look.Z))+360)%360

    hud.Text = string.format(
        "XR MISSILE\nALT: %.0f\nSPEED: %d\nHEADING: %03d°",
        pos.Y,SPEED,heading
    )
end)

