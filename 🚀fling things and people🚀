-- CAMERA LOOK
local function readAngles()
    local look = Camera.CFrame.LookVector
    yaw = math.atan2(-look.X,-look.Z)
    pitch = math.asin(math.clamp(look.Y,-1,1))
end

local function getLook()
    return CFrame.fromOrientation(pitch,yaw,0).LookVector
end

connect(UIS.InputBegan,function(input)
    if not active then return end

    if input.UserInputType == Enum.UserInputType.Touch then
        local objects = PG:GetGuiObjectsAtPosition(
            input.Position.X,input.Position.Y
        )

        for _,obj in ipairs(objects) do
            if obj:IsDescendantOf(menu)
            or obj:IsDescendantOf(controls)
            or obj == rocketButton then
                return
            end
        end

        cameraTouch = input
        lastTouch = input.Position

    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        cameraTouch = input
        lastTouch = input.Position
    end
end)

connect(UIS.InputChanged,function(input)
    if not active or not cameraTouch then return end

    if input == cameraTouch
    or input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position-lastTouch
        lastTouch = input.Position
        yaw -= delta.X*SENSITIVITY
        pitch = math.clamp(
            pitch-delta.Y*SENSITIVITY,
            math.rad(-80),math.rad(80)
        )
    end
end)

connect(UIS.InputEnded,function(input)
    if input == cameraTouch
    or input.UserInputType == Enum.UserInputType.MouseButton2 then
        cameraTouch = nil
        lastTouch = nil
    end
end)

-- PHYSICS
local function clearPhysics()
    if velocity then velocity:Destroy(); velocity = nil end
    if orientation then orientation:Destroy(); orientation = nil end
    if attachment then attachment:Destroy(); attachment = nil end
end

local function setupPhysics(part)
    clearPhysics()

    attachment = Instance.new("Attachment")
    attachment.Parent = part

    velocity = Instance.new("LinearVelocity")
    velocity.Attachment0 = attachment
    velocity.RelativeTo = Enum.ActuatorRelativeTo.World
    velocity.MaxForce = 1000000
    velocity.VectorVelocity = Vector3.zero
    velocity.Parent = part

    orientation = Instance.new("AlignOrientation")
    orientation.Attachment0 = attachment
    orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    orientation.MaxTorque = 1000000
    orientation.Responsiveness = 25
    orientation.Parent = part
end

-- STOP
local function stopMissile()
    active = false
    forward,backward,left,right = false,false,false,false
    cameraTouch,lastTouch = nil,nil

    clearPhysics()
    hud.Visible = false
    controls.Visible = false

    Camera.CameraType = oldCameraType or Enum.CameraType.Custom

    if oldCameraSubject and oldCameraSubject.Parent then
        Camera.CameraSubject = oldCameraSubject
    elseif LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then Camera.CameraSubject = hum end
    end

    startButton.Text = "MISSILE: OFF"
end

-- FIND NEAREST MISSILE
local function findNearestMissile()
    local character = LP.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local nearestPart
    local nearestDistance = MAX_DISTANCE

    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "BombMissile" then
            local part

            if obj:IsA("BasePart") then
                part = obj
            elseif obj:IsA("Model") then
                part = obj.PrimaryPart
                    or obj:FindFirstChildWhichIsA("BasePart",true)
            end

            if part then
                local distance = (part.Position-root.Position).Magnitude
                if distance <= nearestDistance then
                    nearestDistance = distance
                    nearestPart = part
                end
            end
        end
    end

    return nearestPart
end

-- START
local function startMissile()
    local part = findNearestMissile()

    if not part then
        startButton.Text = "NO NEAR MISSILE"
        task.delay(2,function()
            if not active and startButton.Parent then
                startButton.Text = "MISSILE: OFF"
            end
        end)
        return
    end

    missile = part
    oldCameraType = Camera.CameraType
    oldCameraSubject = Camera.CameraSubject

    readAngles()
    setupPhysics(missile)

    active = true
    Camera.CameraType = Enum.CameraType.Scriptable

    startButton.Text = "MISSILE: ON"
    hud.Visible = true
    controls.Visible = true
end

