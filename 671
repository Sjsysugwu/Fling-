----------------------------------------------
-- GAME LOGIC (FAST VERSION)
----------------------------------------------
local function findAnimalInWorkspace(name)
	local lowerName = string.lower(name)

	for _, obj in workspace:GetDescendants() do
		if (obj:IsA("Model") or obj:IsA("Part") or obj:IsA("MeshPart")) then
			if string.find(string.lower(obj.Name), lowerName, 1, true) then
				local pos = nil
				if obj:IsA("Model") and obj.PrimaryPart then
					pos = obj.PrimaryPart.Position
				elseif obj:IsA("BasePart") then
					pos = obj.Position
				end
				if pos then
					return obj, pos
				end
			end
		end
	end
	return nil, nil
end

local function teleportTo(position)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end

	-- INSTANT TELEPORT — بدون tween، مباشرة
	hrp.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
	return true
end

local function tryBuyAnimal(animalObj)
	-- ProximityPrompt
	local prompts = {}
	local searchIn = animalObj:IsA("Model") and animalObj:GetDescendants() or animalObj:GetChildren()

	for _, desc in searchIn do
		if desc:IsA("ProximityPrompt") then
			table.insert(prompts, desc)
		end
	end

	for _, prompt in prompts do
		fireproximityprompt(prompt)
		return true
	end

	-- ClickDetector
	for _, desc in searchIn do
		if desc:IsA("ClickDetector") then
			fireclickdetector(desc)
			return true
		end
	end

	-- Remote fallback
	for _, remote in game:GetService("ReplicatedStorage"):GetDescendants() do
		if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
			local rName = string.lower(remote.Name)
			if string.find(rName, "buy", 1, true)
				or string.find(rName, "purchase", 1, true)
				or string.find(rName, "claim", 1, true)
				or string.find(rName, "adopt", 1, true)
				or string.find(rName, "collect", 1, true) then
				pcall(function()
					if remote:IsA("RemoteEvent") then
						remote:FireServer(animalObj.Name)
					else
						remote:InvokeServer(animalObj.Name)
					end
				end)
			end
		end
	end

	return false
end

local function mainLoop()
	while isRunning do
		if not character or not character:FindFirstChild("HumanoidRootPart") then
			character = player.Character or player.CharacterAdded:Wait()
			task.wait(0.5)
			continue
		end

		-- تثبيت السرعة كل لوب
		applySpeed()

		for _, animalName in ipairs(targetAnimals) do
			if not isRunning then break end

			local obj, pos = findAnimalInWorkspace(animalName)
			if obj and pos then
				setStatus("⚡ " .. animalName .. " — TELEPORTING!")

				teleportTo(pos)
				task.wait(0.15)

				setStatus("💰 BUYING: " .. animalName)
				tryBuyAnimal(obj)
				task.wait(0.2)
			end
		end

		setStatus("🔄 Scanning... (" .. #targetAnimals .. " targets)")
		task.wait(SCAN_INTERVAL)
	end
end

