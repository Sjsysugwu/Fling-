AddBtn.MouseButton1Click:Connect(function()
	local name = string.gsub(AnimalInput.Text, "^%s+", "")
	name = string.gsub(name, "%s+$", "")
	if name == "" then return end

	for _, existing in ipairs(targetAnimals) do
		if string.lower(existing) == string.lower(name) then
			setStatus("⚠️ Already in list!")
			return
		end
	end

	table.insert(targetAnimals, name)
	AnimalInput.Text = ""
	refreshList()
	setStatus("✅ Added: " .. name)
end)

ToggleBtn.MouseButton1Click:Connect(function()
	if #targetAnimals == 0 then
		setStatus("⚠️ Add animals first!")
		return
	end

	isRunning = not isRunning

	if isRunning then
		ToggleBtn.Text = "⏹  STOP"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
		setStatus("⚡ RUNNING FAST...")
		task.spawn(mainLoop)
	else
		ToggleBtn.Text = "▶  START"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
		setStatus("⏸ Stopped")
	end
end)

SpeedUpBtn.MouseButton1Click:Connect(function()
	WALK_SPEED = math.min(WALK_SPEED + 10, 200)
	applySpeed()
