-- BUTTON CREATOR
local function makeButton(name, y)
local b = Instance.new("TextButton")
b.Size = UDim2.new(0.9, 0, 0, 32)
b.Position = UDim2.new(0.05, 0, 0, y)
b.BackgroundColor3 = BLACK
b.BorderSizePixel = 1
b.BorderColor3 = WHITE
b.TextColor3 = WHITE
b.Text = name .. " [OFF]"
b.Font = Enum.Font.GothamBold
b.TextSize = 11
b.Parent = Frame

Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)  

return b

end

local GlassBtn = makeButton("SHOW GLASS", 35)
local TPBtn = makeButton("TP END", 77)

-- BUTTON STATE
local function setButton(button, enabled, name)
button.Text = name .. (enabled and " [ON]" or " [OFF]")
button.BackgroundColor3 = enabled and WHITE or BLACK
button.TextColor3 = enabled and BLACK or WHITE
button.BorderColor3 = WHITE
end

-- SHOW GLASS
GlassBtn.MouseButton1Click:Connect(function()
glassEnabled = not glassEnabled

setButton(GlassBtn, glassEnabled, "SHOW GLASS")  

if glassEnabled then  
    for _, part in ipairs(Workspace:GetDescendants()) do  
        if part:IsA("BasePart")  
        and part.Transparency > 0  
        and part.Size.Y < 2 then  

            if not saved[part] then  
                saved[part] = {  
                    Color = part.Color,  
                    Transparency = part.Transparency  
                }  
            end  

            -- BLACK & WHITE GLASS  
            part.Color = part.CanCollide and WHITE or BLACK  
            part.Transparency = 0.5  
        end  
    end  
else  
    for part, properties in pairs(saved) do  
        if part and part.Parent then  
            part.Color = properties.Color  
            part.Transparency = properties.Transparency  
        end  
    end  

    table.clear(saved)  
end

end)

