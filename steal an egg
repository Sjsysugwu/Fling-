-- ==================== 12. TRANSLATION FUNCTIONS ====================

local function replacePlain(str, findStr, repStr)

if typeof(str) ~= "string"
or typeof(findStr) ~= "string"
or str == ""
or findStr == "" then

return str

end

local s, e =
string.find(
str,
findStr,
1,
true
)

if not s then
return str
end

local res = {}

while s do

table.insert(
res,
string.sub(str, 1, s - 1)
)

table.insert(
res,
repStr
)

str =
string.sub(
str,
e + 1
)

s, e =
string.find(
str,
findStr,
1,
true
)

end

table.insert(
res,
str
)

return table.concat(res)

end

local function translateText(raw)

if typeof(raw) ~= "string"
or raw == "" then

return raw

end

local res = raw

for _, item in ipairs(
RAW_TRANSLATIONS
) do

res =
replacePlain(
res,
item[1],
item[2]
)

end

return res

end

-- ==================== 13. LIVE TRANSLATION ====================

local function applyElemTranslation(elem)

if translatingSet[elem] then
return
end

if not (
elem:IsA("TextLabel")
or elem:IsA("TextButton")
) then
return
end

if elem:IsDescendantOf(PinGui) then
return
end

local cur = elem.Text

if not cur or cur == "" then
return
end

local lastApplied =
elem:GetAttribute(
"Ronnei_LastApplied"
)

if cur ~= lastApplied then
OriginalTexts[elem] = cur
end

local orig =
OriginalTexts[elem] or cur

-- ==================== ARABIC ====================

if isArabic then

local ar =
translateText(orig)

if elem.Text ~= ar then

translatingSet[elem] = true      

pcall(function()      

    elem:SetAttribute(      
        "Ronnei_LastApplied",      
        ar      
    )      

    elem.Text = ar      

end)      

translatingSet[elem] = nil

end

-- ==================== ENGLISH ====================

else

if elem.Text ~= orig then

translatingSet[elem] = true      

pcall(function()      

    elem:SetAttribute(      
        "Ronnei_LastApplied",      
        nil      
    )      

    elem.Text = orig      

end)      

translatingSet[elem] = nil

end

end

end

local function hookElement(elem)

if (
elem:IsA("TextLabel")
or elem:IsA("TextButton")
)
and not elem:IsDescendantOf(PinGui) then

pcall(
applyElemTranslation,
elem
)

if not elem:GetAttribute(
"Ronnei_Hooked"
) then

elem:SetAttribute(      
    "Ronnei_Hooked",      
    true      
)      

elem:GetPropertyChangedSignal(      
    "Text"      
):Connect(function()      

    pcall(      
        applyElemTranslation,      
        elem      
    )      

end)

end

end

end
-- ==================== 14. TRANSLATION LOOP ====================

local function scanForTranslation(root)

if not root then
return
end

for _, obj in ipairs(root:GetDescendants()) do
pcall(function()
hookElement(obj)
end)
end

end

local function watchTranslationRoot(root)

if not root then
return
end

scanForTranslation(root)

root.DescendantAdded:Connect(function(obj)

task.defer(function()

pcall(function()      
    hookElement(obj)      
end)

end)

end)

end

-- Watch the main GUI
if MainGuiRoot then
watchTranslationRoot(MainGuiRoot)
end

-- Watch PlayerGui for dynamically created elements
watchTranslationRoot(PlayerGui)

-- Continuous translation safety scan
task.spawn(function()

while task.wait(1) do

pcall(function()

if MainGuiRoot then      
    scanForTranslation(MainGuiRoot)      
end

end)

end

end)

