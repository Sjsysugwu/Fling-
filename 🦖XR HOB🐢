--==========================================================
-- PERFORMANCE
--==========================================================

local function Optimize(Object)

	pcall(function()

		if Object:IsA("ParticleEmitter")
		or Object:IsA("Trail")
		or Object:IsA("Beam") then

			Object.Enabled = false

		elseif Object:IsA("PointLight")
		or Object:IsA("SpotLight")
		or Object:IsA("SurfaceLight") then

			Object.Shadows = false

		elseif Object:IsA("BlurEffect")
		or Object:IsA("DepthOfFieldEffect")
		or Object:IsA("SunRaysEffect") then

			Object.Enabled = false

		end

	end)

end

local function EnablePerformance()

	PerformanceEnabled = true

	for _,Object in ipairs(Workspace:GetDescendants()) do
		Optimize(Object)
	end

	for _,Object in ipairs(Lighting:GetDescendants()) do
		Optimize(Object)
	end

	PerformanceButton.Text =
		'<font color="rgb(255,255,255)">[+] MEJORAR RENDIMIENTO • </font>'..
		'<font color="rgb(0,255,100)">ON</font>'

end

local function DisablePerformance()

	PerformanceEnabled = false

	PerformanceButton.Text =
		'<font color="rgb(255,255,255)">[-] MEJORAR RENDIMIENTO • </font>'..
		'<font color="rgb(255,60,60)">OFF</font>'

end

Workspace.DescendantAdded:Connect(function(Object)

	if PerformanceEnabled then

		task.defer(function()

			if Object and Object.Parent then
				Optimize(Object)
			end

		end)

	end

end)

Lighting.DescendantAdded:Connect(function(Object)

	if PerformanceEnabled then

		task.defer(function()

			if Object and Object.Parent then
				Optimize(Object)
			end

		end)

	end

end)

PerformanceButton.MouseButton1Click:Connect(function()

	if PerformanceEnabled then
		DisablePerformance()
	else
		EnablePerformance()
	end

end)

EnablePerformance()

--==========================================================
-- TELEPORT
--==========================================================

local function DoTeleport(Character)

	if not UltraTP then
		return
	end

	if not Character or not Character.Parent then
		return
	end

	for Index,Point in ipairs(TP_POINTS) do

		if not UltraTP then

			Status.Text = "🤖 TP OFF 🤖"
			Status.TextColor3 =
				Color3.fromRGB(255,60,60)

			return

		end

		Status.Text =
			"[TP] POINT "..Index.."/"..#TP_POINTS

		Status.TextColor3 =
			Color3.fromRGB(255,255,255)

		pcall(function()

			Character:PivotTo(
				CFrame.new(Point)
			)

		end)

		if Index < #TP_POINTS then
			RunService.Heartbeat:Wait()
		end

	end

	Status.Text = "🛡🛡🛡🛡"
	Status.TextColor3 =
		Color3.fromRGB(255,255,255)

end

--==========================================================
-- PROMPT
--==========================================================

ProximityPromptService.PromptTriggered:Connect(
	function(Prompt,Who)

		if Who ~= Player then
			return
		end

		if not UltraTP then
			return
		end

		if Busy then
			return
		end

		local Character = Player.Character

		if not Character then
			return
		end

		Busy = true

		DoTeleport(Character)

		Busy = false

	end
)

