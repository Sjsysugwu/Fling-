local function findStruggleRemote()
    local events = ReplicatedStorage:FindFirstChild("CharacterEvents")
    if not events then
        return nil
    end

    local remote = events:FindFirstChild("Struggle")

    if remote and remote:IsA("RemoteEvent") then
        return remote
    end

    return nil
end

local function stopAntiGrab()
    antiGrabEnabled = false

    if autoStruggleConn then
        autoStruggleConn:Disconnect()
        autoStruggleConn = nil
    end
end

local function startAntiGrab()
    if autoStruggleConn then
        autoStruggleConn:Disconnect()
        autoStruggleConn = nil
    end

    antiGrabEnabled = true
    lastStruggle = 0

    autoStruggleConn = RunService.Heartbeat:Connect(function()
        if not antiGrabEnabled then
            return
        end

        local character = LocalPlayer.Character
        if not character then
            return
        end

        local head = character:FindFirstChild("Head")
        local humanoid = character:FindFirstChildOfClass("Humanoid")

        if not head or not humanoid or humanoid.Health <= 0 then
            return
        end

        local partOwner = head:FindFirstChild("PartOwner")
        local isHeld = LocalPlayer:FindFirstChild("IsHeld")
        local heldAttribute = LocalPlayer:GetAttribute("IsHeld")

        local grabbed =
            partOwner ~= nil
            or (isHeld and isHeld:IsA("BoolValue") and isHeld.Value)
            or heldAttribute == true

        if not grabbed then
            return
        end

        local now = os.clock()
        if now - lastStruggle < 0.5 then
            return
        end

        lastStruggle = now

        local struggle = findStruggleRemote()

        if struggle then
            pcall(function()
                struggle:FireServer(LocalPlayer)
            end)
        end
    end)
end

