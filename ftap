-- =====================================================
-- ⚙️ VARIABLES
-- =====================================================

local antiGrabEnabled = false
local antiExplosionEnabled = false

local infiniteJumpEnabled = false
local customJumpEnabled = false
local customJumpPower = 50

local speedEnabled = false
local customSpeed = 16

local antiGrabConnection = nil
local antiExplosionConnection = nil
local speedConnectionName = "DefensePlayerSpeed"

-- =====================================================
-- 🔎 CHARACTER EVENTS
-- =====================================================

local function getCharacterEvents()
    local events = ReplicatedStorage:FindFirstChild("CharacterEvents")

    local struggle = events and events:FindFirstChild("Struggle")
    local ragdoll = events and events:FindFirstChild("RagdollRemote")

    return struggle, ragdoll
end

-- =====================================================
-- 🧹 STOP CONNECTIONS
-- =====================================================

local function stopAntiGrab()
    if antiGrabConnection then
        antiGrabConnection:Disconnect()
        antiGrabConnection = nil
    end
end

local function stopAntiExplosion()
    if antiExplosionConnection then
        antiExplosionConnection:Disconnect()
        antiExplosionConnection = nil
    end
end

-- =====================================================
-- 🛡️ ANTI GRAB
-- =====================================================

DefenseGroup:AddToggle("DefenseAntiGrab", {
    Text = "🛡️ Anti Grab",
    Default = false,

    Callback = function(Value)
        antiGrabEnabled = Value
        stopAntiGrab()

        if Value then
            antiGrabConnection = RunService.Heartbeat:Connect(function()
                if not antiGrabEnabled then
                    return
                end

                local character = LocalPlayer.Character
                if not character then
                    return
                end

                local isHeld = LocalPlayer:FindFirstChild("IsHeld")

                if not isHeld or not isHeld.Value then
                    return
                end

                local struggle = getCharacterEvents()

                if struggle then
                    pcall(function()
                        struggle:FireServer(LocalPlayer)
                    end)
                end
            end)
        end

        Library:Notify({
            Title = "🛡️ Anti Grab",
            Description = Value and "Anti Grab ON" or "Anti Grab OFF",
            Time = 2
        })
    end
})

-- =====================================================
-- 💥 ANTI EXPLOSION
-- =====================================================

DefenseGroup:AddToggle("DefenseAntiExplosion", {
    Text = "💥 Anti Explosion",
    Default = false,

    Callback = function(Value)
        antiExplosionEnabled = Value
        stopAntiExplosion()

        if Value then
            antiExplosionConnection = Workspace.ChildAdded:Connect(function(object)
                if not antiExplosionEnabled then
                    return
                end

                if not object:IsA("Explosion") then
                    return
                end

                local character = LocalPlayer.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")

                if not root or not humanoid or humanoid.Health <= 0 then
                    return
                end

                local distance = (object.Position - root.Position).Magnitude

                if distance <= object.BlastRadius then
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end)
        end

        Library:Notify({
            Title = "💥 Anti Explosion",
            Description = Value and "Protection ON" or "Protection OFF",
            Time = 2
        })
    end
})

-- =====================================================
-- 🏃 MANUAL ESCAPE
-- =====================================================

DefenseGroup:AddButton("ManualEscape", {
    Text = "🏃 Manual Escape / Break Free",

    Func = function()
        local struggle, ragdoll = getCharacterEvents()

        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")

        pcall(function()
            if struggle then
                struggle:FireServer(LocalPlayer)
            end

            if ragdoll and root then
                ragdoll:FireServer(root, 0)
            end
        end)

        Library:Notify({
            Title = "🏃 Manual Escape",
            Description = "Escape request sent",
            Time = 2
        })
    end
})

