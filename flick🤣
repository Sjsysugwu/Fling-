local function getRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function isNearby(other)
    local myRoot = getRoot(player.Character)
    local otherRoot = getRoot(other.Character)

    if not myRoot or not otherRoot then
        return false
    end

    return (myRoot.Position - otherRoot.Position).Magnitude
        <= MAX_DISTANCE
end

local function updateToggle()
    toggle.Text = enabled and "CAMLOCK: ON" or "CAMLOCK: OFF"
    toggle.BackgroundColor3 = enabled and GREEN or RED
end

local function refreshPlayers()
    for _, item in ipairs(list:GetChildren()) do
        if item:IsA("TextButton") then
            item:Destroy()
        end
    end

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and isNearby(other) then
            local button = Instance.new("TextButton")
            button.Size = UDim2.new(1, -8, 0, 32)
            button.BackgroundColor3 = Color3.fromRGB(35, 15, 22)
            button.Text = other.DisplayName
            button.TextColor3 = WHITE
            button.TextScaled = true
            button.Font = Enum.Font.GothamBold
            button.ZIndex = 6
            button.Parent = list

            Instance.new("UICorner", button).CornerRadius =
                UDim.new(0, 7)

            local bs = Instance.new("UIStroke")
            bs.Color = DARK_RED
            bs.Thickness = 1
            bs.Parent = button

            button.MouseButton1Click:Connect(function()
                if not isNearby(other) then
                    target = nil
                    enabled = false
                    updateToggle()
                    choose.Text = "اللاعب بعيد!"
                    refreshPlayers()
                    return
                end

                target = other
                choose.Text = other.DisplayName
                list.Visible = false
            end)
        end
    end
end

choose.MouseButton1Click:Connect(function()
    refreshPlayers()
    list.Visible = not list.Visible
end)

toggle.MouseButton1Click:Connect(function()
    if not enabled then
        if not target then
            choose.Text = "اختر لاعبًا أولًا!"
            return
        end

        if not isNearby(target) then
            target = nil
            choose.Text = "اللاعب بعيد!"
            refreshPlayers()
            return
        end

        enabled = true
    else
        enabled = false
    end

    updateToggle()
end)

mode.MouseButton1Click:Connect(function()
    aimPart = aimPart == "HumanoidRootPart"
        and "Head"
        or "HumanoidRootPart"

    mode.Text = aimPart == "Head"
        and "TARGET PART: HEAD"
        or "TARGET PART: BODY"
end)

-- Animated luxury red glow
local pulseInfo = TweenInfo.new(
    1.1,
    Enum.EasingStyle.Sine,
    Enum.EasingDirection.InOut,
    -1,
    true
)

TweenService:Create(stroke, pulseInfo, {
    Thickness = 4
}):Play()

TweenService:Create(strokeGradient, TweenInfo.new(
    2,
    Enum.EasingStyle.Linear,
    Enum.EasingDirection.InOut,
    -1
), {
    Rotation = 360
}):Play()

TweenService:Create(title, pulseInfo, {
    TextColor3 = HOT_RED
}):Play()

TweenService:Create(toggleStroke, pulseInfo, {
    Thickness = 3
}):Play()

-- Camera follow
RunService:BindToRenderStep(
    renderName,
    Enum.RenderPriority.Camera.Value + 1,
    function()
        if not enabled or not target then
            return
        end

        if not isNearby(target) then
            enabled = false
            target = nil
            updateToggle()
            choose.Text = "اختيار لاعب ▼"
            list.Visible = false
            return
        end

        local character = target.Character
        local part = character and character:FindFirstChild(aimPart)
        local humanoid = character and
            character:FindFirstChildOfClass("Humanoid")

        if not part or not humanoid or humanoid.Health <= 0 then
            return
        end

        local camera = workspace.CurrentCamera

        if camera then
            camera.CFrame = CFrame.lookAt(
                camera.CFrame.Position,
                part.Position
            )
        end
    end
)

Players.PlayerRemoving:Connect(function(other)
    if target == other then
        target = nil
        enabled = false
        updateToggle()
        choose.Text = "اختيار لاعب ▼"
        list.Visible = false
    end
end)

Players.PlayerAdded:Connect(function()
    if list.Visible then
        refreshPlayers()
    end
end)

task.spawn(function()
    while gui.Parent do
        task.wait(1)
        if list.Visible then
            refreshPlayers()
        end
    end
end)

