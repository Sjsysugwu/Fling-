local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local lp = Players.LocalPlayer
local targetPlayer = nil
local attacking = false

-- Find Player
local function getPlayer(str)
	for _,v in pairs(Players:GetPlayers()) do
		if v.Name:lower():sub(1,#str) == str:lower() then
			return v
		end
	end
end

-- GUI
local gui = Instance.new("ScreenGui")
gui.Parent = game.CoreGui
gui.ResetOnSpawn = false

local frame = Instance.new("Frame")
frame.Parent = gui
frame.Size = UDim2.new(0,320,0,240)
frame.Position = UDim2.new(0.35,0,0.3,0)
frame.BackgroundColor3 = Color3.fromRGB(35,35,35)
frame.Active = true
frame.Draggable = true

local corner = Instance.new("UICorner", frame)

local title = Instance.new("TextLabel")
title.Parent = frame
title.Size = UDim2.new(1,0,0,35)
title.BackgroundColor3 = Color3.fromRGB(25,25,25)
title.Text = "Attack GUI"
title.TextColor3 = Color3.new(1,1,1)
title.TextScaled = true

local box = Instance.new("TextBox")
box.Parent = frame
box.Size = UDim2.new(0,280,0,45)
box.Position = UDim2.new(0,20,0,50)
box.PlaceholderText = "Enter Player Name"
box.Text = ""
box.TextScaled = true
box.BackgroundColor3 = Color3.fromRGB(55,55,55)
box.TextColor3 = Color3.new(1,1,1)

local attackBtn = Instance.new("TextButton")
attackBtn.Parent = frame
attackBtn.Size = UDim2.new(0,280,0,45)
attackBtn.Position = UDim2.new(0,20,0,110)
attackBtn.Text = "Attack Player"
attackBtn.TextScaled = true
attackBtn.BackgroundColor3 = Color3.fromRGB(255,170,0)
attackBtn.TextColor3 = Color3.new(1,1,1)

local stopBtn = Instance.new("TextButton")
stopBtn.Parent = frame
stopBtn.Size = UDim2.new(0,280,0,45)
stopBtn.Position = UDim2.new(0,20,0,170)
stopBtn.Text = "Leave Player"
stopBtn.TextScaled = true
stopBtn.BackgroundColor3 = Color3.fromRGB(255,70,70)
stopBtn.TextColor3 = Color3.new(1,1,1)

-- Attack
attackBtn.MouseButton1Click:Connect(function()
	local target = getPlayer(box.Text)

	if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
		targetPlayer = target
		attacking = true
	end
end)

-- Stop
stopBtn.MouseButton1Click:Connect(function()
	attacking = false
	targetPlayer = nil
end)

-- Follow Fast
RunService.Heartbeat:Connect(function()
	if attacking and targetPlayer and targetPlayer.Character then
		local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
		local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")

		if targetHRP and myHRP then
			myHRP.CFrame = targetHRP.CFrame * CFrame.new(0,0,2)

			-- Fast Dash Effect
			local bv = Instance.new("BodyVelocity")
			bv.MaxForce = Vector3.new(999999,0,999999)
			bv.Velocity = myHRP.CFrame.LookVector * 120
			bv.Parent = myHRP

			Debris:AddItem(bv,0.1)
		end
	end
end)
