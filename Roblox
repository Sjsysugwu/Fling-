    local tpOnlyBtn = makeBtn("🍎 TP أقوى فاكهة (بدون هوب)", 3, Color3.fromRGB(40, 80, 160))

    -- ══════════════════════════════════════
    -- MAIN LOOP
    -- ══════════════════════════════════════
    local function mainLoop()
        if isHopping then return end
        isHopping = true

        while alive and isHopping do
            -- 1. انتظر تحميل الماب
            setStatus("⏳ جاري تحميل الماب...", Color3.fromRGB(255, 255, 100))
            task.wait(CONFIG.WaitOnJoin)

            if not alive or not isHopping then break end

            -- 2. انتظر الكراكتر
            local attempts = 0
            while not getHRP() and attempts < 30 do
                task.wait(0.5)
                attempts += 1
            end

            if not alive or not isHopping then break end

            -- 3. ابحث عن أقوى فاكهة
            setStatus("🔍 جاري البحث عن أقوى فاكهة...", Color3.fromRGB(100, 200, 255))
            task.wait(1)

            local fruitObj, fruitVal, fruitCF = findBestFruit()

            if fruitObj and fruitCF then
                setStatus(string.format("🍎 لقيت: %s (%.0f)\n🚀 جاري التلبرت...", fruitObj.Name, fruitVal), Color3.fromRGB(100, 255, 150))
                task.wait(0.5)

                safeTP(fruitCF)

                setStatus(string.format("✅ وصلت! %s\n⏱️ هوب بعد %ds...", fruitObj.Name, CONFIG.WaitBeforeHop), Color3.fromRGB(150, 255, 150))
            else
                setStatus(string.format("❌ ما لقيت فواكه!\n⏱️ هوب بعد %ds...", CONFIG.WaitBeforeHop), Color3.fromRGB(255, 150, 80))
            end

            if not alive or not isHopping then break end

            -- 4. عد تنازلي قبل الهوب
            for i = CONFIG.WaitBeforeHop, 1, -1 do
                if not alive or not isHopping then break end
                setStatus(string.format("⏱️ هوب بعد %d ثانية...", i), Color3.fromRGB(255, 200, 50))
                task.wait(1)
            end

            if not alive or not isHopping then break end

            -- 5. Queue rerun + Hop
            setStatus("🔄 جاري السيرفر هوب...", Color3.fromRGB(255, 150, 50))

            -- جهز اعادة التشغيل بعد الهوب
            local scriptCode = [[
-- Auto-rerun after hop
task.wait(3)
loadstring(game:HttpGet("GAG2_SCRIPT_URL_HERE"))()
]]
            -- اذا السكربت محفوظ محلي، نستخدم السورس الاصلي
            pcall(function()
                -- نحاول نرسل السكربت الحالي
                if queue_on_teleport then
                    -- ملاحظة: لازم تحط لينك السكربت هنا لو تبيه يشتغل تلقائي بعد الهوب
                    -- queue_on_teleport('loadstring(game:HttpGet("YOUR_RAW_LINK"))()') 
                end
            end)

            -- هوب!
            local hopOk = pcall(hopToNewServer)
            if not hopOk then
                setStatus("❌ فشل الهوب! اعادة المحاولة...", Color3.fromRGB(255, 80, 80))
                task.wait(3)
                pcall(function()
                    TeleportService:Teleport(PlaceId, Player)
                end)
            end

            -- انتظر الهوب يكتمل
            task.wait(10)
        end

        isHopping = false
        if alive then
            setStatus("⛔ متوقف", Color3.fromRGB(200, 200, 200))
        end
    end

    -- ══════════════════════════════════════
    -- BUTTON EVENTS
    -- ══════════════════════════════════════
    startBtn.MouseButton1Click:Connect(function()
        if isHopping then return end
        task.spawn(mainLoop)
    end)

    stopBtn.MouseButton1Click:Connect(function()
        isHopping = false
        setStatus("⛔ جاري الإيقاف...", Color3.fromRGB(255, 100, 100))
    end)

    tpOnlyBtn.MouseButton1Click:Connect(function()
        task.spawn(function()
            setStatus("🔍 جاري البحث...", Color3.fromRGB(100, 200, 255))
            local obj, val, cf = findBestFruit()
