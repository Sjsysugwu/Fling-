                safeTP(cf)
                setStatus(string.format("✅ %s (%.0f)", obj.Name, val), Color3.fromRGB(150, 255, 150))
            else
                setStatus("❌ ما لقيت فواكه بالسيرفر!", Color3.fromRGB(255, 80, 80))
            end
        end)
    end)

    -- Open anim
    Main.Position = UDim2.new(0.5, -140, -0.5, 0)
    TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Back), {
        Position = UDim2.new(0.5, -140, 0.5, -120)
    }):Play()

    return ScreenGui
end

