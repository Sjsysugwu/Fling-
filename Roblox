-- AUTO-START (لو جاي من هوب)
-- ══════════════════════════════════════
local function checkAutoStart()
    -- لو جاي من هوب سابق، ابدأ تلقائي
    if _G.GAG2_AUTO_HOP then
        task.wait(CONFIG.WaitOnJoin)
        local obj, val, cf = findBestFruit()
        if obj and cf then
            safeTP(cf)
        end
        -- كمل الهوب
        task.wait(CONFIG.WaitBeforeHop)
        pcall(hopToNewServer)
    end
end

