                BackgroundColor3 = Color3.new(math.min(color.R + 0.12, 1), math.min(color.G + 0.12, 1), math.min(color.B + 0.12, 1))
            }):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = color}):Play()
        end)

        return btn
    end

