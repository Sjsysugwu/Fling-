local function getHRP()
    local char = Player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
end

local function safeTP(targetCFrame)
    local hrp, hum = getHRP()
    if not hrp or not hum then return false end

    hum.Sit = false
    task.wait(0.1)

    local dist = (hrp.Position - targetCFrame.Position).Magnitude

    if dist > 400 then
        local steps = math.ceil(dist / 80)
        local start = hrp.CFrame
        for i = 1, steps do
            if not alive then return false end
            hrp.CFrame = start:Lerp(targetCFrame + CONFIG.TPOffset, i / steps)
            task.wait(0.06)
        end
    else
        hrp.CFrame = targetCFrame + CONFIG.TPOffset
    end

    return true
end

-- ══════════════════════════════════════
-- FRUIT SCANNER
-- ══════════════════════════════════════
local function isFruit(obj)
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return false end
    local name = obj.Name:lower()

    for _, kw in CONFIG.IgnoreKeywords do
        if name:find(kw) then return false end
    end

    for _, kw in CONFIG.FruitKeywords do
        if name:find(kw) then return true end
    end

    for _, attr in CONFIG.ValueAttributes do
        if obj:GetAttribute(attr) then return true end
    end

    for _, child in obj:GetChildren() do
        if child:IsA("NumberValue") or child:IsA("IntValue") then
            local cn = child.Name:lower()
            if cn:find("value") or cn:find("tier") or cn:find("rarity") or cn:find("power") then
                return true
            end
        end
    end

    return false
end

local function getFruitValue(obj)
    local val = 0

    for _, attr in CONFIG.ValueAttributes do
        local v = obj:GetAttribute(attr)
        if type(v) == "number" then val = math.max(val, v) end
    end

    for _, child in obj:GetChildren() do
        if child:IsA("NumberValue") or child:IsA("IntValue") then
            val = math.max(val, child.Value)
        end
    end

    -- Fallback: حجم = قوة (اللي طلبه اليوزر)
    if val == 0 then
        local size = Vector3.zero
        if obj:IsA("BasePart") then
            size = obj.Size
        elseif obj:IsA("Model") then
            pcall(function()
                local _, sz = obj:GetBoundingBox()
                size = sz
            end)
            if size == Vector3.zero then
                local p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if p then size = p.Size end
            end
        end
        val = size.X * size.Y * size.Z
    end

    return val
end

local function getFruitCFrame(obj)
    if obj:IsA("BasePart") then return obj.CFrame end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.CFrame end
        local p = obj:FindFirstChildWhichIsA("BasePart")
        if p then return p.CFrame end
        local cf; pcall(function() cf = obj:GetBoundingBox() end)
        return cf
    end
    return nil
end

local function findBestFruit()
    local bestObj, bestVal, bestCF = nil, 0, nil

    for _, obj in workspace:GetDescendants() do
        if isFruit(obj) then
            local val = getFruitValue(obj)
            if val > bestVal then
                local cf = getFruitCFrame(obj)
                if cf then
                    bestObj = obj
                    bestVal = val
                    bestCF  = cf
                end
            end
        end
    end

    return bestObj, bestVal, bestCF
end

-- ══════════════════════════════════════
-- SERVER HOP
-- ══════════════════════════════════════
local function getServerList()
    local servers = {}
    local cursor = ""
    local attempts = 0

    repeat
        attempts += 1
        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true%s",
            PlaceId,
            cursor ~= "" and ("&cursor=" .. cursor) or ""
        )

        local ok, result = pcall(function()
            if syn and syn.request then
                return syn.request({Url = url, Method = "GET"})
            elseif request then
                return request({Url = url, Method = "GET"})
            elseif http_request then
                return http_request({Url = url, Method = "GET"})
            elseif fluxus and fluxus.request then
                return fluxus.request({Url = url, Method = "GET"})
            end
        end)

        if ok and result and result.Body then
            local data = HttpService:JSONDecode(result.Body)
            if data and data.data then
                for _, server in data.data do
                    if server.id ~= JobId and server.playing and server.maxPlayers and server.playing < server.maxPlayers then
                        table.insert(servers, server.id)
                    end
                end
                cursor = data.nextPageCursor or ""
            else
                break
            end
        else
            break
        end
    until cursor == "" or #servers >= 50 or attempts >= 3

    return servers
end

local function hopToNewServer()
    local servers = getServerList()

    if #servers == 0 then
        -- Fallback: rejoin random
        TeleportService:Teleport(PlaceId, Player)
        return true
    end

    local targetServer = servers[math.random(1, #servers)]
    TeleportService:TeleportToPlaceInstance(PlaceId, targetServer, Player)
    return true
end

