local function queueRerun(scriptSource)
    local queued = false

    -- محاولة queue_on_teleport
    if queue_on_teleport then
        pcall(function()
            queue_on_teleport(scriptSource)
            queued = true
        end)
    end

    -- Fallback: syn
    if not queued and syn and syn.queue_on_teleport then
        pcall(function()
            syn.queue_on_teleport(scriptSource)
            queued = true
        end)
    end

    -- Fallback: fluxus
    if not queued and fluxus and fluxus.queue_on_teleport then
        pcall(function()
            fluxus.queue_on_teleport(scriptSource)
            queued = true
        end)
    end

    return queued
end

