
-- =========================================
-- 👑 XR RAINBOW LUXURY ESP 🌈
-- Floating ON / OFF Button
-- Animated Rainbow Box + Tracer
-- =========================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- COLORS
local BLACK = Color3.fromRGB(15, 15, 20)
local WHITE = Color3.fromRGB(255, 255, 255)

-- STATE
local Enabled = false
local Drawings = {}
local RainbowHue = 0

-- GUI
local OldGui = CoreGui:FindFirstChild("XR_Rainbow_Luxury_ESP")
if OldGui then
    OldGui:Destroy()
end

local Gui = Instance.new("ScreenGui")
Gui.Name = "XR_Rainbow_Luxury_ESP"
Gui.ResetOnSpawn = false
Gui.DisplayOrder = 999999
Gui.Parent = CoreGui

-- BUTTON
local Button = Instance.new("TextButton")
Button.Name = "ESPToggle"
Button.Size = UDim2.fromOffset(85, 58)
Button.Position = UDim2.new(1, -100, 0, 110)
Button.BackgroundColor3 = BLACK
Button.Text = "🌈 ESP OFF"
Button.TextColor3 = WHITE
Button.TextSize = 13
Button.Font = Enum.Font.GothamBold
Button.Parent = Gui

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 14)
Corner.Parent = Button

local Border = Instance.new("UIStroke")
Border.Color = Color3.fromRGB(255, 0, 255)
Border.Thickness = 2
Border.Parent = Button

-- RAINBOW SETUP
local function Rainbow(hue)
    return Color3.fromHSV(hue % 1, 1, 1)
end

-- HIDE ESP
local function Hide(data)
    pcall(function()
        data.Box.Visible = false
        data.Tracer.Visible = false
    end)
end

-- REMOVE ESP
local function RemoveESP(player)
    local data = Drawings[player]

    if data then
        pcall(function()
            data.Box:Remove()
            data.Tracer:Remove()
        end)

        Drawings[player] = nil
    end
end

-- CREATE ESP
local function SetupESP(player)
    if player == LocalPlayer then return end
    if Drawings[player] then return end

    local success, data = pcall(function()
        local box = Drawing.new("Square")
        box.Visible = false
        box.Color = WHITE
        box.Thickness = 2
        box.Filled = false

        local tracer = Drawing.new("Line")
        tracer.Visible = false
        tracer.Color = WHITE
        tracer.Thickness = 2

        return {
            Box = box,
            Tracer = tracer
        }
    end)

    if success then
        Drawings[player] = data
    end
end

-- PLAYERS
Players.PlayerAdded:Connect(SetupESP)
Players.PlayerRemoving:Connect(RemoveESP)

for _, player in ipairs(Players:GetPlayers()) do
    SetupESP(player)
end

-- ON / OFF
Button.MouseButton1Click:Connect(function()
    Enabled = not Enabled

    if Enabled then
        Button.Text = "🌈 ESP ON"
    else
        Button.Text = "🌈 ESP OFF"

        for _, data in pairs(Drawings) do
            Hide(data)
        end
    end
end)

-- ESP UPDATE
local Connection

Connection = RunService.RenderStepped:Connect(function(deltaTime)
    RainbowHue = (RainbowHue + deltaTime * 0.35) % 1

    local buttonColor = Rainbow(RainbowHue)
    Border.Color = buttonColor

    if Enabled then
        Button.BackgroundColor3 = Color3.fromRGB(35, 20, 45)
        Button.TextColor3 = buttonColor
    else
        Button.BackgroundColor3 = BLACK
        Button.TextColor3 = WHITE
    end

    if not Enabled then return end

    local Camera = workspace.CurrentCamera
    if not Camera then return end

    for player, data in pairs(Drawings) do
        local character = player.Character
        local humanoid = character and
            character:FindFirstChildOfClass("Humanoid")
        local root = character and
            character:FindFirstChild("HumanoidRootPart")

        if humanoid and root and humanoid.Health > 0 then
            local top = root.Position + Vector3.new(0, 3, 0)
            local bottom = root.Position - Vector3.new(0, 3.5, 0)

            local topPos, topVisible =
                Camera:WorldToViewportPoint(top)

            local bottomPos, bottomVisible =
                Camera:WorldToViewportPoint(bottom)

            if topVisible and bottomVisible then
                local height = math.abs(bottomPos.Y - topPos.Y)
                local width = height / 2

                local rainbowColor = Rainbow(
                    RainbowHue + player.UserId % 100 / 100
                )

                data.Box.Size = Vector2.new(width, height)

                data.Box.Position = Vector2.new(
                    topPos.X - width / 2,
                    topPos.Y
                )

                data.Box.Color = rainbowColor
                data.Tracer.Color = Rainbow(
                    RainbowHue + 0.25
                )

                data.Tracer.From = Vector2.new(
                    Camera.ViewportSize.X / 2,
                    Camera.ViewportSize.Y
                )

                data.Tracer.To = Vector2.new(
                    topPos.X,
                    bottomPos.Y
                )

                data.Box.Visible = true
                data.Tracer.Visible = true
            else
                Hide(data)
            end
        else
            Hide(data)
        end
    end
end)

print("[XR] RAINBOW LUXURY ESP LOADED 🌈")
