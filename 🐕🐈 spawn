local function shakeScreen(
	power,
	duration
)

	local camera =
		Workspace.CurrentCamera

	if not camera then
		return
	end

	local startCFrame =
		camera.CFrame

	local startTime =
		os.clock()

	while os.clock() - startTime
		< duration do

		camera.CFrame =
			startCFrame *
			CFrame.new(
				math.random(
					-power,
					power
				)/10,

				math.random(
					-power,
					power
				)/10,

				0
			)

		task.wait(0.025)
	end

	camera.CFrame =
		startCFrame
end

