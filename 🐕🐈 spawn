--==================================================
-- SHAKE
--==================================================

local function shake(frame,power,duration)

	local original = frame.Position
	local start = os.clock()

	while os.clock() - start < duration do

		frame.Position =
			original +
			UDim2.fromOffset(
				math.random(-power,power),
				math.random(-power,power)
			)

		task.wait(0.025)
	end

	frame.Position = original
end

