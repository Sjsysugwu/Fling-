--==================================================
-- SPAWN RARITIES
--==================================================

for _,rarity in ipairs(RARITIES) do

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1,0,0,40)
	button.BackgroundColor3 = NORMAL
	button.Text = rarity
	button.TextColor3 = Color3.new(1,1,1)
