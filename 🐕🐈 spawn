--------------------------------------------------
-- UPDATE LOOP
--------------------------------------------------

local scanTimer = 0
local distanceTimer = 0
local rainbowTimer = 0

RunService.Heartbeat:Connect(function(deltaTime)

	if not enabledESP then
		return
	end

	scanTimer += deltaTime
	distanceTimer += deltaTime
	rainbowTimer += deltaTime

	if scanTimer >= 0.5 then

		scanTimer = 0
		scanAnimals()
		updateTags()
	end

	if distanceTimer >= 0.1 then

		distanceTimer = 0
		updateDistance()
	end

	if rainbowTimer >= 0.03 then

		rainbowTimer = 0
		updateKittyGodColor()
	end
end)
