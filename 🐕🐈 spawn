--==================================================
-- ANIMAL HELPERS
--==================================================

local cachedAnimals = {}
local tags = {}
local highlights = {}

local function cleanText(text)
	return string.lower(
		string.gsub(text or "","^%s*(.-)%s*$","%1")
	)
end

local function getPosition(model)
	if not model or not model.Parent then
		return nil
	end

	if model:IsA("Model") then
		local ok,pivot = pcall(function()
			return model:GetPivot()
		end)

		if ok and pivot then
			return pivot.Position
		end
	end

	local part = model:FindFirstChildWhichIsA("BasePart",true)

	if part then
		return part.Position
	end

	return nil
end

local function getAnimalFromBoard(board)
	local current = board.Parent

	while current and current ~= Workspace do
		if current:IsA("Model")
			and not current:FindFirstChildOfClass("Humanoid") then

			if getPosition(current) then
				return current
			end
		end

		current = current.Parent
	end

	return nil
end

local function hasRarity(board,rarity)
	for _,obj in ipairs(board:GetDescendants()) do
		if obj:IsA("TextLabel")
			or obj:IsA("TextButton") then

			if cleanText(obj.Text) == cleanText(rarity) then
				return true
			end
		end
	end

	return false
end

local function getAnimalName(animal,board)
	for _,obj in ipairs(board:GetDescendants()) do
		if obj:IsA("TextLabel")
			or obj:IsA("TextButton") then

			if obj.Text ~= "" then
				local isRarity = false

				for _,rarity in ipairs(RARITIES) do
					if cleanText(obj.Text) == cleanText(rarity) then
						isRarity = true
						break
					end
				end

				if not isRarity then
					return obj.Text
				end
			end
		end
	end

	return animal.Name
end

--==================================================
-- SCAN
--==================================================

local function scanAnimals()
	local found = {}
	local seen = {}

	for _,board in ipairs(Workspace:GetDescendants()) do
		if board:IsA("BillboardGui") then

			for _,rarity in ipairs(RARITIES) do
				if hasRarity(board,rarity) then

					local animal = getAnimalFromBoard(board)

					if animal and not seen[animal] then
						seen[animal] = true

						found[animal] = {
							Model = animal,
							Name = getAnimalName(animal,board),
							Rarity = rarity
						}
					end

					break
				end
			end
		end
	end

	cachedAnimals = found
end

--==================================================
-- ESP
--==================================================

local function clearESP()
	for _,v in pairs(tags) do
		if v then v:Destroy() end
	end

	for _,v in pairs(highlights) do
		if v then v:Destroy() end
	end

	table.clear(tags)
	table.clear(highlights)
end

local function getRainbow()
	return Color3.fromHSV(
		(os.clock()*0.25)%1,
		1,
		1
	)
end

local function createESP(data)

	local color =
		RARITY_COLORS[data.Rarity]
		or Color3.new(1,1,1)

	local tag = Instance.new("BillboardGui")
	tag.Name = "AnimalFinderTag"
	tag.Size = UDim2.fromOffset(230,55)
	tag.StudsOffset = Vector3.new(0,5,0)
	tag.AlwaysOnTop = true
	tag.MaxDistance = ESP_MAX_DISTANCE
	tag.Parent = data.Model

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1,1)
	label.BackgroundTransparency = 1
	label.TextColor3 = color
	label.TextStrokeColor3 = Color3.new(1,1,1)
	label.TextStrokeTransparency = 0
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = tag

	tags[data.Model] = tag

	local highlight = Instance.new("Highlight")
	highlight.Name = "AnimalESPHighlight"
	highlight.Adornee = data.Model
	highlight.FillColor = color
	highlight.OutlineColor = color
	highlight.FillTransparency = 0.75
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = data.Model

	highlights[data.Model] = highlight
end

local function getESPDistance()
	local value = tonumber(distanceBox.Text)

	if not value or value <= 0 then
		return ESP_MAX_DISTANCE
	end

	return math.min(value,ESP_MAX_DISTANCE)
end

local function updateESP()

	if not enabledESP then
		clearESP()
		return
	end

	local character = player.Character
	local root =
		character and
		character:FindFirstChild("HumanoidRootPart")

	if not root then return end

	local maxDistance = getESPDistance()

	for model,tag in pairs(tags) do

		local data = cachedAnimals[model]

		if not model.Parent
			or not data
			or not rarityEnabled[data.Rarity] then

			tag:Destroy()
			tags[model] = nil

			if highlights[model] then
				highlights[model]:Destroy()
				highlights[model] = nil
			end
		end
	end

	for model,data in pairs(cachedAnimals) do

		if model.Parent and rarityEnabled[data.Rarity] then

			local position = getPosition(model)

			if position then

				local distance =
					(root.Position-position).Magnitude

				if distance <= maxDistance then

					if not tags[model] then
						createESP(data)
					end

					local label =
						tags[model]:FindFirstChildOfClass("TextLabel")

					if label then
						label.Text =
							data.Name
							.. "\n⭐ "
							.. data.Rarity
							.. " | "
							.. math.floor(distance)
							.. " Stud"
					end

				else

					if tags[model] then
						tags[model]:Destroy()
						tags[model] = nil
					end

					if highlights[model] then
						highlights[model]:Destroy()
						highlights[model] = nil
					end
				end
			end
		end
	end
end

