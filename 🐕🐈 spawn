		if not enabledSpawn then
			return
		end

		local character = player.Character
		local root =
			character and
			character:FindFirstChild("HumanoidRootPart")

		if not root then
			return
		end

		local maxDistance =
			tonumber(spawnDistance.Text) or 240

		scanAnimals()

		local closest = nil
		local closestDistance = maxDistance

		for model,data in pairs(cachedAnimals) do

			if data.Rarity == rarity
				and model.Parent then

				local position = getPosition(model)

				if position then

					local distance =
						(root.Position-position).Magnitude

					if distance <= closestDistance then
						closestDistance = distance
						closest = model
					end
				end
			end
		end

		if closest then

			local position = getPosition(closest)

			if position then
				root.CFrame =
					CFrame.new(
						position + Vector3.new(0,3,0)
					)
			end
		end
	end)
end

