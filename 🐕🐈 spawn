--==================================================
-- BACKGROUND MUSIC MUTE
--==================================================

local backgroundMuted = true
local savedVolumes = {}

local function findBackgroundMusic()
	return SoundService:FindFirstChild("BackgroundMusic")
end

local function muteBackgroundMusic()

	local backgroundMusic = findBackgroundMusic()

	if not backgroundMusic then
		return
	end

	for _,object in ipairs(backgroundMusic:GetDescendants()) do

		if object:IsA("Sound") then

			if savedVolumes[object] == nil then
				savedVolumes[object] = object.Volume
			end

			object.Volume = 0
		end
	end
end

local function unmuteBackgroundMusic()

	for sound,volume in pairs(savedVolumes) do

		if sound and sound.Parent then
			sound.Volume = volume
		end
	end
end

