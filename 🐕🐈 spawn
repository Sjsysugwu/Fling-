local originalHoldDurations = {}

local function setPromptsInstant()

	for _,v in ipairs(Workspace:GetDescendants()) do

		if v:IsA("ProximityPrompt") then

			if originalHoldDurations[v] == nil then
				originalHoldDurations[v] = v.HoldDuration
			end

			v.HoldDuration = 0
		end
	end
end

local function restorePrompts()

	for prompt,duration in pairs(originalHoldDurations) do

		if prompt and prompt.Parent then
			prompt.HoldDuration = duration
		end
	end

	table.clear(originalHoldDurations)
end

Workspace.DescendantAdded:Connect(function(v)

	if enabledPrompt
		and v:IsA("ProximityPrompt") then

		originalHoldDurations[v] = v.HoldDuration
		v.HoldDuration = 0
	end
end)

promptButton.MouseButton1Click:Connect(function()

	enabledPrompt = not enabledPrompt

	if enabledPrompt then

		promptButton.Text = "ProximityPrompt ON"
		promptButton.BackgroundColor3 = GREEN

		setPromptsInstant()

	else

		promptButton.Text = "ProximityPrompt OFF"
		promptButton.BackgroundColor3 = NORMAL

		restorePrompts()
	end
end)

