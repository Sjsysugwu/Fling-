--------------------------------------------------
-- Helpers
--------------------------------------------------

local function cleanText(text)
	return string.lower(
		string.gsub(text or "","^%s*(.-)%s*$","%1")
	)
end

local function getPosition(model)

	if model:IsA("Model") then
		return model:GetPivot().Position
	end

	local part = model:FindFirstChildWhichIsA("BasePart",true)

	if part then
		return part.Position
	end

	return nil
end

local function getAnimalFromBoard(board)

	local current = board.Parent

	while current and current ~= Workspace do

		if current:IsA("Model")
			and not current:FindFirstChildOfClass("Humanoid") then

			if getPosition(current) then
				return current
			end
		end

		current = current.Parent
	end

	return nil
end

local function boardHasRarity(board,rarity)

	for _,obj in ipairs(board:GetDescendants()) do

		if obj:IsA("TextLabel") or obj:IsA("TextButton") then

			if cleanText(obj.Text) == cleanText(rarity) then
				return true
			end
		end
	end

	return false
end

local function getAnimalName(animal,board)

	for _,obj in ipairs(board:GetDescendants()) do

		if obj:IsA("TextLabel") or obj:IsA("TextButton") then

			local text = obj.Text

			if text ~= "" then

				local isRarity = false

				for _,rarity in ipairs(RARITIES) do

					if cleanText(text) == cleanText(rarity) then
						isRarity = true
						break
					end

				end

				if not isRarity then
					return text
				end
			end
		end
	end

	return animal.Name
end

--------------------------------------------------
-- البحث عن الحيوانات
--------------------------------------------------

local function findAnimals(rarity)

	local found = {}
	local seen = {}

	for _,board in ipairs(Workspace:GetDescendants()) do

		if board:IsA("BillboardGui")
			and boardHasRarity(board,rarity) then

			local animal = getAnimalFromBoard(board)

			if animal and not seen[animal] then

				seen[animal] = true

				table.insert(found,{
					Model = animal,
					Name = getAnimalName(animal,board)
				})
			end
		end
	end

	return found
end

--------------------------------------------------
-- أسماء فوق الحيوانات
--------------------------------------------------

local tags = {}

local function clearTags()

	for _,tag in pairs(tags) do

		if tag then
			tag:Destroy()
		end
	end

	table.clear(tags)
end

local function showNames(rarity)

	clearTags()

	local animals = findAnimals(rarity)

	for _,data in ipairs(animals) do

		local tag = Instance.new("BillboardGui")
		tag.Name = "AnimalFinderTag"
		tag.Size = UDim2.fromOffset(260,60)
		tag.StudsOffset = Vector3.new(0,5,0)
		tag.AlwaysOnTop = true
		tag.MaxDistance = 2000
		tag.Parent = data.Model

		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1,1)
		label.BackgroundTransparency = 1
		label.Text = data.Name
		label.TextColor3 = Color3.new(1,1,1)
		label.TextStrokeColor3 = Color3.new(0,0,0)
		label.TextStrokeTransparency = 0
		label.TextScaled = true
		label.Font = Enum.Font.GothamBold
		label.Parent = tag

		tags[data.Model] = tag
	end
end

--------------------------------------------------
-- الانتقال للحيوان
--------------------------------------------------

local function teleportTo(rarity)

	local animals = findAnimals(rarity)

	if #animals == 0 then
		return
	end

	local position = getPosition(animals[1].Model)

	if not position then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if root then
		root.CFrame = CFrame.new(position + Vector3.new(0,3,0))
	end
end

