--==================================================
-- UPDATE LOOP
--==================================================

local scanTimer = 0
local espTimer = 0
local rainbowTimer = 0

RunService.Heartbeat:Connect(function(dt)

	if not UNLOCKED then
		return
	end

	if not enabledESP then
		return
	end

	scanTimer += dt
	espTimer += dt
	rainbowTimer += dt

	if scanTimer >= 0.5 then
		scanTimer = 0
		scanAnimals()
	end

	if espTimer >= 0.1 then
		espTimer = 0
		updateESP()
	end

	if rainbowTimer >= 0.03 then

		rainbowTimer = 0

		for model,data in pairs(cachedAnimals) do

			if data.Rarity == "Kitty God"
				and rarityEnabled["Kitty God"]
				and tags[model] then

				local color = getRainbow()

				local label =
					tags[model]:FindFirstChildOfClass("TextLabel")

				local highlight =
					highlights[model]

				if label then
					label.TextColor3 = color
				end

				if highlight then
					highlight.FillColor = color
					highlight.OutlineColor = color
				end
