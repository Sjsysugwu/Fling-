for _,rarity in ipairs(RARITIES) do

	local button = Instance.new("TextButton")

	button.Size = UDim2.new(1,0,0,40)
	button.BackgroundColor3 = NORMAL
	button.Text = rarity
	button.TextColor3 = Color3.new(1,1,1)
	button.TextSize = 15
	button.Font = Enum.Font.GothamBold
	button.BorderSizePixel = 0
	button.Parent = spawnList

	Instance.new("UICorner",button).CornerRadius =
		UDim.new(0,7)

	button.MouseButton1Click:Connect(function()

		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")

		if not root then
			return
		end

		local maxDistance =
			tonumber(spawnDistanceInput.Text)

		if not maxDistance or maxDistance <= 0 then
			spawnDistanceInput.Text = "240"
			maxDistance = 240
		end

		scanAnimals()

		local closestModel = nil
		local closestDistance = maxDistance

		for model,data in pairs(cachedAnimals) do

			if data.Rarity == rarity
				and model.Parent then

				local position = getPosition(model)

				if position then

					local distance =
						(root.Position-position).Magnitude

					if distance <= closestDistance then

						closestDistance = distance
						closestModel = model
					end
				end
			end
		end

		if closestModel then

			local position =
				getPosition(closestModel)

			if position then

				root.CFrame =
					CFrame.new(
						position+Vector3.new(0,3,0)
					)
			end
		end
	end)
end

