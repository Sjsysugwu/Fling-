--==================================================
-- SPAWN / TELEPORT
--==================================================

local function getSpawnDistance()

	local value = tonumber(spawnDistance.Text)

	if not value or value <= 0 then
		return 240
	end

	return value

end

local function teleportToAnimal(rarity)

	if not spawnOpen then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	scanAnimals()

	local maxDistance = getSpawnDistance()

	local closestPosition = nil
	local closestDistance = math.huge

	for model,data in pairs(cachedAnimals) do

		if model
			and model.Parent
			and data
			and data.Rarity == rarity then

			local position = getPosition(model)

			if position then

				local distance =
					(root.Position-position).Magnitude

				if distance <= maxDistance
					and distance < closestDistance then

					closestDistance = distance
					closestPosition = position

				end
			end
		end
	end

	if closestPosition then

		local humanoid =
			character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			humanoid:ChangeState(
				Enum.HumanoidStateType.Physics
			)
		end

		root.CFrame =
			CFrame.new(
				closestPosition + Vector3.new(0,4,0)
			)

		task.delay(0.15,function()

			if humanoid and humanoid.Parent then

				humanoid:ChangeState(
					Enum.HumanoidStateType.GettingUp
				)

			end

		end)
