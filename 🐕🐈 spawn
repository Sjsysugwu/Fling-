local function createBloodDrip(letterLabel)

	local drip = Instance.new("Frame")
	drip.Name = "LetterBlood"
	drip.AnchorPoint = Vector2.new(0.5,0)

	drip.Position =
		UDim2.new(0.5,0,1,-2)

	drip.Size = UDim2.fromOffset(7,0)
	drip.BackgroundColor3 = Color3.fromRGB(130,0,0)
	drip.BackgroundTransparency = 0.15
	drip.BorderSizePixel = 0
	drip.ZIndex = 38
	drip.Parent = letterLabel

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1,0)
	corner.Parent = drip

	local drop = Instance.new("Frame")
	drop.Name = "BloodDrop"
	drop.AnchorPoint = Vector2.new(0.5,0.5)

	drop.Position =
		UDim2.new(
			0.5,
			math.random(-8,8),
			1,
			0
		)

	drop.Size = UDim2.fromOffset(9,9)
	drop.BackgroundColor3 = Color3.fromRGB(150,0,0)
	drop.BackgroundTransparency = 0.1
	drop.BorderSizePixel = 0
	drop.ZIndex = 39
	drop.Parent = letterLabel

	local dropCorner = Instance.new("UICorner")
	dropCorner.CornerRadius = UDim.new(1,0)
	dropCorner.Parent = drop

	TweenService:Create(
		drip,
		TweenInfo.new(
			0.35,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.fromOffset(
				math.random(5,9),
				math.random(18,35)
			)
		}
	):Play()

	TweenService:Create(
		drop,
		TweenInfo.new(
			0.45,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In
		),
		{
			Position =
				UDim2.new(
					0.5,
					math.random(-8,8),
					1,
					math.random(25,45)
				)
		}
	):Play()

	task.delay(0.45,function()

		if drip.Parent then

			TweenService:Create(
				drip,
				TweenInfo.new(0.35),
				{
					BackgroundTransparency = 1
				}
			):Play()
		end

		if drop.Parent then

			TweenService:Create(
				drop,
				TweenInfo.new(0.35),
				{
					BackgroundTransparency = 1
				}
			):Play()
		end

		task.wait(0.4)

		if drip then
			drip:Destroy()
		end

		if drop then
			drop:Destroy()
		end
	end)
end

