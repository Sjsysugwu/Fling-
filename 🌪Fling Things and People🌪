local function attachHeartToProp(part)

	if heartProps[part] then
		return
	end

	if not isValidProp(part) then
		return
	end

	-- إذا التورنادو ماسكه، لا يدخل القلب
	if activeProps[part] then
		return
	end

	pcall(function()
		part:SetNetworkOwner(LocalPlayer)
	end)

	local att =
		Instance.new("Attachment")

	att.Name =
		"HeartGrabbedAtt"

	att.Parent = part

	local ao =
		Instance.new("AlignOrientation")

	ao.Mode =
		Enum.OrientationAlignmentMode.OneAttachment

	ao.Attachment0 = att
	ao.MaxTorque = math.huge
	ao.Responsiveness = 100

	-- نحفظ اتجاه البلوك الأصلي
	local fixedOrientation =
		part.CFrame - part.Position

	ao.CFrame =
		fixedOrientation

	ao.Parent = part

	local ap =
		Instance.new("AlignPosition")

	ap.Mode =
		Enum.PositionAlignmentMode.OneAttachment

	ap.Attachment0 = att
	ap.MaxForce = math.huge
	ap.MaxVelocity = 2000
	ap.Responsiveness = 150

	ap.Parent = part

	heartItemCount += 1

	heartProps[part] = {

		Part = part,
		Att = att,
		AO = ao,
		AP = ap,

		HeartIndex = heartItemCount,

		FixedOrientation = fixedOrientation

	}

end

