-- =====================================================  
-- MAIN MOVEMENT  
-- =====================================================  

RunService.Stepped:Connect(function(_,deltaTime)  

	if isRandomMapActive then  

		randomTimer+=deltaTime  

		if randomTimer>=RANDOM_MAP_INTERVAL then  
			randomTimer=0  
			chooseRandomMapPosition()  
		end  
	end  

	if not isMovementActive() then  

		for part,data in pairs(activeProps) do  

			if part and part:IsDescendantOf(Workspace) then  

				if data.AP then data.AP.Enabled=false end  
				if data.AO then data.AO.Enabled=false end  

				pcall(function()  
					part.Anchored=false  
				end)  
			end  
		end  

		return  
	end  

	for part,data in pairs(activeProps) do  

		if part and part:IsDescendantOf(Workspace) then  

			pcall(function()  
				part.Anchored=false  
			end)  

			if data.AP then data.AP.Enabled=true end  
			if data.AO then data.AO.Enabled=true end  
		end  
	end  

	if isCompressing then return end  

	local t=os.clock()  

	-- ===================================================  
	-- TORNADO  
	-- ===================================================  

	if isActive then  

		local targetPos=getTargetPosition()  

		for part,data in pairs(activeProps) do  

			if part  
				and part:IsDescendantOf(Workspace)  
				and data.AP then  

				local section=data.Section or 1  
				local slot=data.SubSlot or 0  
				local offset=data.AngleOffset or 0  

				local height  

				if section==1 then  
					height=10  
				elseif section==2 then  
					height=35  
				else  
					height=60  
				end  

				local radius  

				if section==1 then  
					radius=18  
				elseif section==2 then  
					radius=13  
				else  
					radius=8  
				end  

				local angle=t*(3.5+section*.7)+offset+slot*.45  
				local yWave=math.sin(t*3+slot)*4  

				local pos=  
					targetPos+  
					Vector3.new(  
						math.cos(angle)*radius,  
						height+yWave,  
						math.sin(angle)*radius  
					)  

				data.AP.Position=pos  

				data.AO.CFrame=  
					CFrame.lookAt(  
						part.Position,  
						targetPos+Vector3.new(0,height,0)  
					)  
			end  
		end  

	-- ===================================================  
	-- RANDOM MAP  
	-- ===================================================  

	elseif isRandomMapActive then  

		local targetPos=randomTargetPos  

		for part,data in pairs(activeProps) do  

			if part  
				and part:IsDescendantOf(Workspace)  
				and data.AP then  

				local section=data.Section or 1  
				local slot=data.SubSlot or 0  
				local offset=data.AngleOffset or 0  

				local radius  

				if section==1 then  
					radius=18  
				elseif section==2 then  
					radius=13  
				else  
					radius=8  
				end  

				local height  

				if section==1 then  
					height=-25  
				elseif section==2 then  
					height=0  
				else  
					height=25  
				end  

				local angle=  
					t*RANDOM_ROTATION_SPEED+  
					offset+  
					slot*.45  

				local pos=  
					targetPos+  
					Vector3.new(  
						math.cos(angle)*radius,  
						height,  
						math.sin(angle)*radius  
					)  

				data.AP.Position=pos  
				data.AO.CFrame=CFrame.Angles(0,angle,0)  
			end  
		end  

	-- ===================================================  
	-- ME  
	-- ===================================================  

	elseif isMeActive then  

		local character=LocalPlayer.Character  

		local targetRoot=  
			character and  
			character:FindFirstChild("HumanoidRootPart")  

		if targetRoot then  

			local center=targetRoot.Position  

			for part,data in pairs(activeProps) do  

				if part  
					and part:IsDescendantOf(Workspace)  
					and data.AP then  

					local section=data.Section or 1  
					local slot=data.SubSlot or 0  
					local radius=10+section*5  

					local angle=  
						t*2+  
						slot*.8+  
						(data.AngleOffset or 0)  

					local height=8+section*8  

					local pos=  
						center+  
						Vector3.new(  
							math.cos(angle)*radius,  
							height+math.sin(t*2+slot)*2,  
							math.sin(angle)*radius  
						)  

					data.AP.Position=pos  
					data.AO.CFrame=CFrame.lookAt(part.Position,center)  
				end  
			end  
		end  

	-- ===================================================  
	-- HEAD SPIRAL  
	-- ===================================================  

	elseif isHeadStarActive then  

		local root=getTargetRoot()  

		if root then  

			local center=root.Position  
			local selected={}  

			for part,data in pairs(activeProps) do  

				if part  
					and part:IsDescendantOf(Workspace)  
					and data.AP  
					and data.OrderIndex then  

					table.insert(selected,{  
						Part=part,  
						Data=data  
					})  
				end  
			end  

			table.sort(selected,function(a,b)  
				return a.Data.OrderIndex<b.Data.OrderIndex  
			end)  

			local amount=math.min(#selected,HEAD_STAR_MAX)  

			for i=1,amount do  

				local item=selected[i]  
				local part=item.Part  
				local data=item.Data  

				local seed=data.OrderIndex*13.713  
				local step=i-1  

				local spiralAngle=  
					step*SPIRAL_TURN+  
					t*SPIRAL_SPEED  

				local baseRadius=  
					SPIRAL_START_RADIUS+  
					step*SPIRAL_SPACING  

				local personalDistance=  
					math.sin(seed*2.31)*  
					SPIRAL_RANDOM_DISTANCE  

				local radius=  
					baseRadius+  
					personalDistance+  
					math.sin(t*2+seed)*SPIRAL_RADIUS_WAVE  

				local personalAngle=  
					math.sin(seed)*SPIRAL_RANDOM_ANGLE  

				local finalAngle=spiralAngle+personalAngle  
				local verticalStep=math.sin(step*.12)*2  
				local wave=math.sin(t*2.5+seed)*SPIRAL_WAVE  
				local side=math.cos(t*3+seed)*1.5  

				local pos=  
					center+  
					Vector3.new(  
						math.cos(finalAngle)*radius+side,  
						HEAD_STAR_HEIGHT+verticalStep+wave,  
						math.sin(finalAngle)*radius+side  
					)  

				data.AP.Position=pos  

				data.AO.CFrame=  
					CFrame.Angles(  
						t*PART_ROTATION_SPEED+seed,  
						t*PART_ROTATION_SPEED*1.35+seed,  
						t*PART_ROTATION_SPEED*.75+seed  
					)  
			end  
		end  

	-- ===================================================  
	-- DNA  
	-- ===================================================  

	elseif isDNAActive then  

		local root=getTargetRoot()  

		if root then  

			local center=  
				root.Position+  
				Vector3.new(0,DNA_HEIGHT,0)  

			for part,data in pairs(activeProps) do  

				if part  
					and part:IsDescendantOf(Workspace)  
					and data.AP then  

					local i=data.OrderIndex  

					local pairIndex=  
						math.floor((i-1)/2)  

					local side=  
						((i-1)%2==0) and -1 or 1  

					local height=  
						(pairIndex%12)*DNA_STEP_HEIGHT  

					local angle=  
						pairIndex*.55+  
						t*DNA_TURN_SPEED  

					local radius=DNA_RADIUS  

					local x=  
						math.cos(angle)*  
						radius*  
						side  

					local z=  
						math.sin(angle)*  
						radius*  
						side  

					local wave=  
						math.sin(t*3+pairIndex)*  
						DNA_WAVE  

					local pos=  
						center+  
						Vector3.new(  
							x,  
							height+wave,  
							z  
						)  

					data.AP.Position=pos  

					data.AO.CFrame=  
						CFrame.Angles(  
							0,  
							angle,  
							t*2+data.OrderIndex  
						)  
				end  
			end  
		end  
	end  
end)  

