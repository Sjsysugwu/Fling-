-- =========================================================
-- TARGET ROOT
-- =========================================================

local function getTargetRoot()

	if isRandomMapActive
		or selectedTargetMode == "Random Map" then

		return nil

	end

	local player =
		targetPlayer or LocalPlayer

	if player
		and player.Character then

		return player.Character:FindFirstChild(
			"HumanoidRootPart"
		)

	end

	return nil

end

-- =========================================================
-- RANDOM MAP POSITION
-- =========================================================

local function chooseRandomMapPosition()

	local candidates = {}

	for _, obj in ipairs(
		Workspace:GetDescendants()
	) do

		if obj:IsA("BasePart")
			and obj:IsDescendantOf(Workspace)
			and obj.Size.X >= 4
			and obj.Size.Z >= 4
			and obj.Transparency < 1
			and obj.CanCollide then

			local model =
				obj:FindFirstAncestorOfClass(
					"Model"
				)

			local isCharacterPart =
				model
				and model:FindFirstChildOfClass(
					"Humanoid"
				)

			if not isCharacterPart
				and obj.Name ~= "Baseplate"
				and obj.Name ~= "HumanoidRootPart" then

				table.insert(
					candidates,
					obj
				)

			end

		end

	end

	if #candidates > 0 then

		local chosen =
			candidates[
				math.random(
					1,
					#candidates
				)
			]

		randomTargetPos =
			chosen.Position
			+ Vector3.new(
				0,
				RANDOM_MAP_HEIGHT,
				0
			)

	else

		randomTargetPos =
			Vector3.new(
				math.random(-300, 300),
				RANDOM_MAP_HEIGHT,
				math.random(-300, 300)
			)

	end

end

local function getTargetPosition()

	if isRandomMapActive
		or selectedTargetMode == "Random Map" then

		return randomTargetPos

	end

	local root =
		getTargetRoot()

	if root then
		return root.Position
	end

	return Vector3.zero

end

