local function startTornado()

	local root =
		getTargetRoot()

	if not root then
		return
	end

	isActive = true
	globalItemCount = 0

	btn.Text = "🌪 ON 🌪"

end

local function toggleTornado()

	if isActive then
		stopTornado()
	else
		startTornado()
	end

end

