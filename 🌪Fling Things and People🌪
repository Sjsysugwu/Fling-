UserInputService.InputBegan:Connect(
	function(input, processed)

		if processed then
			return
		end

		if input.KeyCode ==
			Enum.KeyCode.R then

			toggleTornado()

		elseif input.KeyCode ==
			Enum.KeyCode.O then

			toggleOrbit()

		elseif input.KeyCode ==
			Enum.KeyCode.T then

			triggerCompressAndBlast()

		elseif input.KeyCode ==
			Enum.KeyCode.M then

			MinButton:Activate()

		elseif input.KeyCode ==
			Enum.KeyCode.F then

			toggleMe()

		end

	end
)

-- =========================================================
-- MOVEMENT LOOP
-- =========================================================

RunService.Stepped:Connect(
	function(_, deltaTime)

		-- =================================================
		-- RANDOM MAP TIMER
		-- =================================================

		if isRandomMapActive then

			randomTimer +=
				deltaTime

			if randomTimer >=
				RANDOM_MAP_INTERVAL then

				randomTimer = 0

				chooseRandomMapPosition()

			end

		end

		-- =================================================
		-- HARD OFF FREEZE
		-- =================================================
		-- لا يوجد أي وضع شغال؟
		-- إذن:
		-- 1. AlignPosition OFF
		-- 2. AlignOrientation OFF
		-- 3. السرعة = صفر
		-- 4. القطعة Anchored
		-- 5. لا يتم استعمال getTargetPosition
		-- 6. لا يتم إرسال القطعة للنص أو للنص الأوسط
		-- =================================================

		if not isMovementActive() then

			for part, data in pairs(
				activeProps
			) do

				if part
					and part:IsDescendantOf(Workspace) then

					if data.AP then

						data.AP.Position =
							part.Position

						data.AP.Enabled =
							false

					end

					if data.AO then

						data.AO.CFrame =
							part.CFrame

						data.AO.Enabled =
							false

					end

					pcall(function()

						part.AssemblyLinearVelocity =
							Vector3.zero

						part.AssemblyAngularVelocity =
							Vector3.zero

						part.Anchored =
							true

					end)

				end

			end

			return

		end

		-- =================================================
		-- ENABLE ACTIVE CONSTRAINTS
		-- =================================================

		for part, data in pairs(
			activeProps
		) do

			if part
				and part:IsDescendantOf(Workspace) then

				-- =================================================
				-- مهم:
				-- عند تشغيل الوضع، لا نخلي AP يستخدم
				-- مكان قديم كان بالنص.
				-- =================================================

				if data.AP
					and not data.AP.Enabled then

					data.AP.Position =
						part.Position

				end

				if data.AO
					and not data.AO.Enabled then

					data.AO.CFrame =
						part.CFrame

				end

				if data.AP then
					data.AP.Enabled = true
				end

				if data.AO then
					data.AO.Enabled = true
				end

				pcall(function()

					part.Anchored =
						false

				end)

			end

		end

		if isCompressing then
			return
		end

		-- =================================================
		-- TEXT SHAPE
		-- =================================================

		if isTextShapeActive then

			local targetPos =
				getTargetPosition()

			local total =
				math.max(
					#textPoints,
					1
				)

			local orderedParts = {}

			for part, data in pairs(
				activeProps
			) do

				if part
					and part:IsDescendantOf(Workspace)
					and data.AP then

					table.insert(
						orderedParts,
						{
							part = part,
							data = data
						}
					)

				end

			end

			table.sort(
				orderedParts,
				function(a, b)

					return
						(a.data.OrderIndex or 0)
						<
						(b.data.OrderIndex or 0)

				end
			)

			for index, entry in ipairs(
				orderedParts
			) do

				local pos =
					getTextShapePosition(
						index,
						total,
						targetPos
					)

				entry.data.AP.Position =
					pos

				entry.data.AO.CFrame =
					CFrame.new()

			end

		-- =================================================
		-- TORNADO
		-- =================================================

		elseif isActive then

			local targetPos =
				getTargetPosition()

			local t =
				os.clock()

			for part, data in pairs(
				activeProps
			) do

				if part
					and part:IsDescendantOf(Workspace)
					and data.AP then

					local section =
						data.Section or 1

					local slot =
						data.SubSlot or 0

					local offset =
						data.AngleOffset or 0

					local height

					if section == 1 then
						height = 10
					elseif section == 2 then
						height = 35
					else
						height = 60
					end

					local radius

					if section == 1 then
						radius = 18
					elseif section == 2 then
						radius = 13
					else
						radius = 8
					end

					local angle =
						t * (3.5 + section * 0.7)
						+ offset
						+ slot * 0.45

					local yWave =
						math.sin(
							t * 3 + slot
						) * 4

					local pos =
						targetPos
						+ Vector3.new(
							math.cos(angle)
								* radius,

							height
								+ yWave,

							math.sin(angle)
								* radius
						)

					data.AP.Position =
						pos

					data.AO.CFrame =
						CFrame.lookAt(
							part.Position,

							targetPos
								+ Vector3.new(
									0,
									height,
									0
								)
						)

				end

			end

		-- =================================================
		-- RANDOM MAP
		-- 999 STUD ABOVE MAP
		-- + CONTINUOUS ROTATION
		-- =================================================

		elseif isRandomMapActive then

			local targetPos =
				randomTargetPos

			local t =
				os.clock()

			for part, data in pairs(
				activeProps
			) do

				if part
					and part:IsDescendantOf(Workspace)
					and data.AP then

					local section =
						data.Section or 1

					local slot =
						data.SubSlot or 0

					local offset =
						data.AngleOffset or 0

					local radius

					if section == 1 then
						radius = 18
					elseif section == 2 then
						radius = 13
					else
						radius = 8
					end

					local height

					if section == 1 then
						height = -25
					elseif section == 2 then
						height = 0
					else
						height = 25
					end

					local angle =
						t * RANDOM_ROTATION_SPEED
						+ offset
						+ slot * 0.45

					local pos =
						targetPos
						+ Vector3.new(
							math.cos(angle)
								* radius,

							height,

							math.sin(angle)
								* radius
						)

					data.AP.Position =
						pos

					data.AO.CFrame =
						CFrame.Angles(
							0,
							angle,
							0
						)

				end

			end

		-- =================================================
		-- ME
		-- =================================================

		elseif isMeActive then

			local targetRoot =
				LocalPlayer.Character
				and LocalPlayer.Character:FindFirstChild(
					"HumanoidRootPart"
				)

			if targetRoot then

				local center =
					targetRoot.Position

				local t =
					os.clock()

				for part, data in pairs(
					activeProps
				) do

					if part
						and part:IsDescendantOf(Workspace)
						and data.AP then

						local section =
							data.Section or 1

						local slot =
							data.SubSlot or 0

						local radius =
							10 + section * 5

						local angle =
							t * 2
							+ slot * 0.8
							+ (
								data.AngleOffset
								or 0
							)

						local height =
							8 + section * 8

						local pos =
							center
							+ Vector3.new(
								math.cos(angle)
									* radius,

								height
									+ math.sin(
										t * 2 + slot
									) * 2,

								math.sin(angle)
									* radius
							)

						data.AP.Position =
							pos

						data.AO.CFrame =
							CFrame.lookAt(
								part.Position,
								center
							)

					end

				end

			end

		-- =================================================
		-- ORBIT
		-- =================================================

		elseif isOrbitActive then

			local t =
				os.clock()

			local targetPos =
				getTargetPosition()

			for part, data in pairs(
				activeProps
			) do

				if part
					and part:IsDescendantOf(Workspace)
					and data.AP then

					local section =
						data.Section or 1

					local slot =
						data.SubSlot or 0

					local radius =
						20 + section * 12

					local height =
						20 + section * 12

					local angle =
						t
						* (2 + section * 0.5)
						+ slot * 0.7
						+ (
							data.AngleOffset
							or 0
						)

					local pos =
						targetPos
						+ Vector3.new(
							math.cos(angle)
								* radius,

							height
								+ math.sin(
									t * 2 + slot
								) * 3,

							math.sin(angle)
								* radius
						)

					data.AP.Position =
						pos

					data.AO.CFrame =
						CFrame.Angles(
							0,
							angle,
							0
						)

				end

			end

		end

	end
)

