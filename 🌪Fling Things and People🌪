-- ثابت فوق رأس الـTARGET
--==================================================

local function getHeartPosition(index, total, rootPos)

	total = math.max(total, 1)

	if total == 1 then

		return rootPos +
			Vector3.new(
				0,
				105,
				0
			)

	end

	-- نقاط القلب موزعة على منحنى حقيقي
	local t =
		((index - 1) / total) *
		(math.pi * 2)

	-- معادلة القلب
	local x =
		16 *
		(math.sin(t) ^ 3)

	local y =
		13 * math.cos(t)
		- 5 * math.cos(2 * t)
		- 2 * math.cos(3 * t)
		- math.cos(4 * t)

	-- حجم القلب
	local scale = 4.2

	x *= scale
	y *= scale

	-- القلب فوق رأس اللاعب
	local height = 105

	return rootPos +
		Vector3.new(
			x,
			y + height,
			0
		)

end

--==================================================
-- COMPRESS + BLAST
--==================================================

local function triggerCompressAndBlast()

	if isCompressing then
		return
	end

	isCompressing = true

	local root =
		getTargetRoot()

	if not root then

		isCompressing = false
		return

	end

	local compressPoint =
		root.Position +
		Vector3.new(
			0,
			110,
			0
		)

	--==================================================
	-- TORNADO COMPRESS
	--==================================================

	if isActive then

		for part, data in pairs(activeProps) do

			if part
				and part:IsDescendantOf(workspace)
				and isWithinRange(part) then

				data.AP.Position =
					compressPoint

			end

		end

	end

	--==================================================
	-- HEART COMPRESS
	--==================================================

	if isHeartActive then

		for part, data in pairs(heartProps) do

			if part
				and part:IsDescendantOf(workspace)
				and isWithinRange(part) then

				data.AP.Position =
					compressPoint

			end

		end

	end

	task.wait(0.8)

	--==================================================
	-- EXPLOSION
	--==================================================

	local exp =
		Instance.new("Explosion")

	exp.Position = compressPoint
	exp.BlastRadius = 150
	exp.BlastPressure = 0
	exp.DestroyJointRadiusPercent = 0
	exp.Parent = workspace

	--==================================================
	-- COLLECT TORNADO PROPS
	--==================================================

	local propsToBlast = {}

	for part, _ in pairs(activeProps) do

		table.insert(
			propsToBlast,
			{
				Part = part,
				Type = "Tornado"
			}
		)

	end

	--==================================================
	-- COLLECT HEART PROPS
	--==================================================

	for part, _ in pairs(heartProps) do

		table.insert(
			propsToBlast,
			{
				Part = part,
				Type = "Heart"
			}
		)

	end

	--==================================================
	-- BLAST EVERYTHING
	--==================================================

	for _, info in ipairs(propsToBlast) do

		local part =
			info.Part

		if part
			and part:IsDescendantOf(workspace)
			and not part.Anchored then

			if info.Type == "Tornado" then
				removePropPhysics(part)
			else
				removeHeartPhysics(part)
			end

			explodedBlacklist[part] = true

			task.delay(
				2.5,
				function()

					explodedBlacklist[part] = nil

				end
			)

			pcall(function()
				part:SetNetworkOwner(LocalPlayer)
			end)

			local randomDirection =
				Vector3.new(
					math.random(-100, 100),
					math.random(50, 150),
					math.random(-100, 100)
				)

			if randomDirection.Magnitude < 0.1 then

				randomDirection =
					Vector3.new(
						0,
						1,
						0
					)

			end

			randomDirection =
				randomDirection.Unit

			local blastSpeed =
				math.random(
					1200,
					2500
				)

			part.AssemblyLinearVelocity =
				randomDirection *
				blastSpeed

			part.AssemblyAngularVelocity =
				Vector3.new(
					math.random(-200, 200),
					math.random(-200, 200),
					math.random(-200, 200)
				)

		end

	end

	--==================================================
	-- RESET COUNTS
	--==================================================

	globalItemCount = 0
	heartItemCount = 0

	activeProps = {}
	heartProps = {}

	isCompressing = false

end

