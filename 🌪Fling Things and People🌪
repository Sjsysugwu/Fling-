UserInputService.InputBegan:Connect(
	function(input, processed)

		if processed then
			return
		end

		if input.KeyCode ==
			Enum.KeyCode.R then

			toggleTornado()

		elseif input.KeyCode ==
			Enum.KeyCode.O then

			toggleOrbit()

		elseif input.KeyCode ==
			Enum.KeyCode.T then

			triggerCompressAndBlast()

		elseif input.KeyCode ==
			Enum.KeyCode.M then

			MinButton:Activate()

		elseif input.KeyCode ==
			Enum.KeyCode.F then

			toggleMe()

		end

	end
)

-- =========================================================
-- MOVEMENT LOOP
-- =========================================================

RunService.Stepped:Connect(
	function(_, deltaTime)

		if selectedTargetMode ==
			"Random Map" then

			randomTimer += deltaTime

			if randomTimer >= 4 then

				randomTimer = 0

				randomTargetPos =
					Vector3.new(
						math.random(-300, 300),
						300,
						math.random(-300, 300)
					)

			end

		end

		if isCompressing then
			return
		end

		-- =================================================
		-- TORNADO
		-- =================================================

		if isActive then

			local targetPos =
				getTargetPosition()

			local t =
				os.clock()

			for part, data in pairs(activeProps) do

				if part
					and part:IsDescendantOf(Workspace)
					and data.AP then

					local section =
						data.Section or 1

					local slot =
						data.SubSlot or 0

					local offset =
						data.AngleOffset or 0

					local height

					if section == 1 then
						height = 10
					elseif section == 2 then
						height = 35
					else
						height = 60
					end

					local radius

					if section == 1 then
						radius = 18
					elseif section == 2 then
						radius = 13
					else
						radius = 8
					end

					local angle =
						t * (3.5 + section * 0.7)
						+ offset
						+ slot * 0.45

					local yWave =
						math.sin(
							t * 3 + slot
						) * 4

					local pos =
						targetPos
						+ Vector3.new(
							math.cos(angle) * radius,
							height + yWave,
							math.sin(angle) * radius
						)

					data.AP.Position =
						pos

					data.AO.CFrame =
						CFrame.lookAt(
							part.Position,
							targetPos +
								Vector3.new(
									0,
									height,
									0
								)
						)

				end

			end

		-- =================================================
		-- ME
		-- =================================================

		elseif isMeActive then

			local targetPos =
				LocalPlayer.Character
				and LocalPlayer.Character:FindFirstChild(
					"HumanoidRootPart"
				)

			if targetPos then

				local center =
					targetPos.Position

				local t =
					os.clock()

				for part, data in pairs(activeProps) do

					if part
						and part:IsDescendantOf(Workspace)
						and data.AP then

						local section =
							data.Section or 1

						local slot =
							data.SubSlot or 0

						local radius =
							10 + section * 5

						local angle =
							t * 2
							+ slot * 0.8
							+ (data.AngleOffset or 0)

						local height =
							8 + section * 8

						local pos =
							center
							+ Vector3.new(
								math.cos(angle) * radius,
								height +
									math.sin(
										t * 2 + slot
									) * 2,
								math.sin(angle) * radius
							)

						data.AP.Position =
							pos

						data.AO.CFrame =
							CFrame.lookAt(
								part.Position,
								center
							)

					end

				end

			end

		-- =================================================
		-- ORBIT
		-- =================================================

		elseif isOrbitActive then

			local t =
				os.clock()

			local targetPos =
				getTargetPosition()

			for part, data in pairs(activeProps) do

				if part
					and part:IsDescendantOf(Workspace)
					and data.AP then

					local section =
						data.Section or 1

					local slot =
						data.SubSlot or 0

					local radius =
						20 + section * 12

					local height =
						20 + section * 12

					local angle =
						t *
						(2 + section * 0.5)
						+ slot * 0.7
						+ (
							data.AngleOffset or 0
						)

					local pos =
						targetPos
						+ Vector3.new(
							math.cos(angle) *
								radius,

							height +
								math.sin(
									t * 2 + slot
								) * 3,

							math.sin(angle) *
								radius
						)

					data.AP.Position =
						pos

					data.AO.CFrame =
						CFrame.Angles(
							0,
							angle,
							0
						)

				end

			end

		end

	end
)

