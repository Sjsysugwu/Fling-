local function isValidProp(part)

	if not part
		or not part:IsA("BasePart")
		or not part:IsDescendantOf(Workspace)
		or part.Anchored then

		return false

	end

	local model =
		part:FindFirstAncestorOfClass(
			"Model"
		)

	if model
		and model:FindFirstChildOfClass(
			"Humanoid"
		) then

		return false

	end

	return true

end

-- =========================================================
-- RANGE
-- =========================================================

local function isWithinRange(part)

	if not part
		or not part:IsDescendantOf(Workspace) then

		return false

	end

	return
		(
			part.Position
			- getTargetPosition()
		).Magnitude
		<= 1000

end

-- =========================================================
-- ATTACH PHYSICS
-- =========================================================

local function attachPhysicsToProp(part)

	if not isValidProp(part) then
		return
	end

	if activeProps[part] then
		return
	end

	pcall(function()

		if SetNetworkOwner then

			SetNetworkOwner:FireServer(
				part,
				true
			)

		end

	end)

	local attachment =
		Instance.new("Attachment")

	attachment.Name =
		"XR_TornadoAttachment"

	attachment.Parent =
		part

	local AO =
		Instance.new("AlignOrientation")

	AO.Name =
		"XR_TornadoOrientation"

	AO.Mode =
		Enum.OrientationAlignmentMode.OneAttachment

	AO.Attachment0 =
		attachment

	AO.MaxTorque =
		math.huge

	AO.MaxAngularVelocity =
		math.huge

	AO.Responsiveness =
		200

	AO.Enabled =
		false

	AO.Parent =
		part

	local AP =
		Instance.new("AlignPosition")

	AP.Name =
		"XR_TornadoPosition"

	AP.Mode =
		Enum.PositionAlignmentMode.OneAttachment

	AP.Attachment0 =
		attachment

	AP.MaxForce =
		math.huge

	AP.MaxVelocity =
		math.huge

	AP.Responsiveness =
		200

	AP.RigidityEnabled =
		false

	AP.Enabled =
		false

	AP.Parent =
		part

	globalItemCount += 1

	activeProps[part] = {

		AP = AP,
		AO = AO,
		Attachment = attachment,

		Section =
			((globalItemCount - 1) % 3) + 1,

		SubSlot =
			((globalItemCount - 1) % 10),

		AngleOffset =
			(globalItemCount * 0.75)
			% (math.pi * 2),

		OrderIndex =
			globalItemCount
	}

	-- =====================================================
	-- إذا كل شيء OFF:
	-- ثبت البلوك فوراً في مكانه الحالي.
	-- =====================================================

	if not isMovementActive() then

		local data =
			activeProps[part]

		data.AP.Position =
			part.Position

		data.AO.CFrame =
			part.CFrame

		data.AP.Enabled =
			false

		data.AO.Enabled =
			false

		pcall(function()

			part.AssemblyLinearVelocity =
				Vector3.zero

			part.AssemblyAngularVelocity =
				Vector3.zero

			part.Anchored =
				true

		end)

	else

		-- الوضع شغال:
		-- نبدأ من مكان البلوك الحالي
		-- حتى لا يقفز للنص.

		AP.Position =
			part.Position

		AO.CFrame =
			part.CFrame

		pcall(function()
			part.Anchored = false
		end)

		AP.Enabled = true
		AO.Enabled = true

	end

end

