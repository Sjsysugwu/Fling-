--==================================================
-- GET TARGET ROOT
--==================================================

local function getTargetRoot()

	if selectedTargetMode == "Me" then

		local char = LocalPlayer.Character

		if char then
			return char:FindFirstChild("HumanoidRootPart")
		end

	elseif selectedTargetMode == "Player" then

		if targetPlayer and targetPlayer.Parent then

			local char = targetPlayer.Character

			if char then
				return char:FindFirstChild("HumanoidRootPart")
			end

		end

	elseif selectedTargetMode == "Random" then

		if randomTargetPlayer
			and randomTargetPlayer.Parent then

			local char =
				randomTargetPlayer.Character

			if char then

				local root =
					char:FindFirstChild("HumanoidRootPart")

				if root then
					return root
				end

			end

		end

	end

	return nil

end

--==================================================
-- RANGE
--==================================================

local function isWithinRange(part)

	local root = getTargetRoot()

	if not root or not part then
		return false
	end

	local distance =
		(part.Position - root.Position).Magnitude

	return distance <= MAX_DISTANCE

end

