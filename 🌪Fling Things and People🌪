--==================================================
-- TORNADO MOVEMENT
--==================================================

RunService.Stepped:Connect(function()

	if not isActive
		or isCompressing then

		return
	end

	local root =
		getTargetRoot()

	if not root then
		return
	end

	local rootPos =
		root.Position

	local timeSeconds =
		workspace.DistributedGameTime

	for part, data in pairs(activeProps) do

		if not part
			or not part:IsDescendantOf(workspace)
			or part.Anchored then

			removePropPhysics(part)

		elseif not isWithinRange(part) then

			removePropPhysics(part)

		else

			local angle =
				(timeSeconds * 3.5)
				+ data.AngleOffset

			local baseHeight
			local sectionLength
			local startRadius
			local endRadius

			if data.Section == 1 then

				baseHeight = 10
				sectionLength = 50
				startRadius = 15
				endRadius = 35

			elseif data.Section == 2 then

				baseHeight = 60
				sectionLength = 75
				startRadius = 35
				endRadius = 75

			else

				baseHeight = 135
				sectionLength = 100
				startRadius = 75
				endRadius = 130

			end

			local slotProgress =
				(data.SubSlot + 0.5) / 10

			local height =
				baseHeight +
				(
					slotProgress *
					sectionLength
				)

			local radius =
				startRadius +
				(
					slotProgress *
					(
						endRadius -
						startRadius
					)
				)

			local targetPos =
				rootPos +
				Vector3.new(
					math.cos(angle) * radius,
					height,
					math.sin(angle) * radius
				)

			data.AP.Position =
				targetPos

			-- اتجاه ثابت
			data.AO.CFrame =
				data.AO.CFrame

		end

	end

end)

