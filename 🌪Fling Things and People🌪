-- =========================================================
-- BUILD TEXT POINTS
-- =========================================================

local function buildTextPoints(text)

	text = string.upper(text or "")

	if text == "" then
		text = "ALI"
	end

	local points = {}

	local cellSize = 6
	local letterSpacing = 3 * cellSize

	local letters = {}

	for i = 1, #text do

		local char =
			string.sub(text, i, i)

		if FONT[char] then

			table.insert(
				letters,
				{
					char = char,
					glyph = FONT[char]
				}
			)

		elseif char == " " then

			table.insert(
				letters,
				{
					char = " ",
					glyph = nil
				}
			)

		end

	end

	if #letters == 0 then
		return points
	end

	local totalWidth = 0

	for index, info in ipairs(letters) do

		if info.glyph then
			totalWidth += 5 * cellSize
		else
			totalWidth += 3 * cellSize
		end

		if index < #letters then
			totalWidth += letterSpacing
		end

	end

	local cursorX =
		-(totalWidth / 2)

	for _, info in ipairs(letters) do

		local glyph =
			info.glyph

		if glyph then

			for row = 1, 7 do

				local line =
					glyph[row]

				for col = 1, 5 do

					if string.sub(
						line,
						col,
						col
					) == "1" then

						table.insert(
							points,
							{
								position =
									Vector3.new(
										cursorX
										+ (col - 1)
										* cellSize,

										(7 - row)
										* cellSize,

										0
									),

								character =
									info.char
							}
						)

					end

				end

			end

			cursorX +=
				5 * cellSize
				+ letterSpacing

		else

			cursorX +=
				3 * cellSize
				+ letterSpacing

		end

	end

	return points

end

-- =========================================================
-- CURRENT TEXT POINTS
-- =========================================================

local textPoints =
