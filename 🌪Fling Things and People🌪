local function releaseAllProps()  
	for part,data in pairs(activeProps) do  
		if part and part:IsDescendantOf(Workspace) then  
			if data.AP then data.AP.Enabled=false end  
			if data.AO then data.AO.Enabled=false end  
			pcall(function() part.Anchored=false end)  
		end  
	end  
end  

local function enableAllProps()  
	for part,data in pairs(activeProps) do  
		if part and part:IsDescendantOf(Workspace) then  
			pcall(function() part.Anchored=false end)  
			if data.AP then  
				data.AP.Position=part.Position  
				data.AP.Enabled=true  
			end  
			if data.AO then  
				data.AO.CFrame=part.CFrame  
				data.AO.Enabled=true  
			end  
		end  
	end  
end  

local function syncPropState()  
	if isMovementActive() then  
		enableAllProps()  
	else  
		releaseAllProps()  
	end  
end  

-- =====================================================  
-- RANDOM MAP  
-- =====================================================  

local function chooseRandomMapPosition()  

	local candidates={}  

	for _,obj in ipairs(Workspace:GetDescendants()) do  

		if obj:IsA("BasePart")  
			and obj.Size.X>=4  
			and obj.Size.Z>=4  
			and obj.Transparency<1  
			and obj.CanCollide  
			and not obj.Anchored then  

			local model=obj:FindFirstAncestorOfClass("Model")  
			local humanoid=model and model:FindFirstChildOfClass("Humanoid")  

			if not humanoid  
				and obj.Name~="Baseplate"  
				and obj.Name~="HumanoidRootPart" then  

				table.insert(candidates,obj)  
			end  
		end  
	end  

	if #candidates>0 then  
		local chosen=candidates[math.random(1,#candidates)]  
		randomTargetPos=chosen.Position+Vector3.new(0,RANDOM_MAP_HEIGHT,0)  
	else  
		randomTargetPos=Vector3.new(  
			math.random(-300,300),  
			RANDOM_MAP_HEIGHT,  
			math.random(-300,300)  
		)  
	end  
end  

-- =====================================================  
-- TARGET  
-- =====================================================  

local function getTargetRoot()  

	if isRandomMapActive then return nil end  

	local player=targetPlayer or LocalPlayer  

	if player and player.Character then  
		return player.Character:FindFirstChild("HumanoidRootPart")  
	end  

	return nil  
end  

local function getTargetPosition()  

	if isRandomMapActive then  
		return randomTargetPos  
	end  

	local root=getTargetRoot()  

	if root then return root.Position end  

	return Vector3.zero  
end  

-- =====================================================  
-- PROP  
-- =====================================================  

local function isValidProp(part)  

	if not part  
		or not part:IsA("BasePart")  
		or not part:IsDescendantOf(Workspace)  
		or part.Anchored then  
		return false  
	end  

	local model=part:FindFirstAncestorOfClass("Model")  

	if model and model:FindFirstChildOfClass("Humanoid") then  
		return false  
	end  

	return true  
end  

local function isWithinRange(part)  
	return part and (part.Position-getTargetPosition()).Magnitude<=1000  
end  

local function attachPhysicsToProp(part)  

	if not isValidProp(part) or activeProps[part] then return end  

	pcall(function()  
		if SetNetworkOwner then  
			SetNetworkOwner:FireServer(part,true)  
		end  
	end)  

	local attachment=Instance.new("Attachment")  
	attachment.Name="XR_TornadoAttachment"  
	attachment.Parent=part  

	local AO=Instance.new("AlignOrientation")  
	AO.Name="XR_TornadoOrientation"  
	AO.Mode=Enum.OrientationAlignmentMode.OneAttachment  
	AO.Attachment0=attachment  
	AO.MaxTorque=math.huge  
	AO.MaxAngularVelocity=math.huge  
	AO.Responsiveness=200  
	AO.Enabled=false  
	AO.Parent=part  

	local AP=Instance.new("AlignPosition")  
	AP.Name="XR_TornadoPosition"  
	AP.Mode=Enum.PositionAlignmentMode.OneAttachment  
	AP.Attachment0=attachment  
	AP.MaxForce=math.huge  
	AP.MaxVelocity=math.huge  
	AP.Responsiveness=200  
	AP.RigidityEnabled=false  
	AP.Enabled=false  
	AP.Parent=part  

	globalItemCount+=1  

	activeProps[part]={  
		AP=AP,  
		AO=AO,  
		Attachment=attachment,  
		Section=((globalItemCount-1)%3)+1,  
		SubSlot=((globalItemCount-1)%10),  
		AngleOffset=(globalItemCount*.75)%(math.pi*2),  
		OrderIndex=globalItemCount  
	}  

	if isMovementActive() then  
		AP.Enabled=true  
		AO.Enabled=true  
	else  
		AP.Enabled=false  
		AO.Enabled=false  
		pcall(function() part.Anchored=false end)  
	end  
end  

