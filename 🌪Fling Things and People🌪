-- =========================================================
-- BLAST
-- =========================================================

local function triggerCompressAndBlast()

	if not isActive
		or isCompressing then

		return

	end

	local root =
		getTargetRoot()

	if not root then
		return
	end

	isCompressing = true

	local savedPositions = {}

	for part, data in pairs(activeProps) do

		if part
			and part:IsDescendantOf(Workspace)
			and data.AP
			and isWithinRange(part) then

			savedPositions[part] =
				data.AP.Position

		end

	end

	local centerPoint =
		root.Position

	for part, data in pairs(activeProps) do

		if part
			and part:IsDescendantOf(Workspace)
			and data.AP
			and savedPositions[part] then

			data.AP.Position =
				centerPoint

		end

	end

	task.wait(1)

	local explosion =
		Instance.new("Explosion")

	explosion.Position =
		centerPoint

	explosion.BlastRadius =
		150

	explosion.BlastPressure =
		0

	explosion.DestroyJointRadiusPercent =
		0

	explosion.Parent =
		Workspace

	for part, data in pairs(activeProps) do

		if part
			and part:IsDescendantOf(Workspace)
			and data.AP
			and savedPositions[part] then

			data.AP.Position =
				savedPositions[part]

		end

	end

	isCompressing = false

end

BlastButton.Activated:Connect(
	triggerCompressAndBlast
)

