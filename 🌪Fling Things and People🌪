-- =========================================================
-- TARGET ROOT
-- =========================================================

local function getTargetRoot()

	if selectedTargetMode == "Random Map" then
		return nil
	end

	local player =
		targetPlayer or LocalPlayer

	if player and player.Character then

		return player.Character:
			FindFirstChild("HumanoidRootPart")

	end

	return nil

end

local function getTargetPosition()

	if selectedTargetMode ==
		"Random Map" then

		return randomTargetPos

	end

	local root =
		getTargetRoot()

	if root then
		return root.Position
	end

	return Vector3.zero

end

-- =========================================================
-- VALID PROP
-- =========================================================

local function isValidProp(part)

	if not part
		or not part:IsA("BasePart")
		or not part:IsDescendantOf(Workspace)
		or part.Anchored then

		return false

	end

	local model =
		part:FindFirstAncestorOfClass("Model")

	if model
		and model:FindFirstChildOfClass("Humanoid") then

		return false

	end

	return true

end

-- =========================================================
-- RANGE
-- =========================================================

local function isWithinRange(part)

	if not part
		or not part:IsDescendantOf(Workspace) then

		return false

	end

	return
		(part.Position - getTargetPosition()).Magnitude
		<= 1000

end

-- =========================================================
-- ATTACH PHYSICS
-- =========================================================

local function attachPhysicsToProp(part)

	if not isValidProp(part) then
		return
	end

	if activeProps[part] then
		return
	end

	pcall(function()

		if SetNetworkOwner then

			SetNetworkOwner:FireServer(
				part,
				true
			)

		end

	end)

	local attachment =
		Instance.new("Attachment")

	attachment.Name =
		"XR_TornadoAttachment"

	attachment.Parent =
		part

	local AO =
		Instance.new("AlignOrientation")

	AO.Name =
		"XR_TornadoOrientation"

	AO.Mode =
		Enum.OrientationAlignmentMode.OneAttachment

	AO.Attachment0 =
		attachment

	AO.MaxTorque =
		math.huge

	AO.MaxAngularVelocity =
		math.huge

	AO.Responsiveness =
		200

	AO.Parent =
		part

	local AP =
		Instance.new("AlignPosition")

	AP.Name =
		"XR_TornadoPosition"

	AP.Mode =
		Enum.PositionAlignmentMode.OneAttachment

	AP.Attachment0 =
		attachment

	AP.MaxForce =
		math.huge

	AP.MaxVelocity =
		math.huge

	AP.Responsiveness =
		200

	AP.RigidityEnabled =
		false

	AP.Parent =
		part

	globalItemCount += 1

	activeProps[part] = {

		AP = AP,
		AO = AO,
		Attachment = attachment,

		Section =
			((globalItemCount - 1) % 3) + 1,

		SubSlot =
			((globalItemCount - 1) % 10),

		AngleOffset =
			(globalItemCount * 0.75)
			% (math.pi * 2)

	}

end

-- =========================================================
-- GRAB DETECTOR
-- =========================================================

Workspace.ChildAdded:Connect(function(child)

	if child.Name ~= "GrabParts" then
		return
	end

	task.spawn(function()

		local grabPart =
			child:WaitForChild(
				"GrabPart",
				2
			)

		if not grabPart then
			return
		end

		local weld =
			grabPart:FindFirstChildOfClass(
				"WeldConstraint"
			)

		if not weld then

			weld =
				grabPart:WaitForChild(
					"WeldConstraint",
					2
				)

		end

		if not weld then
			return
		end

		local part =
			weld.Part1

		if isValidProp(part) then
			attachPhysicsToProp(part)
		end

	end)

end)

