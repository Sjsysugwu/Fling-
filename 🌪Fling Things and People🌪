RunService.Heartbeat:Connect(function()

	if not isHeartActive
		or isCompressing then

		return
	end

	local root =
		getTargetRoot()

	if not root then
		return
	end

	local rootPos =
		root.Position

	local total =
		math.max(
			heartItemCount,
			1
		)

	for part, data in pairs(heartProps) do

		if not part
			or not part:IsDescendantOf(workspace)
			or part.Anchored then

			removeHeartPhysics(part)

		elseif not isWithinRange(part) then

			removeHeartPhysics(part)

		else

			-- ♥ يتحرك مع اللاعب المختار فقط
			local targetPos =
				getHeartPosition(
					data.HeartIndex,
					total,
					rootPos
				)

			data.AP.Position =
				targetPos

			-- البلوك نفسه لا يدور
			if data.FixedOrientation then
				data.AO.CFrame =
					data.FixedOrientation
			end

		end

	end

end)

