-- =========================================================
-- MOVEMENT LOOP
-- =========================================================

RunService.Stepped:Connect(
	function(_, deltaTime)

		if isRandomMapActive then

			randomTimer += deltaTime

			if randomTimer >=
				RANDOM_MAP_INTERVAL then

				randomTimer = 0
				chooseRandomMapPosition()

			end

		end

		-- OFF = FALL
		if not isMovementActive() then

			for part, data in pairs(
				activeProps
			) do

				if part
					and part:IsDescendantOf(
						Workspace
					) then

					if data.AP then
						data.AP.Enabled = false
					end

					if data.AO then
						data.AO.Enabled = false
					end

					pcall(function()
						part.Anchored = false
					end)

				end

			end

			return

		end

		-- ON = WORK AGAIN
		for part, data in pairs(
			activeProps
		) do

			if part
				and part:IsDescendantOf(
					Workspace
				) then

				pcall(function()
					part.Anchored = false
				end)

				if data.AP then
					data.AP.Enabled = true
				end

				if data.AO then
					data.AO.Enabled = true
				end

			end

		end

		if isCompressing then
			return
		end

		-- =====================================================
		-- TORNADO
		-- =====================================================

		if isActive then

			local targetPos =
				getTargetPosition()

			local t =
				os.clock()

			for part, data in pairs(
				activeProps
			) do

				if part
					and part:IsDescendantOf(
						Workspace
					)
					and data.AP then

					local section =
						data.Section or 1

					local slot =
						data.SubSlot or 0

					local offset =
						data.AngleOffset or 0

					local height

					if section == 1 then
						height = 10
					elseif section == 2 then
						height = 35
					else
						height = 60
					end

					local radius

					if section == 1 then
						radius = 18
					elseif section == 2 then
						radius = 13
					else
						radius = 8
					end

					local angle =
						t * (3.5 + section * 0.7)
						+ offset
						+ slot * 0.45

					local yWave =
						math.sin(
							t * 3 + slot
						) * 4

					local pos =
						targetPos +
						Vector3.new(
							math.cos(angle) * radius,
							height + yWave,
							math.sin(angle) * radius
						)

					data.AP.Position = pos

					data.AO.CFrame =
						CFrame.lookAt(
							part.Position,
							targetPos +
							Vector3.new(
								0,
								height,
								0
							)
						)

				end

			end

		-- =====================================================
		-- RANDOM MAP
		-- =====================================================

		elseif isRandomMapActive then

			local targetPos =
				randomTargetPos

			local t =
				os.clock()

			for part, data in pairs(
				activeProps
			) do

				if part
					and part:IsDescendantOf(
						Workspace
					)
					and data.AP then

					local section =
						data.Section or 1

					local slot =
						data.SubSlot or 0

					local offset =
						data.AngleOffset or 0

					local radius

					if section == 1 then
						radius = 18
					elseif section == 2 then
						radius = 13
					else
						radius = 8
					end

					local height

					if section == 1 then
						height = -25
					elseif section == 2 then
						height = 0
					else
						height = 25
					end

					local angle =
						t * RANDOM_ROTATION_SPEED
						+ offset
						+ slot * 0.45

					local pos =
						targetPos +
						Vector3.new(
							math.cos(angle) * radius,
							height,
							math.sin(angle) * radius
						)

					data.AP.Position = pos

					data.AO.CFrame =
						CFrame.Angles(
							0,
							angle,
							0
						)

				end

			end

		-- =====================================================
		-- ME
		-- =====================================================

		elseif isMeActive then

			local character =
				LocalPlayer.Character

			local targetRoot =
				character and
				character:FindFirstChild(
					"HumanoidRootPart"
				)

			if targetRoot then

				local center =
					targetRoot.Position

				local t =
					os.clock()

				for part, data in pairs(
					activeProps
				) do

					if part
						and part:IsDescendantOf(
							Workspace
						)
						and data.AP then

						local section =
							data.Section or 1

						local slot =
							data.SubSlot or 0

						local radius =
							10 + section * 5

						local angle =
							t * 2
							+ slot * 0.8
							+ (
								data.AngleOffset
								or 0
							)

						local height =
							8 + section * 8

						local pos =
							center +
							Vector3.new(
								math.cos(angle)
								* radius,

								height +
								math.sin(
									t * 2 + slot
								) * 2,

								math.sin(angle)
								* radius
							)

						data.AP.Position =
							pos

						data.AO.CFrame =
							CFrame.lookAt(
								part.Position,
								center
							)

					end

				end

			end

		end

	end
)

