local function updateDropdownList()

	for _, child in ipairs(dropdownList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local options = {
		"Me",
		"Random Map"
	}

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			table.insert(options, p.DisplayName)
		end
	end

	for _, opt in ipairs(options) do

		local optBtn = Instance.new("TextButton")

		optBtn.Size = UDim2.new(1, -8, 0, 25)
		optBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
		optBtn.BackgroundTransparency = 0.10
		optBtn.BorderSizePixel = 0
		optBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		optBtn.Font = Enum.Font.SourceSansBold
		optBtn.TextSize = 11
		optBtn.TextTruncate = Enum.TextTruncate.None
		optBtn.TextWrapped = false
		optBtn.TextXAlignment = Enum.TextXAlignment.Center
		optBtn.Text = opt
		optBtn.ZIndex = 21
		optBtn.Parent = dropdownList

		Instance.new("UICorner", optBtn).CornerRadius =
			UDim.new(0, 4)

		optBtn.Activated:Connect(function()

			if opt == "Me" then

				selectedTargetMode = "Me"
				targetPlayer = LocalPlayer
				randomTargetPlayer = nil

				targetDropdownBtn.Text = "Target: Me"

			elseif opt == "Random Map" then

				selectedTargetMode = "Random"
				targetPlayer = nil

				randomTargetPlayer = nil

				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and p.Character then
						if p.Character:FindFirstChild("HumanoidRootPart") then
							randomTargetPlayer = p
							break
						end
					end
				end

				targetDropdownBtn.Text = "Target: Random"

			else

				selectedTargetMode = "Player"
				randomTargetPlayer = nil

				for _, p in ipairs(Players:GetPlayers()) do

					if p.DisplayName == opt then
						targetPlayer = p
						break
					end

				end

				if targetPlayer then
					targetDropdownBtn.Text =
						"Target: " .. targetPlayer.DisplayName
				end

			end

			dropdownList.Visible = false

		end)

	end
end

