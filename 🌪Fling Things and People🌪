local function toggleTornado()

	if isActive then

		isActive = false

		TornadoButton.Text =
			"🌪️ TORNADO: OFF"

	else

		isActive = true
		isMeActive = false
		isOrbitActive = false

		TornadoButton.Text =
			"🌪️ TORNADO: ON"

