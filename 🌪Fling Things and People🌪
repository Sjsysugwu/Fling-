local function showProfile(player)

	if not player then

		ProfileCard.Visible = false
		return

	end

	ProfileCard.Visible = true

	DisplayNameLabel.Text =
		player.DisplayName

	UsernameLabel.Text =
		"@" .. player.Name

	task.spawn(function()

		local image =
			getAvatar(player.UserId)

		if targetPlayer == player then
			Avatar.Image = image
		end

	end)

end

