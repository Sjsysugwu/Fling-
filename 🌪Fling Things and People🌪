		Dropdown:GetChildren()
	) do

		if child:IsA("TextButton") then
			child:Destroy()
		end

	end

	local playerList = {}

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LocalPlayer then

			table.insert(
				playerList,
				player
			)

		end

	end

	table.sort(
		playerList,
		function(a, b)

			return string.lower(
				a.DisplayName
			)
			<
			string.lower(
				b.DisplayName
			)

		end
	)

	for index, player in ipairs(
		playerList
	) do

		createPlayerButton(
			player,
			index
		)

	end

	Dropdown.CanvasSize =
		UDim2.new(
			0,
			0,
			0,
			(#playerList * 38) + 6
		)

end

