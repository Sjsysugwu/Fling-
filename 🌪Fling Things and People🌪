-- =========================================================
-- TEXT POSITION
-- =========================================================

local function getTextShapePosition(
	index,
	total,
	rootPos
)

	total =
		math.max(total, 1)

	if #textPoints == 0 then

		return rootPos
			+ Vector3.new(
				0,
				105,
				0
			)

	end

	local pointIndex =
		((index - 1)
		% #textPoints) + 1

	local pointData =
		textPoints[pointIndex]

	local point =
		pointData.position

	local scale = 1
	local baseHeight = 105

	return rootPos
		+ Vector3.new(
			point.X * scale,
			point.Y * scale
				+ baseHeight,
			0
		)

end

