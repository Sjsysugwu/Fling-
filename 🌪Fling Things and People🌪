--==================================================
-- PROP VALIDATION
--==================================================

local function isValidProp(part)

	if not part
		or not part:IsA("BasePart")
		or part.Anchored then

		return false
	end

	if explodedBlacklist[part] then
		return false
	end

	if not isWithinRange(part) then
		return false
	end

	local ancestor =
		part:FindFirstAncestorOfClass("Model")

	if ancestor
		and ancestor:FindFirstChildOfClass("Humanoid") then

		return false
	end

	if part.Parent
		and part.Parent:FindFirstChildOfClass("Humanoid") then

		return false
	end

	return true

end

