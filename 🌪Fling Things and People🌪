-- =========================================================
-- FREEZE PROPS
-- =========================================================

local function freezeAllProps()

	for part, data in pairs(activeProps) do

		if part
			and part:IsDescendantOf(Workspace) then

			-- =================================================
			-- IMPORTANT:
			-- خذ المكان الحالي الحقيقي للبلوك
			-- وليس مكان الهدف القديم.
			-- =================================================

			local currentPosition = part.Position
			local currentCFrame = part.CFrame

			if data.AP then

				data.AP.Position =
					currentPosition

				data.AP.Enabled =
					false

			end

			if data.AO then

				data.AO.CFrame =
					currentCFrame

				data.AO.Enabled =
					false

			end

			pcall(function()

				part.AssemblyLinearVelocity =
					Vector3.zero

				part.AssemblyAngularVelocity =
					Vector3.zero

				part.Anchored =
					true

			end)

		end

	end

end

-- =========================================================
-- RELEASE PROPS
-- IMPORTANT:
-- لا نخلي AP يحتفظ بمكان قديم بالنص.
-- =========================================================

local function releaseAllProps()

	for part, data in pairs(activeProps) do

		if part
			and part:IsDescendantOf(Workspace) then

			-- خذ المكان الحالي قبل تشغيل AlignPosition
			local currentPosition =
				part.Position

			local currentCFrame =
				part.CFrame

			if data.AP then

				data.AP.Position =
					currentPosition

			end

			if data.AO then

				data.AO.CFrame =
					currentCFrame

			end

			pcall(function()

				part.Anchored =
					false

				part.AssemblyLinearVelocity =
					Vector3.zero

				part.AssemblyAngularVelocity =
					Vector3.zero

			end)

			-- بعد تثبيت الهدف الحالي فقط نشغل القيود
			if data.AP then
				data.AP.Enabled = true
			end

			if data.AO then
				data.AO.Enabled = true
			end

		end

	end

end

-- =========================================================
-- SYNC PROP STATE
-- =========================================================

local function syncPropState()

	if isMovementActive() then

		releaseAllProps()

	else

		freezeAllProps()

	end

end

