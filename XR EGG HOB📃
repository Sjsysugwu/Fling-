--=========================================================
-- PROMPTS
--=========================================================

local function SetupPrompt(Object)

    if not Object:IsA(
        "ProximityPrompt"
    ) then
        return
    end

    pcall(function()
        Object.HoldDuration = 0
    end)

end

for _, Object in ipairs(
    Workspace:GetDescendants()
) do

    SetupPrompt(Object)

end

Workspace.DescendantAdded:Connect(
    function(Object)

        SetupPrompt(Object)

    end
)

--=========================================================
-- RESPAWN
--=========================================================

Player.CharacterAdded:Connect(
    function()

        task.wait(1)

        local Root =
            GetRoot()

        if Root then
            HomeCFrame =
                Root.CFrame
        end

        Processing = false
        CurrentEgg = nil

        task.wait(0.5)

        ScanEggs()

    end
)

--=========================================================
-- START
--=========================================================

ScanEggs()

Status.Text =
    "🥚 Egg tab ready\nMIN $1M • MIN 50 STUDS"

--=========================================================
-- SCAN LOOP
--=========================================================

task.spawn(function()

    while true do

        task.wait(
            SCAN_DELAY
        )

        if not Processing then
            ScanEggs()
        end

    end

end)
