--=========================================================
-- BLOCKER
--=========================================================

local function IsBlocked(Object)

    if not Object then
        return false
    end

    local Current = Object

    while Current
    and Current ~= Workspace do

        if string.lower(Current.Name)
            == "blockers" then

            return true

        end

        Current = Current.Parent

    end

    return false

end

--=========================================================
-- TRACK
--=========================================================

local function IsTrack(Object)

    if not Object then
        return false
    end

    local Current = Object

    while Current
    and Current ~= Workspace do

        if string.find(
            string.lower(Current.Name),
            "track"
        ) then

            return true

        end

        Current = Current.Parent

    end

    return false

end

--=========================================================
-- EGG CHECK
--=========================================================

local function IsEgg(Object)

    if not Object then
        return false
    end

    if IsBlocked(Object) then
        return false
    end

    if IsTrack(Object) then
        return false
    end

    local Name =
        string.lower(Object.Name)

    return
        string.find(Name, "egg") ~= nil
        or
        string.find(Name, "بيض") ~= nil

end

--=========================================================
-- EGG PART
--=========================================================

local function GetEggPart(Egg)

    if not Egg then
        return nil
    end

    if Egg:IsA("BasePart") then
        return Egg
    end

    if Egg:IsA("Model") then

        if Egg.PrimaryPart then
            return Egg.PrimaryPart
        end

        local HRP =
            Egg:FindFirstChild(
                "HumanoidRootPart",
                true
            )

        if HRP
        and HRP:IsA("BasePart") then

            return HRP

        end

        for _, Object in ipairs(
            Egg:GetDescendants()
        ) do

            if Object:IsA("BasePart") then
                return Object
            end

        end

    end

    return nil

end

--=========================================================
-- PROMPT
--=========================================================

local function GetPrompt(Egg)

    if not Egg then
        return nil
    end

    if Egg:IsA("ProximityPrompt") then
        return Egg
    end

    return Egg:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

end

--=========================================================
-- NUMBER
--=========================================================

local function ExtractNumber(Text)

    if not Text then
        return nil
    end

    Text = tostring(Text)
    Text = Text:gsub(",", "")

    local Lower =
        string.lower(Text)

    local Number, Suffix =
        string.match(
            Lower,
            "(%d+%.?%d*)%s*([kmbt])"
        )

    if Number and Suffix then

        Number = tonumber(Number)

        if Suffix == "k" then
            return Number * 1000
        end

        if Suffix == "m" then
            return Number * 1000000
        end

        if Suffix == "b" then
            return Number * 1000000000
        end

        if Suffix == "t" then
            return Number * 1000000000000
        end

    end

    local Normal =
        string.match(
            Text,
            "%d+%.?%d*"
        )

    if Normal then
        return tonumber(Normal)
    end

    return nil

end

--=========================================================
-- PRICE
--=========================================================

local function GetEggPrice(Egg)

    if not Egg then
        return 0
    end

    local Attributes = {

        "Price",
        "price",
        "Cost",
        "cost",
        "Value",
        "value",
        "EggPrice",
        "EggValue"

    }

    for _, Name in ipairs(Attributes) do

        local Value =
            Egg:GetAttribute(Name)

        if typeof(Value) == "number" then
            return Value
        end

        if typeof(Value) == "string" then

            local Number =
                ExtractNumber(Value)

            if Number then
                return Number
            end

        end

    end

    for _, Object in ipairs(
        Egg:GetDescendants()
    ) do

        if Object:IsA("TextLabel")
        or Object:IsA("TextButton")
        or Object:IsA("TextBox") then

            local Text = Object.Text

            if Text and Text ~= "" then

                local Lower =
                    string.lower(Text)

                if string.find(Lower, "$")
                or string.find(Lower, "price")
                or string.find(Lower, "cost")
                or string.find(Lower, "value") then

                    local Number =
                        ExtractNumber(Text)

                    if Number then
                        return Number
                    end

                end

            end

        end

    end

    local NamePrice =
        ExtractNumber(Egg.Name)

    return NamePrice or 0

end

--=========================================================
-- FORMAT PRICE
--=========================================================

local function FormatPrice(Value)

    Value = tonumber(Value) or 0

    if Value < 1000000 then
        return nil
    end

    if Value >= 1000000000000 then

        return string.format(
            "%.2fT",
            Value / 1000000000000
        ):gsub("%.00T$", "T")

    elseif Value >= 1000000000 then

        return string.format(
            "%.2fB",
            Value / 1000000000
        ):gsub("%.00B$", "B")

    else

        return string.format(
            "%.2fM",
            Value / 1000000
        ):gsub("%.00M$", "M")

    end

end

--=========================================================
-- DISTANCE
--=========================================================

local function GetDistance(Part)

    local Root = GetRoot()

    if not Root or not Part then
        return math.huge
    end

    return (
        Root.Position - Part.Position
    ).Magnitude

end

local function GetEggDistance(Egg)

    return GetDistance(
        GetEggPart(Egg)
    )

end

--=========================================================
-- VALID EGG
--=========================================================

local function IsValidEgg(Egg)

    if not Egg
    or not Egg.Parent then

        return false

    end

    if CompletedEggs[Egg] then
        return false
    end

    if not IsEgg(Egg) then
        return false
    end

    if GetEggPrice(Egg) < MIN_EGG_PRICE then
        return false
    end

    if GetEggDistance(Egg) < MIN_EGG_DISTANCE then
        return false
    end

    if not GetEggPart(Egg) then
        return false
    end

    if not GetPrompt(Egg) then
        return false
    end

    return true

end

--=========================================================
-- EGG TEXT
--=========================================================

local function GetEggText(Egg)

    if not IsValidEgg(Egg) then
        return nil
    end

    local Price =
        FormatPrice(
            GetEggPrice(Egg)
        )

    if not Price then
        return nil
    end

    return
        "🥚 "
        .. Egg.Name
        .. "\n$"
        .. Price
        .. " • "
        .. math.floor(
            GetEggDistance(Egg)
        )
        .. " studs"

end

--=========================================================
-- CREATE EGG BUTTON
--=========================================================

local function CreateEggButton(Egg)

    if EggButtons[Egg] then
        return EggButtons[Egg]
    end

    local Text =
        GetEggText(Egg)

    if not Text then
        return nil
    end

    local Button =
        Instance.new("TextButton")

    Button.Size =
        UDim2.new(
            1,
            -10,
            0,
            50
        )

    Button.Text = Text
    Button.TextSize = 11
    Button.Font = Enum.Font.GothamBold
    Button.TextWrapped = true

    Button.Parent = EggList

    StyleButton(Button)

    Button.Activated:Connect(function()

        if Processing then
            return
        end

        ProcessEgg(Egg)

    end)

    EggButtons[Egg] = Button

    return Button

end

--=========================================================
-- UPDATE CANVAS
--=========================================================

local function UpdateCanvas()

    task.defer(function()

        EggList.CanvasSize =
            UDim2.new(
                0,
                0,
                0,
                Layout.AbsoluteContentSize.Y + 10
            )

    end)

end

--=========================================================
-- TAP EGG
--=========================================================

local function TapEgg(Prompt)

    if not Prompt then
        return
    end

    pcall(function()
        Prompt.HoldDuration = 0
    end)

    pcall(function()

        EggTapSound:Stop()
        EggTapSound.TimePosition = 0
        EggTapSound:Play()

    end)

    pcall(function()
        Prompt:InputHoldBegin()
    end)

    task.wait(0.035)

    pcall(function()
        Prompt:InputHoldEnd()
    end)

end

--=========================================================
-- TELEPORT
--=========================================================

local function TeleportTo(Position)

    local Root = GetRoot()

    if not Root then
        return false
    end

    Root.CFrame =
        CFrame.new(Position)

    return true

end

--=========================================================
-- PROCESS EGG
--=========================================================

function ProcessEgg(Egg)

    if Processing then
        return false
    end

    if not IsValidEgg(Egg) then
        return false
    end

    local Part =
        GetEggPart(Egg)

    local Prompt =
        GetPrompt(Egg)

    if not Part or not Prompt then
        return false
    end

    Processing = true
    CurrentEgg = Egg

    local Price =
        GetEggPrice(Egg)

    Status.Text =
        "TP TO EGG\n"
        .. Egg.Name
        .. "\n$"
        .. FormatPrice(Price)

    TeleportTo(
        Part.Position
        + Vector3.new(
            0,
            TELEPORT_HEIGHT,
            EGG_DISTANCE
        )
    )

    task.wait(0.10)

    local Root = GetRoot()

    if Root then
        Root.Anchored = true
    end

    for i = 1, 3 do

        Status.Text =
            "🥚 TAP "
            .. i
            .. " / 3\n"
            .. Egg.Name

        TapEgg(Prompt)

        task.wait(
            BETWEEN_TAKES
        )

    end

    task.wait(
        AFTER_TAKE_WAIT
    )

    Status.Text =
        "✅ Egg collected\n"
        .. Egg.Name

    task.wait(
        COUNT_DELAY
    )

    if Root then
        Root.Anchored = false
    end

    if HomeCFrame then

        Status.Text =
            "TP BACK HOME..."

        TeleportTo(
            HomeCFrame.Position
        )

        task.wait(0.1)

        local NewRoot = GetRoot()

        if NewRoot then
            NewRoot.CFrame =
                HomeCFrame
        end

    end

    CompletedEggs[Egg] = true

    if EggButtons[Egg] then

        pcall(function()
            EggButtons[Egg]:Destroy()
        end)

        EggButtons[Egg] = nil

    end

    Processing = false
    CurrentEgg = nil

    Status.Text =
        "✅ DONE\n"
        .. Egg.Name
        .. "\n$"
        .. FormatPrice(Price)

    UpdateCanvas()

    return true

end

--=========================================================
-- FIND BEST EGG
--=========================================================

local function FindBestEgg()

    local Best = nil
    local BestPrice = -1
    local BestDistance = -1

    for _, Object in ipairs(
        Workspace:GetDescendants()
    ) do

        if IsValidEgg(Object) then

            local Price =
                GetEggPrice(Object)

            local Distance =
                GetEggDistance(Object)

            if Price > BestPrice then

                Best = Object
                BestPrice = Price
                BestDistance = Distance

            elseif Price == BestPrice
            and Distance > BestDistance then

                Best = Object
                BestDistance = Distance

            end

        end

    end

    return Best

end

--=========================================================
-- SCAN
--=========================================================

local function ScanEggs()

    for _, Object in ipairs(
        Workspace:GetDescendants()
    ) do

        if IsValidEgg(Object) then
            CreateEggButton(Object)
        end

    end

    for Egg, Button in pairs(EggButtons) do

        if not IsValidEgg(Egg) then

            pcall(function()
                Button:Destroy()
            end)

            EggButtons[Egg] = nil

        end

    end

    UpdateCanvas()

end

--=========================================================
-- AUTO BEST
--=========================================================

local function AutoTakeBest()

    if not AutoEnabled then
        return false
    end

    if Processing then
        return false
    end

    local Egg =
        FindBestEgg()

    if not Egg then

        Status.Text =
            "❌ No valid egg found"

        return false

    end

    CreateEggButton(Egg)

    return ProcessEgg(Egg)

end

--=========================================================
-- AUTO BUTTON
--=========================================================

AutoButton.Activated:Connect(function()

    AutoEnabled =
        not AutoEnabled

    if AutoEnabled then

        AutoButton.Text =
            "🟢 AUTO ON"

        Status.Text =
            "🟢 AUTO BEST EGG ON"

        task.spawn(function()

            while AutoEnabled do

                if not Processing then

                    local Success =
                        AutoTakeBest()

                    if Success then
                        task.wait(
                            BETWEEN_AUTO_EGGS
                        )
                    else
                        task.wait(
                            SCAN_DELAY
                        )
                    end

                else

                    task.wait(0.05)

                end

            end

        end)

    else

        AutoButton.Text =
            "🔴 AUTO OFF"

        Status.Text =
            "AUTO OFF"

    end

end)

--=========================================================
-- REFRESH
--=========================================================

RefreshButton.Activated:Connect(function()

    if Processing then
        return
    end

    ScanEggs()

    Status.Text =
        "🔄 Egg list refreshed"

end)

--=========================================================
-- BEST EGG
--=========================================================

BestButton.Activated:Connect(function()

    if Processing then
        return
    end

    local Egg =
