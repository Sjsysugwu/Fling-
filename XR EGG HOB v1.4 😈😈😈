--// =========================================================
--// SHOW ANIMALS
--// =========================================================

local function showAnimals(egg)

    clearAnimalButtons()

    if not egg then
        return
    end

    local entries =
        getAnimalEntries(
            egg
        )

    if #entries == 0 then

        AnimalBox:AddLabel({
            Text =
                "No animal names detected."
        })

        return

    end

    local bestEntry = nil
    local bestDistance = math.huge

    for _, entry in ipairs(
        entries
    ) do

        local part =
            getTargetPart(
                entry.Target
            )

        local distance =
            getDistanceFromPart(
                part
            )

        if distance < bestDistance then

            bestDistance =
                distance

            bestEntry =
                entry

        end

    end

    --// ANIMAL BUTTONS

    for _, entry in ipairs(
        entries
    ) do

        local button =
            AnimalBox:AddButton({

                Text =
                    "🐾 "
                    .. entry.Name,

                Func = function()

                    local targetPart =
                        getTargetPart(
                            entry.Target
                        )

                    if targetPart then

                        local distance =
                            getDistanceFromPart(
                                targetPart
                            )

                        SelectedLabel:SetText(
                            "Selected: "
                            .. entry.Name
                            .. "\nDistance: "
                            .. math.floor(
                                distance
                            )
                            .. " STUDS"
                        )

                        flyToPosition(
                            targetPart.Position
                            + Vector3.new(
                                0,
                                TELEPORT_HEIGHT,
                                EGG_DISTANCE
                            ),
                            EGG_FLY_SPEED
                        )

                    else

                        local eggPart =
                            getEggPart(
                                egg
                            )

                        if eggPart then

                            SelectedLabel:SetText(
                                "Selected: "
                                .. entry.Name
                                .. "\nUsing egg position"
                            )

                            flyToPosition(
                                eggPart.Position
                                + Vector3.new(
                                    0,
                                    TELEPORT_HEIGHT,
                                    EGG_DISTANCE
                                ),
                                EGG_FLY_SPEED
                            )

                        end

                    end

                end

            })

        table.insert(
            AnimalElements,
            button
        )

    end

    --// BEST ANIMAL

    if bestEntry then

        local bestButton =
            AnimalBox:AddButton({

                Text =
                    "BEST ANIMAL: "
                    .. bestEntry.Name,

                Func = function()

                    local targetPart =
                        getTargetPart(
                            bestEntry.Target
                        )

                    if targetPart then

                        flyToPosition(
                            targetPart.Position
                            + Vector3.new(
                                0,
                                TELEPORT_HEIGHT,
                                EGG_DISTANCE
                            ),
                            EGG_FLY_SPEED
                        )

                    else

                        local eggPart =
                            getEggPart(
                                egg
                            )

                        if eggPart then

                            flyToPosition(
                                eggPart.Position
                                + Vector3.new(
                                    0,
                                    TELEPORT_HEIGHT,
                                    EGG_DISTANCE
                                ),
                                EGG_FLY_SPEED
                            )

                        end

                    end

                    SelectedLabel:SetText(
                        "Selected: "
                        .. bestEntry.Name
                    )

                end

            })

        table.insert(
            AnimalElements,
            bestButton
        )

    end

end

--// =========================================================
--// PROCESS EGG
--// =========================================================

local function processEgg(
    egg,
    isAuto
)

    if processing then
        return false
    end

    if not isValidEgg(
        egg
    ) then

        return false

    end

    local part =
        getEggPart(
            egg
        )

    local prompt =
        getPrompt(
            egg
        )

    processing = true
    currentEgg = egg

    local price =
        getEggPrice(
            egg
        )

    showAnimals(
        egg
    )

    StatusLabel:SetText(
        "Going to: "
        .. egg.Name
        .. "\nPRICE: $"
        .. formatPrice(
            price
        )
    )

    lockPlayer()

    local targetPosition =
        part.Position
        + Vector3.new(
            0,
            TELEPORT_HEIGHT,
            EGG_DISTANCE
        )

    flyToPosition(
        targetPosition,
        EGG_FLY_SPEED
    )

    task.wait(0.05)

    local root =
        getRoot()

    if root then

        root.CFrame =
            CFrame.new(
                targetPosition
            )

        root.Anchored = true

    end

    --// TAP 1

    StatusLabel:SetText(
        "TAP 1 / 3\n"
        .. egg.Name
    )

    tapEgg(
        prompt
    )

    task.wait(
        BETWEEN_TAKES
    )

    --// TAP 2

    StatusLabel:SetText(
        "TAP 2 / 3\n"
        .. egg.Name
    )

    tapEgg(
        prompt
    )

    task.wait(
        BETWEEN_TAKES
    )

    --// TAP 3

    StatusLabel:SetText(
        "TAP 3 / 3\n"
        .. egg.Name
    )

    tapEgg(
        prompt
    )

    task.wait(
        AFTER_TAKE_WAIT
    )

    StatusLabel:SetText(
        "Egg collected: "
        .. egg.Name
    )

    task.wait(
        COUNT_DELAY
    )

    --// RETURN HOME

    StatusLabel:SetText(
        "Returning home..."
    )

    root =
        getRoot()

    if root then
        root.Anchored = false
    end

    if HOME_CFRAME then

        flyToPosition(
            HOME_CFRAME.Position,
            HOME_FLY_SPEED
        )

    end

    task.wait(0.1)

    restorePlayer()

    processing = false
    currentEgg = nil

    completedEggs[egg] =
        true

    if EggElements[egg] then

        pcall(function()

            EggElements[egg]:Destroy()

        end)

        EggElements[egg] =
            nil

    end

    StatusLabel:SetText(
        "Completed: "
        .. egg.Name
        .. "\nPRICE: $"
        .. formatPrice(
            price
        )
    )

    return true

end

--// =========================================================
--// CREATE EGG BUTTON
--// =========================================================

local function createEggButton(egg)

    if EggElements[egg] then
        return EggElements[egg]
    end

    if not isValidEgg(
        egg
    ) then

        return nil

    end

    local eggText =
        getEggText(
            egg
        )

    if not eggText then
        return nil
    end

    local button =
        EggListBox:AddButton({

            Text =
                eggText,

            Func = function()

                if processing then
                    return
                end

                showAnimals(
                    egg
                )

                processEgg(
                    egg,
                    false
                )

            end,

            Tooltip =
                "Select this egg"

        })

    EggElements[egg] =
        button

    return button

end

--// =========================================================
--// FIND BEST EGG
--// =========================================================

local function findBestEgg()

    local bestEgg = nil
    local bestPrice = -1
    local bestDistance = -1

    for _, obj in ipairs(
        Workspace:GetDescendants()
    ) do

        if isValidEgg(
            obj
        ) then

            local price =
                getEggPrice(
                    obj
                )

            local distance =
                getEggDistance(
                    obj
                )

            if price > bestPrice then

                bestEgg =
                    obj

                bestPrice =
                    price

                bestDistance =
                    distance

            elseif price == bestPrice
                and distance > bestDistance then

                bestEgg =
                    obj

                bestDistance =
                    distance

            end

        end

    end

    return bestEgg

end

--// =========================================================
--// AUTO BEST
--// =========================================================

local function autoTakeBestEgg()

    if not autoBestEnabled then
        return false
    end

    if processing then
        return false
    end

    local egg =
        findBestEgg()

    if not egg then

        StatusLabel:SetText(
            "No valid egg found"
        )

        return false

    end

    createEggButton(
        egg
    )

    showAnimals(
        egg
    )

    StatusLabel:SetText(
        "BEST EGG: "
        .. egg.Name
        .. "\nPRICE: $"
        .. formatPrice(
            getEggPrice(
                egg
            )
        )
    )

    return processEgg(
        egg,
        true
    )

end

--// =========================================================
--// SCAN
--// =========================================================

local function scanEggs()

    for _, obj in ipairs(
        Workspace:GetDescendants()
    ) do

        if isValidEgg(
            obj
        ) then

            createEggButton(
                obj
            )

        end

    end

    --// REMOVE INVALID EGGS

    for egg, button in pairs(
        EggElements
    ) do

        if not isValidEgg(
            egg
        ) then

            pcall(function()

                button:Destroy()

            end)

            EggElements[egg] =
                nil

        end

    end

end

