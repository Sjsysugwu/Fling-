--// =========================================================
--// BLOCKER
--// =========================================================

local function isBlocked(obj)

    if not obj then
        return false
    end

    local current = obj

    while current
        and current ~= Workspace do

        if string.lower(
            current.Name
        ) == "blockers" then

            return true

        end

        current =
            current.Parent

    end

    return false

end

--// =========================================================
--// TRACK
--// =========================================================

local function isTrack(obj)

    if not obj then
        return false
    end

    local current = obj

    while current
        and current ~= Workspace do

        local name =
            string.lower(
                current.Name
            )

        if string.find(
            name,
            "track"
        ) then

            return true

        end

        current =
            current.Parent

    end

    return false

end

