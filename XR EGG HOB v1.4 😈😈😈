--// =========================================================
--// NUMBER PARSER
--// =========================================================

local function extractNumber(text)

    if not text then
        return nil
    end

    text =
        tostring(text)

    text =
        text:gsub(
            ",",
            ""
        )

    local lower =
        string.lower(text)

    local number, suffix =
        string.match(
            lower,
            "(%d+%.?%d*)%s*([kmbt])"
        )

    if number and suffix then

        number =
            tonumber(number)

        if suffix == "k" then
            return number * 1000
        end

        if suffix == "m" then
            return number * 1000000
        end

        if suffix == "b" then
            return number * 1000000000
        end

        if suffix == "t" then
            return number * 1000000000000
        end

    end

    local normal =
        string.match(
            text,
            "%d+%.?%d*"
        )

    if normal then

        return tonumber(normal)

    end

    return nil

end

--// =========================================================
--// FORMAT PRICE
--// ONLY M / B / T
--// =========================================================

local function formatPrice(value)

    value =
        tonumber(value) or 0

    if value < 1000000 then
        return nil
    end

    if value >= 1000000000000 then

        local n =
            value / 1000000000000

        return string.format(
            "%.2fT",
            n
        ):gsub(
            "%.00T$",
            "T"
        ):gsub(
            "(%..-)0T$",
            "%1T"
        )

    elseif value >= 1000000000 then

        local n =
            value / 1000000000

        return string.format(
            "%.2fB",
            n
        ):gsub(
            "%.00B$",
            "B"
        ):gsub(
            "(%..-)0B$",
            "%1B"
        )

    elseif value >= 1000000 then

        local n =
            value / 1000000

        return string.format(
            "%.2fM",
            n
        ):gsub(
            "%.00M$",
            "M"
        ):gsub(
            "(%..-)0M$",
            "%1M"
        )

    end

    return nil

end

--// =========================================================
--// GET EGG PRICE
--// =========================================================

local function getEggPrice(egg)

    if not egg then
        return 0
    end

    local attributes = {

        "Price",
        "price",
        "Cost",
        "cost",
        "Value",
        "value",
        "EggPrice",
        "EggValue"

    }

    for _, attributeName in ipairs(
        attributes
    ) do

        local value =
            egg:GetAttribute(
                attributeName
            )

        if typeof(value) == "number" then

            return value

        end

        if typeof(value) == "string" then

            local number =
                extractNumber(
                    value
                )

            if number then
                return number
            end

        end

    end

    for _, obj in ipairs(
        egg:GetDescendants()
    ) do

        if obj:IsA(
            "TextLabel"
        )
        or obj:IsA(
            "TextButton"
        )
        or obj:IsA(
            "TextBox"
        ) then

            local text =
                obj.Text

            if text
                and text ~= "" then

                local lower =
                    string.lower(
                        text
                    )

                if string.find(
                    lower,
                    "$"
                )
                or string.find(
                    lower,
                    "price"
                )
                or string.find(
                    lower,
                    "cost"
                )
                or string.find(
                    lower,
                    "value"
                ) then

                    local number =
                        extractNumber(
                            text
                        )

                    if number then
                        return number
                    end

                end

            end

        end

    end

    local namePrice =
        extractNumber(
            egg.Name
        )

    if namePrice then
        return namePrice
    end

    return 0

end

--// =========================================================
--// DISTANCE
--// =========================================================

local function getDistanceFromPart(part)

    local root =
        getRoot()

    if not root
        or not part then

        return math.huge

    end

    return (
        root.Position
        - part.Position
    ).Magnitude

end

local function getEggDistance(egg)

    return getDistanceFromPart(
        getEggPart(egg)
    )

end

local function isFarEnough(egg)

    return
        getEggDistance(egg)
        >= MIN_EGG_DISTANCE

end

--// =========================================================
--// VALID EGG
--// =========================================================

local function isValidEgg(egg)

    if not egg
        or not egg.Parent then

        return false

    end

    if completedEggs[egg] then
        return false
    end

    if not isEgg(egg) then
        return false
    end

    local price =
        getEggPrice(egg)

    if price < MIN_EGG_PRICE then
        return false
    end

    local distance =
        getEggDistance(egg)

    if distance < MIN_EGG_DISTANCE then
        return false
    end

    if not getEggPart(egg) then
        return false
    end

    if not getPrompt(egg) then
        return false
    end

    return true

end

--// =========================================================
--// EGG TEXT
--// =========================================================

local function getEggText(egg)

    if not isValidEgg(egg) then
        return nil
    end

    local price =
        getEggPrice(egg)

    local distance =
        getEggDistance(egg)

    local priceText =
        formatPrice(price)

    if not priceText then
        return nil
    end

    return
        "EGG: "
        .. egg.Name
        .. "\nPRICE: $"
        .. priceText
        .. "  |  DISTANCE: "
        .. math.floor(distance)
        .. " STUDS"

end

