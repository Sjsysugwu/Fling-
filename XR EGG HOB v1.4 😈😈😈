--// EGG CHECK
--// =========================================================

local function isEgg(obj)

    if not obj then
        return false
    end

    if isBlocked(obj) then
        return false
    end

    if isTrack(obj) then
        return false
    end

    local name =
        string.lower(
            obj.Name
        )

    return
        string.find(
            name,
            "egg"
        )
        or
        string.find(
            name,
            "بيض"
        )

end

--// =========================================================
--// GET PART
--// =========================================================

local function getEggPart(egg)

    if not egg then
        return nil
    end

    if egg:IsA("BasePart") then
        return egg
    end

    if egg:IsA("Model") then

        if egg.PrimaryPart then
            return egg.PrimaryPart
        end

        local rootPart =
            egg:FindFirstChild(
                "HumanoidRootPart",
                true
            )

        if rootPart
            and rootPart:IsA(
                "BasePart"
            ) then

            return rootPart

        end

        for _, obj in ipairs(
            egg:GetDescendants()
        ) do

            if obj:IsA("BasePart") then

                return obj

            end

        end

    end

    return nil

end

