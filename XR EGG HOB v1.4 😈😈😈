local function PlaySound(id, pitch, vol)
	task.spawn(function()
		local s = Instance.new("Sound")
		s.SoundId = "rbxassetid://" .. tostring(id)
		s.Pitch = pitch or 1
		s.Volume = vol or 0.5
		s.Parent = workspace

		s:Play()

		s.Ended:Connect(function()
			s:Destroy()
		end)
	end)
end

