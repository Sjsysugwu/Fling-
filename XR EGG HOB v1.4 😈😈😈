    legendary = true

}

local function cleanAnimalName(text)

    if not text then
        return nil
    end

    text =
        tostring(text)

    text =
        text:gsub(
            "^%s+",
            ""
        )

    text =
        text:gsub(
            "%s+$",
            ""
        )

    if text == "" then
        return nil
    end

    if #text < 2
        or #text > 50 then

        return nil

    end

    local lower =
        string.lower(text)

    if BAD_ANIMAL_WORDS[lower] then
        return nil
    end

    if string.match(
        text,
        "^%$?[%d%.,]+[KkMmBbTt]?$"
    ) then

        return nil

    end

    return text

end

