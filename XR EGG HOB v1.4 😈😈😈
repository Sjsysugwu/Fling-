--=========================================================
-- FIND PLAYER PLOT BASEPLATE
--=========================================================

local function FindMyPlotBaseplate()

    local PlayerName =
        string.lower(
            Player.Name
        )

    local DisplayName =
        string.lower(
            Player.DisplayName
        )

    local UserId =
        tostring(
            Player.UserId
        )

    for _, Object in ipairs(
        Workspace:GetDescendants()
    ) do

        if Object:IsA("BasePart")
        and string.lower(
            Object.Name
        ) == "baseplate" then

            local Current =
                Object.Parent

            while Current
            and Current ~= Workspace do

                local CurrentName =
                    string.lower(
                        Current.Name
                    )

                if string.find(
                    CurrentName,
                    PlayerName,
                    1,
                    true
                )
                or string.find(
                    CurrentName,
                    DisplayName,
                    1,
                    true
                )
                or string.find(
                    CurrentName,
                    UserId,
                    1,
                    true
                ) then

                    return Object

                end

                for AttributeName, Value in pairs(
                    Current:GetAttributes()
                ) do

                    local Text =
                        tostring(Value)

                    local LowerText =
                        string.lower(Text)

                    if string.find(
                        LowerText,
                        PlayerName,
                        1,
                        true
                    )
                    or string.find(
                        LowerText,
                        DisplayName,
                        1,
                        true
                    )
                    or Text == UserId then

                        return Object

                    end

                end

                Current =
                    Current.Parent

            end

        end

    end

    return nil

end

local function GetMyBaseplate()

    return FindMyPlotBaseplate()

end

--=========================================================
-- BLOCKER
--=========================================================

local function IsBlocked(Object)

    if not Object then
        return false
    end

    local Current =
        Object

    while Current
    and Current ~= Workspace do

        if string.lower(
            Current.Name
        ) == "blockers" then

            return true

        end

        Current =
            Current.Parent

    end

    return false

end

--=========================================================
-- TRACK
--=========================================================

local function IsTrack(Object)

    if not Object then
        return false
    end

    local Current =
        Object

    while Current
    and Current ~= Workspace do

        if string.find(
            string.lower(
                Current.Name
            ),
            "track"
        ) then

            return true

        end

        Current =
            Current.Parent

    end

    return false

end

--=========================================================
-- EGG CHECK
--=========================================================

local function IsEgg(Object)

    if not Object then
        return false
    end

    if IsBlocked(Object) then
        return false
    end

    if IsTrack(Object) then
        return false
    end

    local Name =
        string.lower(
            Object.Name
        )

    return
        string.find(
            Name,
            "egg"
        ) ~= nil
        or
        string.find(
            Name,
            "بيض"
        ) ~= nil

end

--=========================================================
-- EGG PART
--=========================================================

local function GetEggPart(Egg)

    if not Egg then
        return nil
    end

    if Egg:IsA("BasePart") then
        return Egg
    end

    if Egg:IsA("Model") then

        if Egg.PrimaryPart then
            return Egg.PrimaryPart
        end

        local HRP =
            Egg:FindFirstChild(
                "HumanoidRootPart",
                true
            )

        if HRP
        and HRP:IsA("BasePart") then

            return HRP

        end

        for _, Object in ipairs(
            Egg:GetDescendants()
        ) do

            if Object:IsA("BasePart") then
                return Object
            end

        end

    end

    return nil

end

