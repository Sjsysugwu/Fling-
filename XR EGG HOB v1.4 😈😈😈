        name =
            cleanAnimalName(name)

        if not name then
            return
        end

        local key =
            string.lower(name)

        if seen[key] then
            return
        end

        seen[key] = true

        table.insert(
            entries,
            {
                Name = name,
                Target = target
            }
        )

    end

    --// ATTRIBUTES

    for _, attributeName in ipairs({

        "Animal",
        "AnimalName",
        "Pet",
        "PetName",
        "Creature",
        "CreatureName",
        "Reward",
        "RewardName"

    }) do

        local value =
            egg:GetAttribute(
                attributeName
            )

        if typeof(value) == "string" then

            addEntry(
                value,
                egg
            )

        end

    end

    --// DESCENDANTS

    for _, obj in ipairs(
        egg:GetDescendants()
    ) do

        if obj:IsA(
            "TextLabel"
        )
        or obj:IsA(
            "TextButton"
        )
        or obj:IsA(
            "TextBox"
        ) then

            local text =
                obj.Text

            local parentName =
                string.lower(
                    obj.Parent
                    and obj.Parent.Name
                    or ""
                )

            local objectName =
                string.lower(
                    obj.Name
                )

            local animalText =
                string.find(
                    parentName,
                    "animal"
                )
                or string.find(
                    parentName,
                    "pet"
                )
                or string.find(
                    parentName,
                    "reward"
                )
                or string.find(
                    objectName,
                    "animal"
                )
                or string.find(
                    objectName,
                    "pet"
                )
                or string.find(
                    objectName,
                    "reward"
                )

            if animalText then

                addEntry(
                    text,
                    obj
                )

            end

        end

        if obj:IsA("Model") then

            local name =
                cleanAnimalName(
                    obj.Name
                )

            if name then

                local lower =
                    string.lower(name)

                if not string.find(
                    lower,
                    "egg"
                )
                and not string.find(
                    lower,
                    "prompt"
                )
                and not string.find(
                    lower,
                    "button"
                )
                and not string.find(
                    lower,
                    "price"
                ) then

                    addEntry(
                        name,
                        obj
                    )

                end

            end

        end

    end

    return entries

end

--// =========================================================
--// TARGET PART
--// =========================================================

local function getTargetPart(target)

    if not target then
        return nil
    end

    if target:IsA(
        "BasePart"
    ) then

        return target

    end

    if target:IsA(
        "Model"
    ) then

        if target.PrimaryPart then
            return target.PrimaryPart
        end

        local hrp =
            target:FindFirstChild(
                "HumanoidRootPart",
                true
            )

        if hrp
            and hrp:IsA(
                "BasePart"
            ) then

            return hrp

        end

        for _, obj in ipairs(
            target:GetDescendants()
        ) do

            if obj:IsA(
                "BasePart"
            ) then

                return obj

            end

        end

    end

    if target:IsA(
        "GuiObject"
    ) then

        local current =
            target.Parent

        while current
            and current ~= Workspace do

            if current:IsA(
                "Model"
            ) then

                return getTargetPart(
                    current
                )

            end

            current =
                current.Parent

        end

    end

    return nil

end

--// =========================================================
--// CAMERA
--// =========================================================

local function startCameraFollow()

    if cameraConnection then

        cameraConnection:Disconnect()

        cameraConnection = nil

    end

    local camera =
        Workspace.CurrentCamera

    if not camera then
        return
    end

    camera.CameraType =
        Enum.CameraType.Scriptable

    cameraConnection =
        RunService.RenderStepped:
        Connect(function()

            local root =
                getRoot()

            if not root then
                return
            end

            local cameraPosition =
                root.Position
                - root.CFrame.LookVector
                * CAMERA_DISTANCE
                + Vector3.new(
                    0,
                    CAMERA_HEIGHT,
                    0
                )

            local lookPosition =
                root.Position
                + Vector3.new(
                    0,
                    CAMERA_LOOK_HEIGHT,
                    0
                )

            camera.CFrame =
                CFrame.lookAt(
                    cameraPosition,
                    lookPosition
                )

        end)

end

local function stopCameraFollow()

    if cameraConnection then

        cameraConnection:Disconnect()

        cameraConnection = nil

    end

    local camera =
        Workspace.CurrentCamera

    if not camera then
        return
    end

    camera.CameraType =
        Enum.CameraType.Custom

    local humanoid =
        getHumanoid()

    if humanoid then

        camera.CameraSubject =
            humanoid

    end

end

--// =========================================================
--// LOCK
--// =========================================================

local savedWalkSpeed
local savedJumpPower
local savedAutoRotate
local savedAnchored

local function lockPlayer()

    local humanoid =
        getHumanoid()

    local root =
        getRoot()

    if humanoid then

        savedWalkSpeed =
            humanoid.WalkSpeed

        savedJumpPower =
            humanoid.JumpPower

        savedAutoRotate =
            humanoid.AutoRotate

        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.AutoRotate = false

    end

    if root then

        savedAnchored =
            root.Anchored

    end

    startCameraFollow()

end

local function restorePlayer()

    local humanoid =
        getHumanoid()

    local root =
        getRoot()

    if humanoid then

        if savedWalkSpeed ~= nil then
            humanoid.WalkSpeed =
                savedWalkSpeed
        end

        if savedJumpPower ~= nil then
            humanoid.JumpPower =
                savedJumpPower
        end

        if savedAutoRotate ~= nil then
            humanoid.AutoRotate =
                savedAutoRotate
        end

    end

    if root then

        root.Anchored =
            savedAnchored or false

    end

    stopCameraFollow()

end

--// =========================================================
--// FLY
--// =========================================================

local function flyToPosition(
    position,
    speed
)

    local root =
        getRoot()

    if not root then
        return false
    end

    local distance =
        (
            root.Position
            - position
        ).Magnitude

    if distance <= 1 then

        root.CFrame =
            CFrame.new(
                position
            )

        return true

    end

    local duration =
        distance / speed

    local tween =
        TweenService:Create(
            root,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),
            {
                CFrame =
                    CFrame.new(
                        position
                    )
            }
        )

    tween:Play()
    tween.Completed:Wait()

    return true

end

--// =========================================================
--// TAP
--// =========================================================

local function tapEgg(prompt)

    if not prompt then
        return
    end

    pcall(function()

        prompt.HoldDuration = 0

    end)

    pcall(function()

        EggTapSound:Stop()

        EggTapSound.TimePosition = 0

        EggTapSound:Play()

    end)

    pcall(function()

        prompt:InputHoldBegin()

    end)

    task.wait(0.035)

    pcall(function()

        prompt:InputHoldEnd()

    end)

end

