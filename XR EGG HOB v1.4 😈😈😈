--=========================================================
-- NUMBER
--=========================================================

local function ExtractNumber(Text)

    if not Text then
        return nil
    end

    Text =
        tostring(Text)

    Text =
        Text:gsub(",", "")

    local Lower =
        string.lower(Text)

    local Number, Suffix =
        string.match(
            Lower,
            "(%d+%.?%d*)%s*([kmbt])"
        )

    if Number
    and Suffix then

        Number =
            tonumber(Number)

        if Suffix == "k" then
            return Number * 1000
        end

        if Suffix == "m" then
            return Number * 1000000
        end

        if Suffix == "b" then
            return Number * 1000000000
        end

        if Suffix == "t" then
            return Number * 1000000000000
        end

    end

    local Normal =
        string.match(
            Text,
            "%d+%.?%d*"
        )

    if Normal then
        return tonumber(Normal)
    end

    return nil

end

--=========================================================
-- PRICE
--=========================================================

local function GetEggPrice(Egg)

    if not Egg then
        return 0
    end

    local Attributes = {

        "Price",
        "price",
        "Cost",
        "cost",
        "Value",
        "value",
        "EggPrice",
        "EggValue"

    }

    for _, Name in ipairs(
        Attributes
    ) do

        local Value =
            Egg:GetAttribute(
                Name
            )

        if typeof(Value)
        == "number" then

            return Value

        end

        if typeof(Value)
        == "string" then

            local Number =
                ExtractNumber(
                    Value
                )

            if Number then
                return Number
            end

        end

    end

    for _, Object in ipairs(
        Egg:GetDescendants()
    ) do

        if Object:IsA(
            "TextLabel"
        )
        or Object:IsA(
            "TextButton"
        )
        or Object:IsA(
            "TextBox"
        ) then

            local Text =
                Object.Text

            if Text
            and Text ~= "" then

                local Lower =
                    string.lower(
                        Text
                    )

                if string.find(
                    Lower,
                    "$"
                )
                or string.find(
                    Lower,
                    "price"
                )
                or string.find(
                    Lower,
                    "cost"
                )
                or string.find(
                    Lower,
                    "value"
                ) then

                    local Number =
                        ExtractNumber(
                            Text
                        )

                    if Number then
                        return Number
                    end

                end

            end

        end

    end

    local NamePrice =
        ExtractNumber(
            Egg.Name
        )

    return NamePrice or 0

end

--=========================================================
-- FORMAT PRICE
--=========================================================

local function FormatPrice(Value)

    Value =
        tonumber(Value) or 0

    if Value < 1000000 then
        return nil
    end

    if Value >=
        1000000000000 then

        return string.format(
            "%.2fT",
            Value /
            1000000000000
        ):gsub(
            "%.00T$",
            "T"
        )

    elseif Value >=
        1000000000 then

        return string.format(
            "%.2fB",
            Value /
            1000000000
        ):gsub(
            "%.00B$",
            "B"
        )

    else

        return string.format(
            "%.2fM",
            Value /
            1000000
        ):gsub(
            "%.00M$",
            "M"
        )

    end

end

--=========================================================
-- DISTANCE
--=========================================================

local function GetDistance(Part)

    local Root =
        GetRoot()

    if not Root
    or not Part then

        return math.huge

    end

    return (
        Root.Position -
        Part.Position
    ).Magnitude

end

local function GetEggDistance(Egg)

    return GetDistance(
        GetEggPart(Egg)
    )

end

--=========================================================
-- VALID EGG
--=========================================================

local function IsValidEgg(Egg)

    if not Egg
    or not Egg.Parent then

        return false

    end

    if CompletedEggs[Egg] then
        return false
    end

    if not IsEgg(Egg) then
        return false
    end

    if GetEggPrice(Egg)
        < MIN_EGG_PRICE then

        return false

    end

    if GetEggDistance(Egg)
        < MIN_EGG_DISTANCE then

        return false

    end

    if not GetEggPart(Egg) then
        return false
    end

    if not GetPrompt(Egg) then
        return false
    end

    return true

end

--=========================================================
-- EGG TEXT
--=========================================================

local function GetEggText(Egg)

    if not IsValidEgg(Egg) then
        return nil
    end

    local Price =
        FormatPrice(
            GetEggPrice(Egg)
        )

    if not Price then
        return nil
    end

    return
        "🥚 "
        .. Egg.Name
        .. "\n$"
        .. Price
        .. " • "
        .. math.floor(
            GetEggDistance(Egg)
        )
        .. " studs"

end

--=========================================================
-- CREATE EGG BUTTON
--=========================================================

local function CreateEggButton(Egg)

    if EggButtons[Egg] then
        return EggButtons[Egg]
    end

    local Text =
        GetEggText(Egg)

    if not Text then
        return nil
    end

    local Button =
        Instance.new(
            "TextButton"
        )

    Button.Size =
        UDim2.new(
            1,
            -10,
            0,
            50
        )

    Button.Text =
        Text

    Button.TextSize = 11

    Button.Font =
        Enum.Font.GothamBold

    Button.TextWrapped = true

    Button.Parent =
        EggList

    StyleButton(Button)

    Button.Activated:Connect(
        function()

            if Processing then
                return
            end

            ProcessEgg(Egg)

        end
    )

    EggButtons[Egg] =
        Button

    return Button

end

