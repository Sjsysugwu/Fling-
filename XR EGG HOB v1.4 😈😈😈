-- ═══════════════════════════════════════════════════════════════
-- STYLE BUTTON
-- ═══════════════════════════════════════════════════════════════

local function styleButton(button)

    if not button then
        return
    end

    if not button:IsA("TextButton") then
        return
    end

    if StyledButtons[button] then
        return
    end

    StyledButtons[button] = true

    local colors = getCurrentColors()

    button.BackgroundColor3 =
        colors.Main

    button.AutoButtonColor = false

    button.MouseEnter:Connect(function()

        if not button.Parent then
            return
        end

        local c = getCurrentColors()

        TweenService:Create(
            button,
            TweenInfo.new(
                BUTTON_TWEEN_TIME,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                BackgroundColor3 = c.Hover
            }
        ):Play()

    end)

    button.MouseLeave:Connect(function()

        if not button.Parent then
            return
        end

        local c = getCurrentColors()

        TweenService:Create(
            button,
            TweenInfo.new(
                BUTTON_TWEEN_TIME,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                BackgroundColor3 = c.Main
            }
        ):Play()

    end)

    button.MouseButton1Down:Connect(function()

        if not button.Parent then
            return
        end

        local c = getCurrentColors()

        TweenService:Create(
            button,
            TweenInfo.new(
                BUTTON_TWEEN_TIME,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                BackgroundColor3 = c.Press
            }
        ):Play()

    end)

    button.MouseButton1Up:Connect(function()

        if not button.Parent then
            return
        end

        local c = getCurrentColors()

        TweenService:Create(
            button,
            TweenInfo.new(
                BUTTON_TWEEN_TIME,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                BackgroundColor3 = c.Hover
            }
        ):Play()

    end)

end

