local function cleanup()
    FLYING = false
    stopEngine()
    pcall(function() RunService:UnbindFromRenderStep(STEP) end)
    if droneModel then pcall(function() droneModel:Destroy() end) end
    droneModel = nil
    pcall(function()
        UIS.MouseBehavior = Enum.MouseBehavior.Default
        UIS.MouseIconEnabled = true
        Camera.CameraType = Enum.CameraType.Custom
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then Camera.CameraSubject = hum end
    end)
    if statusLbl then statusLbl.Text = "Ready"; statusLbl.TextColor3 = MUTED end
    if main then main.Visible = true end
end

local function explode(at)
    local p = at or pos or Camera.CFrame.Position
    stopEngine()
    playBoom()
    pcall(function()
        local e = Instance.new("Explosion")
        e.BlastRadius = 10; e.BlastPressure = 0; e.DestroyJointRadiusPercent = 0
        e.Position = p; e.Parent = workspace
    end)
    if CFG.screenFlash then
        pcall(function()
            local g = Instance.new("ScreenGui"); g.IgnoreGuiInset = true; g.Parent = CoreGui
            local f = Instance.new("Frame")
            f.Size = UDim2.fromScale(1,1); f.BorderSizePixel = 0
            f.BackgroundColor3 = Color3.fromRGB(255, 190, 90); f.BackgroundTransparency = 0.4; f.Parent = g
            TweenService:Create(f, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
            task.delay(0.5, function() g:Destroy() end)
        end)
    end
    if CFG.tpOnExplode then
        local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if root then
            pcall(function()
                root.CFrame = CFrame.new(p + Vector3.new(0, 4, 0))
                root.AssemblyLinearVelocity = Vector3.zero
            end)
        end
    end
    notify(CFG.tpOnExplode and "Взрыв + TP" or "Взрыв")
    cleanup()
end

local function step(dt)
    if not FLYING then return end
    dt = math.clamp(dt or 0.016, 0, 0.05)
    if os.clock() - startTime > CFG.maxTime then explode(pos) return end
    local delta = UIS:GetMouseDelta()
    yaw -= delta.X * CFG.sens
    pitch = math.clamp(pitch - delta.Y * CFG.sens, -1.2, 1.2)
    dir = Vector3.new(-math.sin(yaw)*math.cos(pitch), math.sin(pitch), -math.cos(yaw)*math.cos(pitch))
    local spd = CFG.speed
    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then spd *= CFG.boostMul end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then spd *= CFG.slowMul end
    if engineSound then
        pcall(function()
            engineSound.PlaybackSpeed = 0.8 + (spd / 100) * 0.5
            engineSound.Volume = CFG.engineVolume
        end)
    end
    local move = dir * spd * dt
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { LP.Character, folder, droneModel }
    params.FilterType = Enum.RaycastFilterType.Exclude
    local hit = workspace:Raycast(pos, move + dir * 1.4, params)
    if hit then explode(hit.Position) return end
    pos = pos + move
    if droneModel then pcall(function() droneModel:PivotTo(CFrame.lookAt(pos, pos + dir)) end) end
    Camera.CameraType = Enum.CameraType.Scriptable
    Camera.CFrame = CFrame.lookAt(pos - dir * CFG.camDist + Vector3.new(0, CFG.camHeight, 0), pos + dir * 4)
end

local function launch()
    if FLYING then return end
    local look = Camera.CFrame.LookVector
    pos = Camera.CFrame.Position + look * 6
    yaw = math.atan2(-look.X, -look.Z)
    pitch = math.asin(math.clamp(look.Y, -0.99, 0.99))
    dir = look
    startTime = os.clock()
    FLYING = true
    droneModel = getBuilder(CFG.model)(CFrame.lookAt(pos, pos + look), CFG.size)
    droneModel.Parent = ensureFolder()
    startEngine()
    pcall(function() UIS.MouseBehavior = Enum.MouseBehavior.LockCenter; UIS.MouseIconEnabled = false end)
    RunService:BindToRenderStep(STEP, Enum.RenderPriority.Last.Value, step)
    if statusLbl then statusLbl.Text = "FLIGHT"; statusLbl.TextColor3 = Color3.fromRGB(100, 255, 150) end
    if main then main.Visible = false end
    notify("Полёт")
end

