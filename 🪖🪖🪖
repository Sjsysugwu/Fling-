local function corner(p, r) Instance.new("UICorner", p).CornerRadius = UDim.new(0, r or 10) end
local function stroke(p, c, th, tr)
    local s = Instance.new("UIStroke", p)
    s.Color = c or ACCENT; s.Thickness = th or 1; s.Transparency = tr or 0.45
end

local function ensureFolder()
    if folder and folder.Parent then return folder end
    folder = Instance.new("Folder")
    folder.Name = "ShahedCraft"
    pcall(function() folder.Parent = Camera end)
    if not folder.Parent then pcall(function() folder.Parent = workspace end) end
    return folder
end

local function P(props)
    local p = Instance.new("Part")
    p.Anchored = true; p.CanCollide = false; p.CanQuery = false
    p.CastShadow = true; p.Massless = true
    p.Material = Enum.Material.SmoothPlastic
    for k, v in pairs(props) do p[k] = v end
    return p
end

local function trailOn(parent, col)
    if not CFG.trail then return end
    local a0 = Instance.new("Attachment", parent)
    local a1 = Instance.new("Attachment", parent)
    a0.Position = Vector3.new(0, 0, 0.15)
    a1.Position = Vector3.new(0, 0, -0.2)
    local t = Instance.new("Trail")
    t.Attachment0, t.Attachment1 = a0, a1
    t.Lifetime = 0.5
    t.Color = ColorSequence.new(col, Color3.fromRGB(15, 5, 0))
    t.Transparency = NumberSequence.new(0.1, 1)
    t.Parent = parent
end

