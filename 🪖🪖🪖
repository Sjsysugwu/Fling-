    pct.Font = Enum.Font.GothamMedium
    pct.TextSize = 11
    pct.TextColor3 = Color3.fromRGB(200, 205, 215)
    pct.Parent = card

    -- pulse flags
    task.spawn(function()
        while loadGui.Parent do
            for _, f in ipairs(flagFrames) do
                if not f.Parent then break end
                TweenService:Create(f, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    BackgroundTransparency = 0.2 + math.random() * 0.35,
                }):Play()
            end
            task.wait(0.7)
        end
    end)

    -- music
    local music
    for _, id in ipairs(LOAD_MUSIC_IDS) do
        local s = Instance.new("Sound")
        s.SoundId = id
        s.Volume = 0
        s.Looped = true
        s.Parent = SoundService
        pcall(function() s:Play() end)
        music = s
        TweenService:Create(s, TweenInfo.new(0.8), { Volume = 0.35 }):Play()
        break
    end

    for i = 1, 40 do
        local p = i / 40
        bar.Size = UDim2.fromScale(p, 1)
        pct.Text = math.floor(p * 100) .. "%"
        task.wait(0.04)
    end

    if rotConn then rotConn:Disconnect() end
    if music then
        TweenService:Create(music, TweenInfo.new(0.5), { Volume = 0 }):Play()
        task.delay(0.55, function() pcall(function() music:Stop(); music:Destroy() end) end)
    end
    TweenService:Create(bg, TweenInfo.new(0.45), { BackgroundTransparency = 1 }):Play()
    TweenService:Create(card, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
    task.wait(0.5)
    loadGui:Destroy()
    if onDone then onDone() end
end

