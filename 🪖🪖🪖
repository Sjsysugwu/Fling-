local function stopEngine()
    if engineSound then
        local s = engineSound; engineSound = nil
        pcall(function()
            TweenService:Create(s, TweenInfo.new(0.25), { Volume = 0 }):Play()
            task.delay(0.3, function() pcall(function() s:Stop(); s:Destroy() end) end)
        end)
    end
end

local function startEngine()
    stopEngine()
    local ids = { ENGINE_ID }
    for _, f in ipairs(ENGINE_FALLBACK) do table.insert(ids, f) end
    for _, id in ipairs(ids) do
        local s = Instance.new("Sound")
        s.Name = "ShahedEngine"
        s.SoundId = id
        s.Looped = true
        s.Volume = 0
        s.PlaybackSpeed = 0.9
        s.Parent = SoundService
        pcall(function() s:Play() end)
        engineSound = s
        TweenService:Create(s, TweenInfo.new(0.4), { Volume = CFG.engineVolume }):Play()
        print("[Shahed] engine", id)
        break
    end
end

local function playBoom()
    for i, id in ipairs(BOOM_IDS) do
        pcall(function()
            local s = Instance.new("Sound")
            s.SoundId = id
            s.Volume = CFG.soundVolume * (i == 1 and 1 or 0.6)
            s.PlaybackSpeed = 0.9 + math.random() * 0.1
            s.Parent = SoundService
            s:Play()
            game:GetService("Debris"):AddItem(s, 5)
        end)
    end
end

