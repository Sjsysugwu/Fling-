    statusLbl.Position = UDim2.new(0.65, 0, 0, 0)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Text = "Ready"
    statusLbl.Font = Enum.Font.GothamMedium
    statusLbl.TextSize = 12
    statusLbl.TextColor3 = MUTED
    statusLbl.TextXAlignment = Enum.TextXAlignment.Right
    statusLbl.Parent = header

    do
        local dragging, startPos, startInput
        header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                startInput = input.Position
                startPos = main.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local d = input.Position - startInput
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
    end

    local tabBar = Instance.new("Frame")
    tabBar.Size = UDim2.new(1, -20, 0, 32)
    tabBar.Position = UDim2.fromOffset(10, 50)
    tabBar.BackgroundTransparency = 1
    tabBar.Parent = main
    Instance.new("UIListLayout", tabBar).FillDirection = Enum.FillDirection.Horizontal
    tabBar:FindFirstChildOfClass("UIListLayout").Padding = UDim.new(0, 6)

    local body = Instance.new("Frame")
    body.Size = UDim2.new(1, -20, 1, -140)
    body.Position = UDim2.fromOffset(10, 88)
    body.BackgroundTransparency = 1
    body.ClipsDescendants = true
    body.Parent = main

    local function showPage(name)
        for n, f in pairs(pages) do f.Visible = (n == name) end
        for _, b in ipairs(tabBar:GetChildren()) do
            if b:IsA("TextButton") then
                local on = b.Name == name
                b.BackgroundColor3 = on and ACCENT or CARD
                b.TextColor3 = on and Color3.new(1,1,1) or MUTED
            end
        end
    end

    for _, info in ipairs({ {"models", "Модели"}, {"settings", "Настройки"}, {"help", "Help"} }) do
        local b = Instance.new("TextButton")
        b.Name = info[1]
        b.Size = UDim2.fromOffset(110, 30)
        b.BackgroundColor3 = CARD
        b.Text = info[2]
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.TextColor3 = MUTED
        b.Parent = tabBar
        corner(b, 8)
        b.MouseButton1Click:Connect(function() showPage(info[1]) end)
    end

    pages.models = Instance.new("ScrollingFrame")
    pages.models.Size = UDim2.fromScale(1, 1)
    pages.models.BackgroundTransparency = 1
    pages.models.BorderSizePixel = 0
    pages.models.ScrollBarThickness = 3
    pages.models.AutomaticCanvasSize = Enum.AutomaticSize.Y
    pages.models.Visible = false
    pages.models.Parent = body
    Instance.new("UIListLayout", pages.models).Padding = UDim.new(0, 6)

    local vpBox = Instance.new("Frame")
    vpBox.Size = UDim2.new(1, 0, 0, 120)
    vpBox.BackgroundColor3 = Color3.fromRGB(8, 9, 12)
    vpBox.Parent = pages.models
    corner(vpBox, 10)
    viewport = Instance.new("ViewportFrame")
    viewport.Size = UDim2.fromScale(1, 1)
    viewport.BackgroundTransparency = 1
    viewport.Ambient = Color3.fromRGB(100, 100, 110)
    viewport.LightColor = Color3.fromRGB(255, 200, 150)
    viewport.Parent = vpBox

    local function refreshPreview()
        if previewConn then previewConn:Disconnect() previewConn = nil end
        viewport:ClearAllChildren()
        local world = Instance.new("WorldModel"); world.Parent = viewport
        local cam = Instance.new("Camera"); cam.Parent = viewport
        viewport.CurrentCamera = cam
        local m = getBuilder(CFG.model)(CFrame.new(), 1.05)
        m.Parent = world
        local a = 0
        previewConn = RunService.RenderStepped:Connect(function(dt)
            if not m.Parent then return end
            a += dt * 0.75
            pcall(function() m:PivotTo(CFrame.Angles(math.rad(12), a, 0)) end)
            cam.CFrame = CFrame.lookAt(Vector3.new(5, 2.4, 6), Vector3.new(0, 0.1, 0))
        end)
    end

    local function rebuildModelList()
        for _, c in ipairs(pages.models:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for _, info in ipairs(MODELS) do
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, 0, 0, 40)
            b.BackgroundColor3 = CFG.model == info.id and Color3.fromRGB(45, 38, 28) or CARD
            b.Text = "  " .. info.name
            b.Font = Enum.Font.GothamBold
            b.TextSize = 13
            b.TextColor3 = Color3.new(1,1,1)
            b.TextXAlignment = Enum.TextXAlignment.Left
            b.Parent = pages.models
            corner(b, 8)
            if CFG.model == info.id then stroke(b, ACCENT, 1.2, 0.2) end
            b.MouseButton1Click:Connect(function()
                CFG.model = info.id
                rebuildModelList()
                refreshPreview()
            end)
        end
    end
    rebuildModelList()
    refreshPreview()

    pages.settings = Instance.new("ScrollingFrame")
    pages.settings.Size = UDim2.fromScale(1, 1)
    pages.settings.BackgroundTransparency = 1
    pages.settings.BorderSizePixel = 0
    pages.settings.ScrollBarThickness = 3
    pages.settings.AutomaticCanvasSize = Enum.AutomaticSize.Y
    pages.settings.Visible = false
    pages.settings.Parent = body
    Instance.new("UIListLayout", pages.settings).Padding = UDim.new(0, 5)

    local function addToggle(label, key)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 34)
        b.BackgroundColor3 = CARD
        b.Text = "  " .. label .. (CFG[key] and "   ON" or "   OFF")
        b.Font = Enum.Font.GothamMedium
        b.TextSize = 12
        b.TextColor3 = CFG[key] and Color3.fromRGB(120, 220, 160) or MUTED
        b.TextXAlignment = Enum.TextXAlignment.Left
        b.Parent = pages.settings
        corner(b, 8)
        b.MouseButton1Click:Connect(function()
            CFG[key] = not CFG[key]
            b.Text = "  " .. label .. (CFG[key] and "   ON" or "   OFF")
            b.TextColor3 = CFG[key] and Color3.fromRGB(120, 220, 160) or MUTED
        end)
    end
    local function addSlider(label, key, min, max, int)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 42)
        row.BackgroundColor3 = CARD
        row.Parent = pages.settings
        corner(row, 8)
        local lab = Instance.new("TextLabel")
        lab.Size = UDim2.new(1, -12, 0, 14)
        lab.Position = UDim2.fromOffset(10, 4)
        lab.BackgroundTransparency = 1
        lab.Text = label .. "  " .. tostring(CFG[key])
        lab.Font = Enum.Font.GothamMedium
        lab.TextSize = 11
        lab.TextColor3 = Color3.fromRGB(190, 195, 210)
        lab.TextXAlignment = Enum.TextXAlignment.Left
        lab.Parent = row
        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1, -20, 0, 8)
        bar.Position = UDim2.fromOffset(10, 26)
        bar.BackgroundColor3 = Color3.fromRGB(38, 42, 52)
        bar.Parent = row
        corner(bar, 4)
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((CFG[key]-min)/math.max(max-min,1), 0, 1, 0)
        fill.BackgroundColor3 = ACCENT
        fill.Parent = bar
        corner(fill, 4)
        local drag = false
        bar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
        end)
        UIS.InputChanged:Connect(function(i)
            if not drag or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
            local rel = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local val = min + rel * (max - min)
            if int then val = math.floor(val + 0.5) else val = math.floor(val * 100 + 0.5) / 100 end
            CFG[key] = val
            fill.Size = UDim2.new(rel, 0, 1, 0)
            lab.Text = label .. "  " .. tostring(val)
        end)
    end
    addToggle("ТП при взрыве", "tpOnExplode")
    addToggle("Вспышка", "screenFlash")
    addToggle("След", "trail")
    addSlider("Скорость", "speed", 20, 90, true)
    addSlider("Громкость взрыва", "soundVolume", 0.2, 2, false)
    addSlider("Громкость двигателя", "engineVolume", 0.1, 1.5, false)
    addSlider("Мышь", "sens", 0.001, 0.008, false)
    addSlider("Время полёта", "maxTime", 6, 35, true)
    addSlider("Размер", "size", 0.7, 1.7, false)

    pages.help = Instance.new("Frame")
    pages.help.Size = UDim2.fromScale(1, 1)
    pages.help.BackgroundColor3 = CARD
    pages.help.Visible = false
    pages.help.Parent = body
    corner(pages.help, 10)
    local helpT = Instance.new("TextLabel")
    helpT.Size = UDim2.new(1, -16, 1, -16)
    helpT.Position = UDim2.fromOffset(8, 8)
    helpT.BackgroundTransparency = 1
    helpT.Text = "Перетащи окно за шапку\n\nH — взлёт\nМышь — руль\nShift/Ctrl — скорость\nV — взрыв\nInsert — GUI\n\nТолько визуал + звук."
    helpT.Font = Enum.Font.Gotham
    helpT.TextSize = 13
    helpT.TextColor3 = Color3.fromRGB(190, 195, 210)
    helpT.TextXAlignment = Enum.TextXAlignment.Left
    helpT.TextYAlignment = Enum.TextYAlignment.Top
    helpT.Parent = pages.help

    showPage("models")

    local launchBtn = Instance.new("TextButton")
    launchBtn.Size = UDim2.new(1, -20, 0, 44)
    launchBtn.Position = UDim2.new(0, 10, 1, -54)
    launchBtn.BackgroundColor3 = ACCENT
    launchBtn.Text = "▶  ЗАПУСК"
    launchBtn.Font = Enum.Font.GothamBlack
    launchBtn.TextSize = 16
    launchBtn.TextColor3 = Color3.new(1, 1, 1)
    launchBtn.Parent = main
    corner(launchBtn, 10)
    launchBtn.MouseButton1Click:Connect(function()
        if FLYING then explode(pos) else launch() end
    end)

    UIS.InputBegan:Connect(function(input)
        local k = input.KeyCode
        if k == Enum.KeyCode.H and not FLYING then launch()
        elseif k == Enum.KeyCode.V and FLYING then explode(pos)
        elseif k == Enum.KeyCode.Insert then
            if not FLYING then main.Visible = not main.Visible end
        end
    end)

    RunService.Heartbeat:Connect(function()
        if FLYING then
            launchBtn.Text = "💣  ВЗРЫВ"
            launchBtn.BackgroundColor3 = Color3.fromRGB(170, 50, 50)
        else
            launchBtn.Text = "▶  ЗАПУСК"
            launchBtn.BackgroundColor3 = ACCENT
        end
    end)
end

