local function runLoader(onDone)
    local loadGui = Instance.new("ScreenGui")
    loadGui.Name = "ShahedLoader"
    loadGui.IgnoreGuiInset = true
    loadGui.DisplayOrder = 1000
    pcall(function() loadGui.Parent = CoreGui end)
    if not loadGui.Parent then loadGui.Parent = LP:WaitForChild("PlayerGui") end

    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundColor3 = Color3.fromRGB(6, 8, 12)
    bg.BorderSizePixel = 0
    bg.Parent = loadGui

    -- flag wall (grid of stylized flags)
    local flagLayer = Instance.new("Frame")
    flagLayer.Size = UDim2.fromScale(1, 1)
    flagLayer.BackgroundTransparency = 1
    flagLayer.Parent = bg

    local cols, rows = 8, 5
    local flagFrames = {}
    for r = 0, rows - 1 do
        for c = 0, cols - 1 do
            local idx = (r * cols + c) % #FLAGS + 1
            local data = FLAGS[idx]
            local cell = Instance.new("Frame")
            cell.Size = UDim2.new(1 / cols, -4, 1 / rows, -4)
            cell.Position = UDim2.new(c / cols, 2, r / rows, 2)
            cell.BackgroundTransparency = 0.35
            cell.BorderSizePixel = 0
            cell.ClipsDescendants = true
            cell.Parent = flagLayer
            corner(cell, 6)
            local n = #data[2]
            for i, col in ipairs(data[2]) do
                local stripe = Instance.new("Frame")
                stripe.Size = UDim2.new(1, 0, 1 / n, 0)
                stripe.Position = UDim2.new(0, 0, (i - 1) / n, 0)
                stripe.BackgroundColor3 = col
                stripe.BorderSizePixel = 0
                stripe.Parent = cell
            end
            local tag = Instance.new("TextLabel")
            tag.Size = UDim2.fromScale(1, 1)
            tag.BackgroundTransparency = 1
            tag.Text = data[1]
            tag.Font = Enum.Font.GothamBold
