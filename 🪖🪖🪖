    local body = P({ Name = "Body", Size = Vector3.new(0.55*s, 0.42*s, 3.6*s), Color = bodyC, CFrame = at })
    body.Parent = m
    P({ Size = Vector3.new(0.42*s, 0.32*s, 0.9*s), Color = darkC, CFrame = at * CFrame.new(0, 0, -2.15*s) }).Parent = m
    P({ Size = Vector3.new(2.4*s, 0.08*s, 1.7*s), Color = bodyC,
