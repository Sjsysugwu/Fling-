local thirdPersonEnabled = true

local function applyCamera()
    local camera = workspace.CurrentCamera
    local character = Player.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if thirdPersonEnabled then
        Player.CameraMode = Enum.CameraMode.Classic
        Player.CameraMinZoomDistance = 0.5
        Player.CameraMaxZoomDistance = 1000
    else
        Player.CameraMode = Enum.CameraMode.LockFirstPerson
        Player.CameraMinZoomDistance = 0
        Player.CameraMaxZoomDistance = 0
    end

    if camera and humanoid then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = humanoid
    end
end

PlayerView:AddToggle("ThirdPersonToggle", {
    Text = "🎥 3rd Person View",
    Default = true,
    Callback = function(value)
        thirdPersonEnabled = value
        applyCamera()
        notify("Third Person", value and "ON" or "OFF")
    end
})

-- =====================================================
-- 🌀 SPIN CHARACTER
-- =====================================================

local spinEnabled = false
local spinSpeed = 5
local spinConnection

local function stopSpin()
    spinEnabled = false

    if spinConnection then
        spinConnection:Disconnect()
        spinConnection = nil
    end
end

local function startSpin()
    stopSpin()
    spinEnabled = true

    spinConnection = RunService.Heartbeat:Connect(function(dt)
        if not spinEnabled then
            return
        end

        local character = Player.Character
        local root = character
            and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")

        if root and humanoid and humanoid.Health > 0 then
            root.CFrame = root.CFrame
                * CFrame.Angles(
                    0,
                    math.rad(spinSpeed * 60 * dt),
                    0
                )
        end
    end)
end

PlayerView:AddToggle("SpinToggle", {
    Text = "🌀 Spin Character",
    Default = false,
    Callback = function(value)
        if value then
            startSpin()
        else
            stopSpin()
        end

        notify("Spin Character", value and "ON" or "OFF")
    end
})

