-- UPDATE CANVAS
--=========================================================

local function UpdateCanvas()

    task.defer(
        function()

            EggList.CanvasSize =
                UDim2.new(
                    0,
                    0,
                    0,
                    Layout.AbsoluteContentSize.Y
                    + 10
                )

