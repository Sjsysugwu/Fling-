    )

end

--=========================================================
-- TAP EGG
--=========================================================

local function TapEgg(Prompt)

    if not Prompt then
        return
    end

    pcall(function()

        Prompt.HoldDuration = 0

    end)

    pcall(function()

        EggTapSound:Stop()

        EggTapSound.TimePosition =
            0

        EggTapSound:Play()

    end)

    pcall(function()

        Prompt:InputHoldBegin()

    end)

    task.wait(0.035)

    pcall(function()

        Prompt:InputHoldEnd()

    end)

end

--=========================================================
-- TELEPORT
--=========================================================

local function TeleportTo(Position)

    local Root =
        GetRoot()

    if not Root then
        return false
    end

    Root.CFrame =
        CFrame.new(
            Position
        )

    return true

end

--=========================================================
-- PROCESS EGG
--=========================================================

function ProcessEgg(Egg)

    if Processing then
        return false
    end

    if not IsValidEgg(Egg) then
        return false
    end

    local Part =
        GetEggPart(Egg)

    local Prompt =
        GetPrompt(Egg)

    if not Part
    or not Prompt then

        return false

    end

    Processing = true
    CurrentEgg = Egg

    local Price =
        GetEggPrice(Egg)

    Status.Text =
        "TP TO EGG\n"
        .. Egg.Name
        .. "\n$"
        .. FormatPrice(Price)

    TeleportTo(
        Part.Position
        + Vector3.new(
            0,
            TELEPORT_HEIGHT,
            EGG_DISTANCE
        )
    )

    task.wait(0.10)

    local Root =
        GetRoot()

    if Root then
        Root.Anchored = true
    end

    for i = 1, 3 do

        Status.Text =
            "🥚 TAP "
            .. i
            .. " / 3\n"
            .. Egg.Name

        TapEgg(Prompt)

        task.wait(
            BETWEEN_TAKES
        )

    end

    task.wait(
        AFTER_TAKE_WAIT
    )

    Status.Text =
        "✅ Egg collected\n"
        .. Egg.Name

    task.wait(
        COUNT_DELAY
    )

    if Root then
        Root.Anchored = false
    end

    --=====================================================
    -- RETURN TO PLAYER PLOT BASEPLATE
    --=====================================================

    local MyBaseplate =
        GetMyBaseplate()

    if MyBaseplate then

        Status.Text =
            "🏠 TP TO YOUR PLOT BASEPLATE..."

        TeleportTo(
            MyBaseplate.Position
            + Vector3.new(
                0,
                TELEPORT_HEIGHT,
                0
            )
        )

        task.wait(0.15)

        local NewRoot =
            GetRoot()

        if NewRoot then

            NewRoot.CFrame =
                CFrame.new(
                    MyBaseplate.Position
                    + Vector3.new(
                        0,
                        TELEPORT_HEIGHT,
                        0
                    )
                )

        end

    else

        Status.Text =
            "❌ YOUR PLOT BASEPLATE NOT FOUND"

        task.wait(0.5)

    end

    CompletedEggs[Egg] =
        true

    if EggButtons[Egg] then

        pcall(function()

            EggButtons[Egg]:Destroy()

        end)

        EggButtons[Egg] =
            nil

    end

    Processing = false
    CurrentEgg = nil

    Status.Text =
        "✅ DONE\n"
        .. Egg.Name
        .. "\n$"
        .. FormatPrice(Price)

    UpdateCanvas()

    return true

end

--=========================================================
-- FIND BEST EGG
--=========================================================

local function FindBestEgg()

    local Best = nil
    local BestPrice = -1
    local BestDistance = -1

    for _, Object in ipairs(
        Workspace:GetDescendants()
    ) do

        if IsValidEgg(Object) then

            local Price =
                GetEggPrice(Object)

            local Distance =
                GetEggDistance(Object)

            if Price > BestPrice then

                Best =
                    Object

                BestPrice =
                    Price

                BestDistance =
                    Distance

            elseif Price == BestPrice
            and Distance > BestDistance then

                Best =
                    Object

                BestDistance =
                    Distance

            end

        end

    end

    return Best

end

--=========================================================
-- SCAN
--=========================================================

local function ScanEggs()

    for _, Object in ipairs(
        Workspace:GetDescendants()
    ) do

        if IsValidEgg(Object) then

            CreateEggButton(Object)

        end

    end

    for Egg, Button in pairs(
        EggButtons
    ) do

        if not IsValidEgg(Egg) then

            pcall(function()

                Button:Destroy()

            end)

            EggButtons[Egg] =
                nil

        end

    end

    UpdateCanvas()

end

--=========================================================
-- AUTO BEST
--=========================================================

local function AutoTakeBest()

    if not AutoEnabled then
        return false
    end

    if Processing then
        return false
    end

    local Egg =
        FindBestEgg()

    if not Egg then

        Status.Text =
            "❌ No valid egg found"

        return false

    end

    CreateEggButton(Egg)

    return ProcessEgg(Egg)

end

--=========================================================
-- AUTO BUTTON
--=========================================================

AutoButton.Activated:Connect(
    function()

        AutoEnabled =
            not AutoEnabled

        if AutoEnabled then

            AutoButton.Text =
                "🟢 AUTO ON"

            Status.Text =
                "🟢 AUTO BEST EGG ON"

            task.spawn(
                function()

                    while AutoEnabled do

                        if not Processing then

                            local Success =
                                AutoTakeBest()

                            if Success then

                                task.wait(
                                    BETWEEN_AUTO_EGGS
                                )

                            else

                                task.wait(
                                    SCAN_DELAY
                                )

                            end

                        else

                            task.wait(
                                0.05
                            )

                        end

                    end

                end
            )

        else

            AutoButton.Text =
                "🔴 AUTO OFF"

            Status.Text =
                "AUTO OFF"

        end

    end
)

